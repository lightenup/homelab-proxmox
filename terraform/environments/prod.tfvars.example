# Documentation example — copy to prod.tfvars and replace placeholders. See prod.tfvars.template for CI use.
# Copy to terraform/environments/prod.tfvars (ignored by git) and fill values.

proxmox_api_url = "<pve-api-url>"  # e.g. https://<host>:8006/api2/json

# Token-based auth (set via secrets; do not commit)
proxmox_api_token_id     = "<token-id>"          # e.g. terraform@pve!terraform-token
proxmox_api_token_secret = "<your-token-secret>" # from Proxmox API token

proxmox_node    = "pve"
lxc_template    = "local:vztmpl/debian-12-standard_12.12-1_amd64.tar.zst"
storage_pool    = "local-lvm"
services_bridge = "vmbr0"
network_gateway = "<gateway-ip>"  # e.g. your LAN gateway address

# DNS for all LXCs. Required when PVE host uses Tailscale (resolv.conf is 100.100.100.100).
nameserver      = "1.1.1.1"
# searchdomain = "home.arpa"

service_mountpoints = {
  immich = {
    library = {
      mp     = "/mnt/immich"
      volume = "/mnt/nas/homelab_immich"
    }
    external_photo = {
      mp       = "/mnt/immich-external/photo"
      volume   = "/mnt/nas/photo"
      readonly = true
    }
  }
  jellyfin = {
    video = {
      mp       = "/media/video"
      volume   = "/mnt/nas/video"
      readonly = true
    }
  }
  nextcloud = {
    data = {
      mp     = "/mnt/nextcloud"
      volume = "/mnt/nas/homelab_nextcloud"
    }
  }
}

service_ips = {
  adguard        = "<service-ip>/24"  # e.g. <host>/24 in CIDR notation
  reverse_proxy  = "<service-ip>/24"
  homeassistant  = "<service-ip>/24"
  immich         = "<service-ip>/24"
  monitoring     = "<service-ip>/24"

  # Baseline example for spec 022
  # Suggested starting point: 2 vCPU / 2GB RAM / 32GB disk (see terraform/main.tf)
  jellyfin       = "<service-ip>/24"
  nextcloud      = "<service-ip>/24"
}

ssh_public_keys = [
  "<your-ssh-public-key>"  # e.g. ssh-ed25519 AAAA... user@host
]
