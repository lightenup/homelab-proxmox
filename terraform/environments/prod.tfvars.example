# PROD environment example (no secrets)
# Copy to terraform/environments/prod.tfvars (ignored by git) and fill values.

proxmox_api_url = "https://192.168.1.112:8006/api2/json"

# Token-based auth (set via secrets; do not commit)
proxmox_api_token_id     = "terraform@pve!token"
proxmox_api_token_secret = "REDACTED"

proxmox_node    = "pve"
lxc_template    = "local:vztmpl/debian-12-standard_12.12-1_amd64.tar.zst"
storage_pool    = "local-lvm"
services_bridge = "vmbr0"
network_gateway = "192.168.1.1"

# DNS for all LXCs. Required when PVE host uses Tailscale (resolv.conf is 100.100.100.100).
nameserver      = "1.1.1.1"
# searchdomain = "home.arpa"

service_mountpoints = {
  immich = {
    library = {
      mp     = "/mnt/immich"
      volume = "/mnt/nas/homelab_immich"
    }
    external_photo = {
      mp       = "/mnt/immich-external/photo"
      volume   = "/mnt/nas/photo"
      readonly = true
    }
  }
  jellyfin = {
    video = {
      mp       = "/media/video"
      volume   = "/mnt/nas/video"
      readonly = true
    }
  }
  nextcloud = {
    data = {
      mp     = "/mnt/nextcloud"
      volume = "/mnt/nas/homelab_nextcloud"
    }
  }
}

service_ips = {
  adguard        = "192.168.1.210/24"
  reverse_proxy  = "192.168.1.211/24"
  homeassistant  = "192.168.1.212/24"
  immich         = "192.168.1.213/24"
  monitoring     = "192.168.1.214/24"

  # Baseline example for spec 022
  # Suggested starting point: 2 vCPU / 2GB RAM / 32GB disk (see terraform/main.tf)
  jellyfin       = "192.168.1.215/24"
  nextcloud      = "192.168.1.216/24"
}

ssh_public_keys = [
  "ssh-ed25519 AAAA... operator@example"
]
