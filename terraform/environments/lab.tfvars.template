# CI template — real non-secret values. Do not copy for local use; see lab.tfvars.example instead.

proxmox_api_url = "https://192.168.1.112:8006/api2/json"

# Token-based auth — secret injected at runtime via PROXMOX_API_TOKEN_SECRET
proxmox_api_token_id     = "terraform@pve!terraform-token"
proxmox_api_token_secret = "__INJECT_TOKEN_SECRET__"

proxmox_node    = "pve"
lxc_template    = "local:vztmpl/debian-12-standard_12.12-1_amd64.tar.zst"
storage_pool    = "local-lvm"
services_bridge = "vmbr0"
network_gateway = "192.168.1.1"

# DNS for all LXCs. Required when PVE host uses Tailscale (resolv.conf is 100.100.100.100).
nameserver      = "1.1.1.1"

service_mountpoints = {
  immich = {
    library = {
      mp     = "/mnt/immich"
      volume = "/mnt/nas/homelab_immich"
    }
  }
  jellyfin = {
    video = {
      mp       = "/media/video"
      volume   = "/mnt/nas/video"
      readonly = true
    }
  }
  nextcloud = {
    data = {
      mp     = "/mnt/nextcloud"
      volume = "/mnt/nas/homelab_nextcloud"
    }
  }
  financial-scenario = {
    backups = {
      mp     = "/mnt/financial-scenario/backups"
      volume = "/mnt/nas/homelab_financial_scenario"
    }
  }
}

service_ips = {
  adguard        = "192.168.1.210/24"
  reverse_proxy  = "192.168.1.211/24"
  homeassistant  = "192.168.1.212/24"
  immich         = "192.168.1.213/24"
  monitoring     = "192.168.1.214/24"
  jellyfin       = "192.168.1.215/24"
  nextcloud            = "192.168.1.216/24"
  financial-scenario   = "192.168.1.217/24"
  market-model         = "192.168.20.219/24"
}

ssh_public_keys = [
