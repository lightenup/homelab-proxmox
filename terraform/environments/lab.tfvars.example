# LAB environment example (no secrets)
# Copy to terraform/environments/lab.tfvars (ignored by git) and fill values.

proxmox_api_url = "https://proxmox.example:8006/api2/json"

# Token-based auth (set via secrets; do not commit)
proxmox_api_token_id     = "terraform@pve!token"
proxmox_api_token_secret = "REDACTED"

proxmox_node    = "pve"
lxc_template    = "local:vztmpl/debian-12-standard_12.2-1_amd64.tar.zst"
storage_pool    = "local-lvm"
services_bridge = "vmbr0"
network_gateway = "192.168.20.1"

# Optional: set DNS explicitly for all LXCs.
# nameserver   = "192.168.20.210 1.1.1.1"
# searchdomain = "home.arpa"

# Ensure all services have an IP (CIDR format)
service_ips = {
  adguard        = "192.168.20.210/24"
  reverse_proxy  = "192.168.20.211/24"
  homeassistant  = "192.168.20.212/24"
  immich         = "192.168.20.213/24"
  monitoring     = "192.168.20.214/24"

  # Baseline example for spec 022
  # Suggested starting point: 2 vCPU / 2GB RAM / 32GB disk (see terraform/main.tf)
  jellyfin       = "192.168.20.215/24"
}

ssh_public_keys = [
  "ssh-ed25519 AAAA... operator@example"
]
