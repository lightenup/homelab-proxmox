  echo "  --no-auto-route      Skip automatic routing suggestions"
  echo "  --dry-run            Show the adapted prompt without executing droid"
  echo "  -h, --help           Show this help"
  echo ""
  echo "Per-stage defaults (overridden by -m / -r):"
  echo "  specify      opus / high       Deep domain analysis"
  echo "  plan         opus / high       Architectural decisions"
  echo "  tasks        sonnet / medium   Structured decomposition"
  echo "  implement    sonnet / medium   Code generation"
  echo "  review       sonnet / medium   Checklist evaluation"
  echo "  (other stages use droid's default model)"
  echo ""
