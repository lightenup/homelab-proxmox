#!/usr/bin/env bash
set -euo pipefail

# ============================================================================
# speckit-droid-adapter — Bridges Spec Kit agent files to droid exec
#
# This script is a stateless adapter. It translates Spec Kit's interactive
# agent interface into droid's non-interactive execution model.
#
# It adds:
#   - Persona injection (analyst, architect, developer, reviewer)
#   - A non-interactive preamble for droid compatibility
#   - Model and reasoning effort selection (-m, -r)
#   - A review loop (implement → review → re-implement, max 3 iterations)
#
# It does NOT:
#   - Add workflow stages or artifact formats (review prompt is adapter-owned)
#   - Make decisions about what to run or in what order
#   - Own git operations (Spec Kit scripts handle those)
#   - Maintain state between invocations (review loop is single-session)
#
# Usage:
#   ./adapter/speckit-droid-adapter <stage> [user-arguments] [options]
#
# Stages (maps to Spec Kit agent files):
#   constitution   Create/update project constitution
#   specify        Generate feature specification          [Analyst]
#   clarify        Clarify spec ambiguities (optional)     [Analyst]
#   plan           Create implementation plan              [Architect]
#   checklist      Generate quality checklist (optional)   [Architect]
#   tasks          Decompose plan into tasks               [Architect]
#   analyze        Cross-artifact consistency (optional)   [Architect]
#   implement      Execute tasks and produce code          [Developer]
#   review         Review implementation against spec      [Reviewer]
#   build          implement + review loop (max 3 rounds)  [Dev + Rev]
#
# Examples:
#   ./adapter/speckit-droid-adapter specify "Build a bookmark manager CLI"
#   ./adapter/speckit-droid-adapter implement -m claude-opus-4-6
#   ./adapter/speckit-droid-adapter review -r high
#   ./adapter/speckit-droid-adapter build                 # implement + review loop
#   ./adapter/speckit-droid-adapter build --auto high -m gpt-5.2-codex -r medium
# ============================================================================

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

# Clean up temp files on exit/interrupt
TMPFILES=()
cleanup() { rm -f "${TMPFILES[@]}" 2>/dev/null; }
trap cleanup EXIT INT TERM

# --- Defaults ---------------------------------------------------------------
DEFAULT_AUTO="medium"
DEFAULT_MODEL=""     # empty = use per-stage default, then droid's default
DEFAULT_REASONING="" # empty = use per-stage default, then model's default
MAX_REVIEW_ITERATIONS=3
MAX_INPUT_FILE_BYTES=102400  # 100 KB per file — guard against accidental binary
INPUT_FILES=()               # -f / @file references, appended as context

# --- Agent file mapping ------------------------------------------------------
declare -A AGENT_FILES=(
  [constitution]=".github/agents/speckit.constitution.agent.md"
  [specify]=".github/agents/speckit.specify.agent.md"
  [clarify]=".github/agents/speckit.clarify.agent.md"
  [plan]=".github/agents/speckit.plan.agent.md"
  [checklist]=".github/agents/speckit.checklist.agent.md"
  [tasks]=".github/agents/speckit.tasks.agent.md"
  [analyze]=".github/agents/speckit.analyze.agent.md"
  [implement]=".github/agents/speckit.implement.agent.md"
)

# --- Persona mapping ---------------------------------------------------------
declare -A PERSONAS=(
  [constitution]=""
  [specify]="analyst"
  [clarify]="analyst"
  [plan]="architect"
  [checklist]="architect"
  [tasks]="architect"
  [analyze]="architect"
  [implement]="developer"
  [review]="reviewer"
  [build]=""
)

# --- Per-stage model defaults ------------------------------------------------
# Optimal model/reasoning per stage. Overridden by -m / -r flags.
declare -A STAGE_MODELS=(
  [constitution]=""                          # interactive — use droid default
  [specify]="claude-opus-4-6"               # deep analysis needs opus
  [clarify]=""                               # lightweight — droid default
  [plan]="claude-opus-4-6"                  # architecture needs opus
  [checklist]=""                              # lightweight — droid default
  [tasks]="claude-sonnet-4-6"               # structured decomposition
  [analyze]=""                               # optional — droid default
  [implement]="claude-sonnet-4-6"           # fast, capable coder
  [review]="claude-sonnet-4-6"             # thorough but efficient
)

declare -A STAGE_REASONING=(
  [constitution]=""
  [specify]="high"                           # deep domain analysis
  [clarify]=""
  [plan]="high"                              # architectural decisions
  [checklist]=""
  [tasks]="medium"                           # structured output
  [analyze]=""
  [implement]="medium"                       # code generation
  [review]="medium"                          # checklist evaluation
)

# --- Stages that get a self-critique pass ------------------------------------
# After these stages, the adapter runs a second droid call to critique the
# output, then re-runs the stage with critique feedback if REVISE is returned.
CRITIQUE_STAGES=("specify" "plan")

# --- Functions ---------------------------------------------------------------

# Resolve effective model for a stage: explicit flag > per-stage default > empty
resolve_model() {
  local explicit="$1"
  local stage="$2"
  if [[ -n "$explicit" ]]; then
    echo "$explicit"
  else
    echo "${STAGE_MODELS[$stage]:-}"
  fi
}

# Resolve effective reasoning for a stage: explicit flag > per-stage default > empty
resolve_reasoning() {
  local explicit="$1"
  local stage="$2"
  if [[ -n "$explicit" ]]; then
    echo "$explicit"
  else
    echo "${STAGE_REASONING[$stage]:-}"
  fi
}

# Check if a stage should get a self-critique pass
should_critique() {
  local stage="$1"
  for s in "${CRITIQUE_STAGES[@]}"; do
    [[ "$s" == "$stage" ]] && return 0
  done
  return 1
}

# Run a critique pass on the most recent output of a stage
# Returns 0 if REVISE, 1 if ACCEPT (or critique file not found)
run_critique() {
  local stage="$1"
  local auto_level="$2"
  local model="$3"
  local reasoning="$4"

  local critique_prompt="$REPO_ROOT/adapter/critique-prompt.md"
  if [[ ! -f "$critique_prompt" ]]; then
    echo "⚠ critique-prompt.md not found — skipping self-critique"
    return 1
  fi

  local persona_name="${PERSONAS[$stage]:-}"

  echo ""
  echo "🔍 Running self-critique for $stage (persona: ${persona_name:-none})"
  echo ""

  local prompt_file
  prompt_file=$(mktemp "${TMPDIR:-/tmp}/droid-critique-${stage}-XXXXXX")
  TMPFILES+=("$prompt_file")

  # Build: preamble + persona + critique prompt
  build_preamble "$persona_name" > "$prompt_file"
  cat "$critique_prompt" >> "$prompt_file"

  # Build droid command — critique needs 'high' to write verdict files
  local -a droid_cmd=(droid exec)
  if [[ "$SKIP_PERMISSIONS" == true ]]; then
    droid_cmd+=(--skip-permissions-unsafe)
  else
    droid_cmd+=(--auto high)
  fi
  [[ -n "$model" ]] && droid_cmd+=(-m "$model")
  [[ -n "$reasoning" ]] && droid_cmd+=(-r "$reasoning")
  droid_cmd+=(-f "$prompt_file")

  cd "$REPO_ROOT"
  "${droid_cmd[@]}"
  local exit_code=$?
  rm -f "$prompt_file"

  if [[ $exit_code -ne 0 ]]; then
    echo "⚠ Critique pass failed (exit $exit_code) — continuing without revision"
    return 1
  fi

  # Check for REVISE verdict in the output
  # The critique is written to the spec directory — find it
  local feature_dir
  feature_dir=$(find "$REPO_ROOT/specs" -maxdepth 1 -type d -name "[0-9]*" 2>/dev/null | sort -r | head -1)

  if [[ -z "$feature_dir" ]]; then
    echo "⚠ No feature directory found — cannot check critique verdict"
    return 1
  fi

  # Look for REVISE in any recently modified markdown file
  local revise_found=false
  while IFS= read -r file; do
    if grep -qi "REVISE" "$file" 2>/dev/null; then
      revise_found=true
      echo "↻ Critique verdict: REVISE — re-running $stage with feedback"
      break
    fi
  done < <(find "$feature_dir" -name "*.md" -mmin -2 2>/dev/null)

  if [[ "$revise_found" == "true" ]]; then
    return 0
  else
    echo "✅ Critique verdict: ACCEPT"
    return 1
  fi
}

usage() {
  echo "Usage: $(basename "$0") <stage> [user-arguments] [options]"
  echo ""
  echo "Bridges Spec Kit agent files to droid exec, adding personas and a"
  echo "review loop. Translates interactive prompts into non-interactive"
  echo "one-shot execution."
  echo ""
  echo "Stages:"
  echo "  constitution   Create/update project constitution"
  echo "  specify        Generate feature specification          [Analyst]"
  echo "  clarify        Clarify spec ambiguities                [Analyst]"
  echo "  plan           Create implementation plan              [Architect]"
  echo "  checklist      Generate quality checklist              [Architect]"
  echo "  tasks          Decompose plan into tasks               [Architect]"
  echo "  analyze        Cross-artifact consistency check        [Architect]"
  echo "  implement      Execute tasks and produce code          [Developer]"
