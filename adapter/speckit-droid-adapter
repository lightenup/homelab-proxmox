build_preamble() {
  local persona_name="$1"

  cat <<'EOF'
IMPORTANT EXECUTION CONTEXT — READ BEFORE PROCEEDING:

You are running non-interactively via `droid exec`. You MUST follow these rules:

1. DO NOT ask questions, present option tables, or wait for user responses.
2. When instructions say "wait for user" or "ask the user", instead make an
   informed decision based on available context and document your reasoning.
3. Use reasonable defaults when the prompt offers choices.
4. For clarification-style steps, derive answers from the spec, constitution,
   addendum, or existing project context — do not leave gaps.
5. If you cannot proceed without user input, write the blocker to stdout
   and stop. Do not guess on critical decisions.

EOF

  # Inject persona if one is mapped
  if [[ -n "$persona_name" ]]; then
    local persona_file="$REPO_ROOT/adapter/personas/${persona_name}.md"
    if [[ -f "$persona_file" ]]; then
      echo "---"
      echo ""
      cat "$persona_file"
      echo ""
      echo "---"
      echo ""
    else
      echo "<!-- Persona file not found: $persona_file -->" >&2
    fi
  fi
}

adapt_prompt() {
  local agent_file="$1"
  local user_args="$2"
  local persona_name="$3"
  local stage="${4:-}"
  # Remaining args are input file paths
  shift 4 2>/dev/null || true
  local -a input_files=("$@")

  # 1. Emit the non-interactive preamble + persona
  build_preamble "$persona_name"

  # 2. Inject output format template if available for this stage
  local output_format="$REPO_ROOT/adapter/output-formats/${stage}.md"
  if [[ -n "$stage" ]] && [[ -f "$output_format" ]]; then
    echo "---"
    echo ""
    cat "$output_format"
    echo ""
    echo "---"
    echo ""
  fi

  # 3. Read agent file, substitute $ARGUMENTS with user input
  if [[ -n "$user_args" ]]; then
    # Collapse newlines to spaces to avoid awk "newline in string" errors
    local sanitized_args
    sanitized_args="$(printf '%s' "$user_args" | tr '\n' ' ' | sed 's/  */ /g')"
    awk -v args="$sanitized_args" '{gsub(/\$ARGUMENTS/, args); print}' "$agent_file"
  else
    awk '{gsub(/\$ARGUMENTS/, ""); print}' "$agent_file"
  fi

  # 4. Append reference documents from -f / @file
  for fpath in "${input_files[@]}"; do
    [[ -z "$fpath" ]] && continue
    echo ""
    echo "---"
    echo ""
    echo "## Reference Document"
    echo "<!-- Source: $(basename "$fpath") -->"
    echo ""
    cat "$fpath"
    echo ""
    echo "---"
  done
}

run_stage() {
  local stage="$1"
  local user_args="$2"
  local auto_level="$3"
  local dry_run="$4"
  local extra_context="${5:-}"
  local model="$6"
  local reasoning="$7"

  # Resolve per-stage defaults when no explicit flag provided
  model=$(resolve_model "$model" "$stage")
  reasoning=$(resolve_reasoning "$reasoning" "$stage")

  local agent_path="$REPO_ROOT/${AGENT_FILES[$stage]}"
  local persona_name="${PERSONAS[$stage]:-}"

  if [[ ! -f "$agent_path" ]]; then
    echo "Error: Agent file not found: $agent_path"
    echo "Have you run 'specify init'?"
    return 1
  fi

  local prompt_file
  prompt_file=$(mktemp "${TMPDIR:-/tmp}/droid-prompt-${stage}-XXXXXX")
  TMPFILES+=("$prompt_file")

  adapt_prompt "$agent_path" "$user_args" "$persona_name" "$stage" "${INPUT_FILES[@]}" > "$prompt_file"

  # Append extra context (e.g., review feedback for re-implementation)
  if [[ -n "$extra_context" ]]; then
    echo "" >> "$prompt_file"
    echo "$extra_context" >> "$prompt_file"
  fi

  # Build display strings
  local model_display="${model:-default}"
  local reasoning_display="${reasoning:-default}"

  if [[ "$dry_run" == "true" ]]; then
    echo "=== Dry run: adapted prompt for stage '$stage' ==="
    echo "=== Agent file: ${AGENT_FILES[$stage]} ==="
    echo "=== Persona: ${persona_name:-none} ==="
    echo "=== Auto level: $auto_level ==="
    echo "=== Model: $model_display ==="
    echo "=== Reasoning: $reasoning_display ==="
    echo "=== Prompt file: $prompt_file ==="
    echo ""
    cat "$prompt_file"
    return 0
  fi

  echo "▶ Running stage: $stage (auto: $auto_level, persona: ${persona_name:-none})"
  echo "  Agent: ${AGENT_FILES[$stage]}"
  echo "  Model: $model_display | Reasoning: $reasoning_display"
  [[ -n "$user_args" ]] && echo "  Input: $user_args"
  if [[ ${#INPUT_FILES[@]} -gt 0 ]]; then
    echo "  Input files: ${INPUT_FILES[*]}"
  fi
  echo ""

  # Build droid command
  local -a droid_cmd=(droid exec)
  if [[ "$SKIP_PERMISSIONS" == true ]]; then
    droid_cmd+=(--skip-permissions-unsafe)
  else
    droid_cmd+=(--auto "$auto_level")
  fi
  [[ -n "$model" ]] && droid_cmd+=(-m "$model")
  [[ -n "$reasoning" ]] && droid_cmd+=(-r "$reasoning")
  droid_cmd+=(-f "$prompt_file")

  cd "$REPO_ROOT"
  "${droid_cmd[@]}"
  local exit_code=$?
  rm -f "$prompt_file"
  return $exit_code
}

run_review() {
  local auto_level="$1"
  local dry_run="$2"
  local model="$3"
  local reasoning="$4"

  # Resolve per-stage defaults when no explicit flag provided
  model=$(resolve_model "$model" "review")
  reasoning=$(resolve_reasoning "$reasoning" "review")

  local review_prompt="$REPO_ROOT/adapter/review-prompt.md"
  if [[ ! -f "$review_prompt" ]]; then
    echo "Error: Review prompt not found: $review_prompt"
    return 1
  fi

  local prompt_file
  prompt_file=$(mktemp "${TMPDIR:-/tmp}/droid-prompt-review-XXXXXX")
  TMPFILES+=("$prompt_file")

  # Build: preamble + persona + output format + review prompt
  build_preamble "reviewer" > "$prompt_file"

  # Inject review output format if available
  local review_format="$REPO_ROOT/adapter/output-formats/review.md"
  if [[ -f "$review_format" ]]; then
    echo "---" >> "$prompt_file"
    echo "" >> "$prompt_file"
    cat "$review_format" >> "$prompt_file"
    echo "" >> "$prompt_file"
    echo "---" >> "$prompt_file"
    echo "" >> "$prompt_file"
  fi

  cat "$review_prompt" >> "$prompt_file"

  # Build display strings
  local model_display="${model:-default}"
  local reasoning_display="${reasoning:-default}"

  if [[ "$dry_run" == "true" ]]; then
    echo "=== Dry run: adapted prompt for stage 'review' ==="
    echo "=== Persona: reviewer ==="
    echo "=== Auto level: $auto_level ==="
    echo "=== Model: $model_display ==="
    echo "=== Reasoning: $reasoning_display ==="
    echo "=== Prompt file: $prompt_file ==="
    echo ""
    cat "$prompt_file"
    return 0
  fi

  echo "▶ Running stage: review (auto: $auto_level, persona: reviewer)"
  echo "  Model: $model_display | Reasoning: $reasoning_display"
  echo ""

  # Build droid command
  local -a droid_cmd=(droid exec)
  if [[ "$SKIP_PERMISSIONS" == true ]]; then
    droid_cmd+=(--skip-permissions-unsafe)
  else
    droid_cmd+=(--auto "$auto_level")
  fi
  [[ -n "$model" ]] && droid_cmd+=(-m "$model")
  [[ -n "$reasoning" ]] && droid_cmd+=(-r "$reasoning")
  droid_cmd+=(-f "$prompt_file")

  cd "$REPO_ROOT"
  "${droid_cmd[@]}"
  local exit_code=$?
  rm -f "$prompt_file"
  return $exit_code
}

# Run project tests and lint; capture output on failure
# Returns 0 if all pass, 1 if any fail (output in $GATE_OUTPUT)
GATE_OUTPUT=""
run_gate_tests() {
  local test_config="$REPO_ROOT/adapter/test-config.sh"
  if [[ ! -f "$test_config" ]]; then
    echo "⚠ No test-config.sh found — skipping test gate"
    return 0
  fi

  # Source the test config to get project-specific commands
  source "$test_config"

  GATE_OUTPUT=""
  local failed=false

  echo "🧪 Running project tests..."
  local test_output
  if test_output=$(run_project_tests 2>&1); then
    echo "  ✅ Tests passed"
  else
    echo "  ❌ Tests failed"
    GATE_OUTPUT="## Test Failures"$'\n\n'"$test_output"
    failed=true
  fi

  echo "🔍 Running linter..."
  local lint_output
  if lint_output=$(run_project_lint 2>&1); then
    echo "  ✅ Lint passed"
  else
    echo "  ❌ Lint failed"
    GATE_OUTPUT="$GATE_OUTPUT"$'\n\n'"## Lint Errors"$'\n\n'"$lint_output"
    failed=true
  fi

  if $failed; then
    return 1
  fi
  return 0
}

run_build_loop() {
  local user_args="$1"
  local auto_level="$2"
  local dry_run="$3"
  local model="$4"
  local reasoning="$5"
  local no_tests="${6:-false}"

  # Resolve per-stage defaults for display
  local impl_model impl_reasoning rev_model rev_reasoning
  impl_model=$(resolve_model "$model" "implement")
  impl_reasoning=$(resolve_reasoning "$reasoning" "implement")
  rev_model=$(resolve_model "$model" "review")
  rev_reasoning=$(resolve_reasoning "$reasoning" "review")

  local impl_model_display="${impl_model:-default}"
  local rev_model_display="${rev_model:-default}"

  if [[ "$dry_run" == "true" ]]; then
    echo "=== Build loop: implement + review (max $MAX_REVIEW_ITERATIONS iterations) ==="
    echo ""
    echo "--- Implement prompt ---"
    run_stage "implement" "$user_args" "$auto_level" "true" "" "$model" "$reasoning"
    echo ""
    echo "--- Review prompt ---"
    run_review "$auto_level" "true" "$model" "$reasoning"
    return 0
  fi

  local feedback=""

  for iteration in $(seq 1 $MAX_REVIEW_ITERATIONS); do
    echo "╔══════════════════════════════════════════════════════════════╗"
    echo "║  Build iteration $iteration of $MAX_REVIEW_ITERATIONS"
    echo "║  Implement: $impl_model_display | Review: $rev_model_display"
    echo "╚══════════════════════════════════════════════════════════════╝"
    echo ""

    # --- Implement phase ---
    if [[ -n "$feedback" ]]; then
      local extra_context
      extra_context=$(cat <<FEEDBACK_EOF

---

## Review Feedback from Previous Iteration

The reviewer found issues that need to be addressed. Fix ONLY the items
listed below. Do not re-implement tasks that were already passing.

$feedback
FEEDBACK_EOF
      )
      run_stage "implement" "$user_args" "$auto_level" "false" "$extra_context" "$model" "$reasoning"
    else
      run_stage "implement" "$user_args" "$auto_level" "false" "" "$model" "$reasoning"
    fi

    echo ""

    # --- Test/lint gate ---
    if [[ "$no_tests" != "true" ]]; then
      if ! run_gate_tests; then
        echo ""
        echo "⚠ Tests/lint failed — skipping review, feeding failures back to implement"
        feedback="$GATE_OUTPUT"
        if [[ $iteration -eq $MAX_REVIEW_ITERATIONS ]]; then
          echo "⚠ Max iterations ($MAX_REVIEW_ITERATIONS) reached with failing tests."
          return 1
        fi
        echo "↻ Re-implementing to fix test/lint failures (iteration $((iteration + 1)))"
        echo ""
        continue
      fi
    fi

    # --- Review phase ---
    run_review "$auto_level" "false" "$model" "$reasoning"

    # --- Check verdict ---
    # Find the review file in the current feature directory
    local feature_dir
    feature_dir=$(find "$REPO_ROOT/specs" -maxdepth 1 -type d -name "[0-9]*" 2>/dev/null | sort -r | head -1)

    if [[ -z "$feature_dir" ]]; then
      echo "⚠ Could not find feature directory to check review verdict"
      break
    fi

    local review_file="$feature_dir/review.md"
    if [[ ! -f "$review_file" ]]; then
      echo "⚠ No review.md found — reviewer may not have written output"
      break
    fi

    # Extract verdict
    if grep -qi "APPROVED" "$review_file" && ! grep -qi "CHANGES_REQUESTED" "$review_file"; then
      echo ""
      echo "✅ Review APPROVED on iteration $iteration"
      return 0
    fi

    if [[ $iteration -eq $MAX_REVIEW_ITERATIONS ]]; then
      echo ""
      echo "⚠ Max iterations ($MAX_REVIEW_ITERATIONS) reached. Check review.md for remaining items."
      return 0
    fi

    # Extract feedback for next iteration
    feedback=$(awk '/^## Blocking Issues/,/^## [^B]/' "$review_file" | head -50)
    local dev_feedback
    dev_feedback=$(awk '/^## Feedback for Developer/,/^## [^F]/' "$review_file" | head -50)
    if [[ -n "$dev_feedback" ]]; then
      feedback="$feedback"$'\n\n'"$dev_feedback"
    fi

    echo ""
    echo "↻ Changes requested — starting iteration $((iteration + 1))"
    echo ""
  done
}

# --- Parse arguments ---------------------------------------------------------

if [[ $# -lt 1 ]]; then
  usage
fi

STAGE=""
USER_ARGS=""
AUTO_LEVEL="$DEFAULT_AUTO"
MODEL="$DEFAULT_MODEL"
REASONING="$DEFAULT_REASONING"
DRY_RUN=false
NO_CRITIQUE=false
NO_TESTS=false
NO_AUTO_ROUTE=false
SKIP_PERMISSIONS=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    --auto)
      AUTO_LEVEL="${2:?'--auto requires a level (low|medium|high)'}"
      shift 2
      ;;
    -m|--model)
      MODEL="${2:?'-m/--model requires a model id'}"
      shift 2
      ;;
    -r|--reasoning-effort)
      REASONING="${2:?'-r/--reasoning-effort requires a level'}"
      shift 2
      ;;
    --no-critique)
      NO_CRITIQUE=true
      shift
      ;;
    --no-tests)
      NO_TESTS=true
      shift
      ;;
    --no-auto-route)
      NO_AUTO_ROUTE=true
      shift
      ;;
    --dry-run)
      DRY_RUN=true
      shift
      ;;
    --skip-permissions-unsafe)
      SKIP_PERMISSIONS=true
      shift
      ;;
    -f|--input-file)
      _fpath="${2:?'-f/--input-file requires a file path'}"
      [[ -f "$_fpath" ]] || { echo "Error: Input file not found: $_fpath"; exit 1; }
      _fsize=$(wc -c < "$_fpath")
      if [[ $_fsize -gt $MAX_INPUT_FILE_BYTES ]]; then
        echo "Warning: $_fpath is $(( _fsize / 1024 ))KB (limit ${MAX_INPUT_FILE_BYTES}B) — truncating"
      fi
      INPUT_FILES+=("$_fpath")
      shift 2
      ;;
    --help|-h)
      usage
      ;;
    *)
      # @file shorthand: expand to input file reference
      if [[ "$1" == @* && ${#1} -gt 1 ]]; then
        _fpath="${1#@}"
        [[ -f "$_fpath" ]] || { echo "Error: Input file not found: $_fpath"; exit 1; }
        INPUT_FILES+=("$_fpath")
        shift
        continue
      fi
      if [[ -z "$STAGE" ]]; then
        STAGE="$1"
      else
        if [[ -n "$USER_ARGS" ]]; then
          USER_ARGS="$USER_ARGS $1"
        else
          USER_ARGS="$1"
        fi
      fi
      shift
      ;;
  esac
done

# --- Validate ----------------------------------------------------------------

ALL_STAGES="constitution specify clarify plan checklist tasks analyze implement review build"
if ! echo " $ALL_STAGES " | grep -q " $STAGE "; then
  echo "Error: Unknown stage '$STAGE'"
  echo "Valid stages: $ALL_STAGES"
  exit 1
fi

# --- Routing -----------------------------------------------------------------

# Marker → suggested next stage mapping
declare -A ROUTE_MARKERS=(
  ["NEEDS CLARIFICATION"]="clarify"
  ["NEEDS_CLARIFICATION"]="clarify"
  ["BLOCKED"]=""               # no auto-route, just warn
  ["SCOPE CREEP"]="specify"
  ["SCOPE_CREEP"]="specify"
  ["INCONSISTENCY"]="analyze"
  ["SPEC INCOMPLETE"]="specify"
  ["SPEC_INCOMPLETE"]="specify"
)

# Check for routing markers in the most recently modified spec artifacts
check_routing() {
  local stage="$1"

  local feature_dir
  feature_dir=$(find "$REPO_ROOT/specs" -maxdepth 1 -type d -name "[0-9]*" 2>/dev/null | sort -r | head -1)

  if [[ -z "$feature_dir" ]]; then
    return 0
  fi

  local found_any=false

  for marker in "${!ROUTE_MARKERS[@]}"; do
    # Search recently modified files for markers (case-insensitive)
    local matching_files
    matching_files=$(grep -rli "\[${marker}\]" "$feature_dir"/*.md 2>/dev/null || true)

    if [[ -n "$matching_files" ]]; then
      found_any=true
      local target="${ROUTE_MARKERS[$marker]}"

      if [[ -n "$target" ]]; then
        echo ""
        echo "⚡ Routing marker found: [$marker]"
        echo "   Suggested next stage: $target"
        echo "   Run: ./adapter/speckit-droid-adapter $target"
      else
        echo ""
        echo "⚠ Routing marker found: [$marker]"
        echo "   This requires manual intervention — review the flagged artifact"
        while IFS= read -r file; do
          echo "   → $(basename "$file")"
        done <<< "$matching_files"
      fi
    fi
  done

  if $found_any; then
    echo ""
  fi
}

# --- Execute -----------------------------------------------------------------

case "$STAGE" in
  review)
    run_review "$AUTO_LEVEL" "$DRY_RUN" "$MODEL" "$REASONING"
    ;;
  build)
    run_build_loop "$USER_ARGS" "$AUTO_LEVEL" "$DRY_RUN" "$MODEL" "$REASONING" "$NO_TESTS"
    ;;
  *)
    if $DRY_RUN; then
      run_stage "$STAGE" "$USER_ARGS" "$AUTO_LEVEL" "true" "" "$MODEL" "$REASONING"
      exit 0
    fi
    run_stage "$STAGE" "$USER_ARGS" "$AUTO_LEVEL" "false" "" "$MODEL" "$REASONING"

    # Self-critique pass for specify/plan stages
    if ! $NO_CRITIQUE && should_critique "$STAGE"; then
      eff_model=$(resolve_model "$MODEL" "$STAGE")
      eff_reasoning=$(resolve_reasoning "$REASONING" "$STAGE")
      if run_critique "$STAGE" "$AUTO_LEVEL" "$eff_model" "$eff_reasoning"; then
        echo "↻ Re-running $STAGE with critique feedback..."
        run_stage "$STAGE" "$USER_ARGS" "$AUTO_LEVEL" "false" \
          "Review your previous output and address the issues identified in the self-critique above." \
          "$MODEL" "$REASONING"
      fi
    fi

    # Conditional routing check
    if ! $NO_AUTO_ROUTE; then
      check_routing "$STAGE"
    fi
    ;;
esac
