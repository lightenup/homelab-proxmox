{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["checks_schema_version", "checks"],
  "properties": {
    "checks_schema_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$"
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["check_id", "result", "timestamp", "phase", "source"],
        "properties": {
          "check_id": { "type": "string" },
          "title": { "type": "string" },
          "phase": { "type": "string" },
          "source": { "type": "string", "enum": ["harness", "ansible"] },
          "severity": { "type": "string", "enum": ["blocker", "high", "medium", "low"] },
          "expected": { "type": "string" },
          "result": { "type": "string", "enum": ["PASS", "FAIL", "SKIP"] },
          "reason": { "type": "string" },
          "evidence_refs": {
            "type": "array",
            "items": { "type": "string" }
          },
          "timestamp": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}
