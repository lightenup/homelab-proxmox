{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://homelab-proxmox/schemas/evidence-manifest.schema.json",
  "title": "Evidence Manifest",
  "description": "Inventory of all artifacts in evidence pack with metadata",
  "type": "object",
  "required": [
    "runid",
    "created_at",
    "artifacts_count",
    "artifacts"
  ],
  "properties": {
    "runid": {
      "type": "string",
      "pattern": "^lab-[0-9]{8}-[0-9]{6}$",
      "description": "Evidence pack identifier"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when manifest was generated"
    },
    "artifacts_count": {
      "type": "integer",
      "minimum": 0,
      "description": "Total number of artifacts"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "type",
          "size_bytes"
        ],
        "properties": {
          "path": {
            "type": "string",
            "description": "Relative path from evidence pack root"
          },
          "type": {
            "type": "string",
            "enum": ["log", "report", "json", "text", "binary"],
            "description": "Artifact type category"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0,
            "description": "File size in bytes"
          },
          "produced_by": {
            "type": "string",
            "description": "Check ID or phase that generated this artifact"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "description": "Hex digest for integrity verification"
          }
        }
      }
    }
  }
}
