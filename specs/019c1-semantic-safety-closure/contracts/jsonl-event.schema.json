{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://homelab-proxmox/schemas/jsonl-event.schema.json",
  "title": "JSONL Event",
  "description": "Real-time structured event for observability during suite execution",
  "type": "object",
  "required": [
    "timestamp",
    "event_type",
    "runid",
    "data"
  ],
  "properties": {
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp (UTC)"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "suite_start",
        "phase_start",
        "check_start",
        "check_complete",
        "phase_complete",
        "warning",
        "error",
        "suite_complete"
      ],
      "description": "Event type identifier"
    },
    "runid": {
      "type": "string",
      "pattern": "^lab-[0-9]{8}-[0-9]{6}$",
      "description": "Evidence pack identifier"
    },
    "data": {
      "type": "object",
      "description": "Event-specific data (schema varies by event_type)"
    }
  },
  "oneOf": [
    {
      "properties": {
        "event_type": {"const": "suite_start"},
        "data": {
          "type": "object",
          "required": ["profile", "expected_duration_minutes"],
          "properties": {
            "profile": {"type": "string"},
            "expected_duration_minutes": {"type": "integer"}
          }
        }
      }
    },
    {
      "properties": {
        "event_type": {"const": "phase_start"},
        "data": {
          "type": "object",
          "required": ["phase", "type", "path"],
          "properties": {
            "phase": {"type": "string"},
            "type": {"type": "string", "enum": ["playbook", "script", "role"]},
            "path": {"type": "string"}
          }
        }
      }
    },
    {
      "properties": {
        "event_type": {"const": "check_start"},
        "data": {
          "type": "object",
          "required": ["check_id", "title", "severity"],
          "properties": {
            "check_id": {"type": "string", "pattern": "^[A-Z]+-[0-9]{3}$"},
            "title": {"type": "string"},
            "severity": {"type": "string", "enum": ["blocker", "high", "medium", "low"]}
          }
        }
      }
    },
    {
      "properties": {
        "event_type": {"const": "check_complete"},
        "data": {
          "type": "object",
          "required": ["check_id", "result", "duration_ms"],
          "properties": {
            "check_id": {"type": "string", "pattern": "^[A-Z]+-[0-9]{3}$"},
            "result": {"type": "string", "enum": ["PASS", "FAIL", "SKIP", "ERROR"]},
            "duration_ms": {"type": "integer"}
          }
        }
      }
    },
    {
      "properties": {
        "event_type": {"const": "phase_complete"},
        "data": {
          "type": "object",
          "required": ["phase", "status", "duration_ms"],
          "properties": {
            "phase": {"type": "string"},
            "status": {"type": "string"},
            "duration_ms": {"type": "integer"}
          }
        }
      }
    },
    {
      "properties": {
        "event_type": {"const": "warning"},
        "data": {
          "type": "object",
          "required": ["message"],
          "properties": {
            "message": {"type": "string"},
            "check_id": {"type": "string", "pattern": "^[A-Z]+-[0-9]{3}$"}
          }
        }
      }
    },
    {
      "properties": {
        "event_type": {"const": "error"},
        "data": {
          "type": "object",
          "required": ["message"],
          "properties": {
            "message": {"type": "string"},
            "check_id": {"type": "string", "pattern": "^[A-Z]+-[0-9]{3}$"}
          }
        }
      }
    },
    {
      "properties": {
        "event_type": {"const": "suite_complete"},
        "data": {
          "type": "object",
          "required": ["status", "passed_count", "failed_count"],
          "properties": {
            "status": {"type": "string", "enum": ["SUCCESS", "FAILURE", "INTERRUPTED"]},
            "passed_count": {"type": "integer"},
            "failed_count": {"type": "integer"}
          }
        }
      }
    }
  ]
}
