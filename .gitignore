# Terraform (GitHub workspace)
terraform/github/.terraform/
terraform/github/.terraform.lock.hcl
terraform/github/github.tfvars

# Ansible
ansible/inventories/generated/
ansible/playbooks/artifacts/
*.retry

# Secrets (never commit)
**/vault.yml
**/*secret*.yml
**/*_secrets.yml
**/tailscale_auth_key*
**/*.key
**/*.pem
# Exception, by name rather than by loosening the rule above: the Mac's TLS certificate is
# the PUBLIC half of a self-signed pair, and the gateway needs it in-tree to verify the
# local-tier connection (FR-013, backlog 069). The private key is written to
# ~/.config/hermes-tls/key.pem by mac-tls-terminator/make-cert.sh and never enters the repo.
!ansible/roles/llm_router/files/mac-ca.pem
ansible/.vault-pass.txt
sec_pve

# Disaster Recovery drill files (local only)
scripts/dr/rclone.conf
scripts/dr/*.env

# Claude Code (machine-local settings)
.claude/settings.local.json

