# Environment variables for disaster recovery scripts
# Copy this file to .env and populate with actual values from Bitwarden
# The .env file is gitignored to prevent credential leakage

# Hetzner Object Storage Configuration
HETZNER_S3_ENDPOINT="https://nbg1.your-objectstorage.com"
HETZNER_S3_BUCKET="synbackup"
# From Bitwarden "s3 bucket synbackup" → Access Key field (e.g., "ABC123" format)
HETZNER_S3_ACCESS_KEY="YOUR_HETZNER_ACCESS_KEY_HERE"
# From Bitwarden "s3 bucket synbackup" → secret field (e.g., "ABC123..." format)
HETZNER_S3_SECRET_KEY="YOUR_HETZNER_SECRET_KEY_HERE"

# Backup path within bucket
BACKUP_PATH="DiskStation413j_1.hbk"

# Backup Encryption (retrieve from Bitwarden)
# From Bitwarden "Synology Hyper backup clientside encr" field (long string)
# Used in Phase C by Hyper Backup Explorer, NOT for S3 access
# IMPORTANT: Use quotes if key contains special characters ($, !, etc.)
BACKUP_ENCRYPTION_KEY="YOUR_SYNOLOGY_ENCRYPTION_KEY_HERE"

# rclone Configuration
RCLONE_CONFIG_PATH="${PWD}/rclone.conf"
RCLONE_REMOTE_NAME="hetzner-backup"

# Download Configuration
DOWNLOAD_TARGET_DIR="${HOME}/dr-restore"
DOWNLOAD_DRY_RUN="true"  # Set to false for actual downloads

# Usage:
# 1. Copy this file: cp .env.example .env
# 2. Retrieve credentials from Bitwarden
# 3. Edit .env and replace placeholder values
# 4. Source before running scripts: source .env
