{
  "profile_id": "service-deploy",
  "description": "Evidence pack requirements for service deployments",
  "required_fields": [
    {
      "path": "reports/plan/plan.txt",
      "type": "file",
      "description": "Terraform plan output (text)"
    },
    {
      "path": "reports/plan/plan.json",
      "type": "file",
      "description": "Terraform plan output (JSON)"
    },
    {
      "path": "preflight.txt",
      "type": "file",
      "description": "Preflight checks and inputs"
    },
    {
      "path": "blast-radius.json",
      "type": "file",
      "description": "Blast radius summary"
    },
    {
      "path": "reports/lab-snapshot.json",
      "type": "file",
      "description": "LAB inventory snapshot (required for all runs)"
    }
  ],
  "conditional_fields": [
    {
      "path": "reports/prod-tfvars/provisioning.txt",
      "type": "file",
      "condition": "environment == 'prod'",
      "description": "PROD tfvars provisioning report (redacted; required for PROD runs)"
    },
    {
      "path": "reports/prod-tfvars/validation.json",
      "type": "file",
      "condition": "environment == 'prod'",
      "description": "PROD tfvars validation proof (required for PROD runs)"
    },
    {
      "path": "reports/prod-tfvars/prod.tfvars.sha256",
      "type": "file",
      "condition": "environment == 'prod'",
      "description": "PROD tfvars hash (required for PROD runs)"
    },
    {
      "path": "reports/lab-tfvars/provisioning.txt",
      "type": "file",
      "condition": "environment == 'lab'",
      "description": "LAB tfvars provisioning report (redacted; required for LAB runs)"
    },
    {
      "path": "reports/lab-tfvars/validation.json",
      "type": "file",
      "condition": "environment == 'lab'",
      "description": "LAB tfvars validation proof (required for LAB runs)"
    },
    {
      "path": "reports/lab-tfvars/lab.tfvars.sha256",
      "type": "file",
      "condition": "environment == 'lab'",
      "description": "LAB tfvars hash (required for LAB runs)"
    },
    {
      "path": "reports/lab/fingerprint.before.json",
      "type": "file",
      "condition": "environment == 'lab'",
      "description": "Production fingerprint before the LAB run (067)"
    },
    {
      "path": "reports/lab/fingerprint.after.json",
      "type": "file",
      "condition": "environment == 'lab'",
      "description": "Production fingerprint after teardown (067; written even on failure)"
    },
    {
      "path": "reports/lab/teardown.json",
      "type": "file",
      "condition": "environment == 'lab'",
      "description": "LAB teardown result (067); must report ok=true"
    },
    {
      "path": "reports/apply/lxc-mountpoints.txt",
      "type": "file",
      "condition": "service has host-path bind mounts",
      "description": "Before/after pct config for bind mount operations"
    }
  ]
}
