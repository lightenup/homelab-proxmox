#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/../.." && pwd)"

export ANSIBLE_CONFIG="${REPO_ROOT}/ansible/ansible.cfg"
export ANSIBLE_COLLECTIONS_PATHS="${REPO_ROOT}/ansible/collections:${ANSIBLE_COLLECTIONS_PATHS:-}"

LIB_DIR="${SCRIPT_DIR}/lib"
# shellcheck source=lib/artifacts.sh
source "${LIB_DIR}/artifacts.sh"
# shellcheck source=lib/evidence.sh
source "${LIB_DIR}/evidence.sh"
# shellcheck source=lib/jsonl.sh
source "${LIB_DIR}/jsonl.sh"
# shellcheck source=lib/snapshot.sh
source "${LIB_DIR}/snapshot.sh"
# shellcheck source=lib/sudo.sh
source "${LIB_DIR}/sudo.sh"
# shellcheck source=lib/tfvars.sh
source "${LIB_DIR}/tfvars.sh"

# Evidence namespace for this feature (separate from lab harness)
: "${ARTIFACT_RUNS_DIR:=service-deploy-runs}"

CONTRACT_VERSION="1.0.0"
PROFILE_ID="service-deploy"

PROD_CONFIRM_STRING="deploy-prod"

SERVICE_SCOPE_ALLOWLIST_PATH_DEFAULT="${REPO_ROOT}/scripts/lab/service-scope-allowlist.json"

STATE_PATH_DEFAULT_ROOT="/var/lib/homelab-proxmox/state/services"

# Terraform working directory (repo-local). For Spec 023 hardening we prefer
# per-service roots to avoid cross-service plans.
TERRAFORM_DIR=""

usage() {
    cat <<'EOF'
Usage:
    pve-service-deploy <plan|apply> [--environment <lab|prod>] [--service <slug>] [--confirm <string>] [--from-plan-run-id <RUN_ID>]

Notes:
  - This script is intended to run on the Proxmox host as a non-root automation user.
  - Evidence bundles are written under:
      $ARTIFACT_ROOT/$ARTIFACT_RUNS_DIR/<run_id>
EOF
}

die() {
    echo "ERROR: $*" >&2
    exit 1
}

is_slug() {
    [[ "$1" =~ ^[a-z0-9][a-z0-9-]{0,62}$ ]]
}

parse_common_flags() {
    ENVIRONMENT="${ENVIRONMENT:-}"
    SERVICE="${SERVICE:-}"
    CONFIRM="${CONFIRM:-}"
    FROM_PLAN_RUN_ID="${FROM_PLAN_RUN_ID:-}"

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --environment)
                ENVIRONMENT="${2:-}"
                shift 2
                ;;
            --service)
                SERVICE="${2:-}"
                shift 2
                ;;
            --confirm)
                CONFIRM="${2:-}"
                shift 2
                ;;
            --from-plan-run-id)
                FROM_PLAN_RUN_ID="${2:-}"
                shift 2
                ;;
            -h|--help)
                usage
                exit 0
                ;;
            *)
                die "Unknown argument: $1"
                ;;
        esac
    done

    if [[ -z "${ENVIRONMENT}" ]]; then
        ENVIRONMENT="lab"
    fi

    case "${ENVIRONMENT}" in
        lab|prod) ;;
        *) die "Invalid --environment '${ENVIRONMENT}' (expected lab|prod)" ;;
    esac

    if [[ -z "${SERVICE}" ]]; then
        die "Missing required --service <slug>"
    fi
    if ! is_slug "${SERVICE}"; then
        die "Invalid --service '${SERVICE}' (expected slug like 'jellyfin')"
    fi

    if [[ -n "${FROM_PLAN_RUN_ID}" ]]; then
        if [[ "${FROM_PLAN_RUN_ID}" == *"/"* || "${FROM_PLAN_RUN_ID}" == *".."* ]]; then
            die "Invalid --from-plan-run-id '${FROM_PLAN_RUN_ID}' (must be a run_id, not a path)"
        fi
    fi
}

sha256_file() {
    local path="$1"
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum "${path}" | awk '{print $1}'
        return 0
    fi
    if command -v shasum >/dev/null 2>&1; then
        shasum -a 256 "${path}" | awk '{print $1}'
        return 0
    fi
    if command -v openssl >/dev/null 2>&1; then
        openssl dgst -sha256 "${path}" | awk '{print $NF}'
        return 0
    fi
    return 1
}

ensure_ansible_galaxy_requirements() {
    local requirements_file="${REPO_ROOT}/ansible/requirements.yml"
    if [[ ! -f "${requirements_file}" ]]; then
        return 0
    fi

    if ! command -v ansible-galaxy >/dev/null 2>&1; then
        die "ansible-galaxy not found (required to install ${requirements_file})"
    fi

    local req_hash=""
    req_hash="$(sha256_file "${requirements_file}" 2>/dev/null || true)"

    local cache_dir="${HOME}/.cache/homelab-proxmox"
    mkdir -p "${cache_dir}" || true

    local marker="${cache_dir}/ansible-requirements.installed"
    if [[ -n "${req_hash}" ]]; then
        marker="${cache_dir}/ansible-requirements.${req_hash}.installed"
    fi

    # If we previously installed requirements, still verify key deps exist.
    # The cache marker can become stale if roles/collections are removed on the host.
    local missing=false
    if grep -q "geerlingguy.docker" "${requirements_file}" 2>/dev/null; then
        if [[ ! -d "${REPO_ROOT}/ansible/roles/geerlingguy.docker" && ! -d "${HOME}/.ansible/roles/geerlingguy.docker" ]]; then
            missing=true
        fi
    fi
    if grep -q "community.docker" "${requirements_file}" 2>/dev/null; then
        if [[ ! -d "${REPO_ROOT}/ansible/collections/ansible_collections/community/docker" && ! -d "${HOME}/.ansible/collections/ansible_collections/community/docker" ]]; then
            missing=true
        fi
    fi

    # Best-effort caching: if the requirements file has not changed, skip re-install.
    if [[ -f "${marker}" && "${missing}" != "true" ]]; then
        return 0
    fi

    local galaxy_log=""
    if [[ -n "${EVIDENCE_ROOT:-}" ]]; then
        galaxy_log="${EVIDENCE_ROOT}/reports/apply/ansible-galaxy.txt"
        mkdir -p "${EVIDENCE_ROOT}/reports/apply" || true
        {
            echo "requirements_file=${requirements_file}"
            echo "requirements_hash=${req_hash:-unknown}"
        } >"${galaxy_log}" 2>/dev/null || true
    fi

    # Install both roles and collections declared in requirements.yml.
    # Use --force so a requirements change actually updates what is installed.
    if [[ -n "${galaxy_log}" ]]; then
        {
            echo "--- ansible-galaxy role install ---"
        } >>"${galaxy_log}" || true
        mkdir -p "${REPO_ROOT}/ansible/roles" "${REPO_ROOT}/ansible/collections" || true
        ansible-galaxy role install -r "${requirements_file}" --roles-path "${REPO_ROOT}/ansible/roles" --force 2>&1 | tee -a "${galaxy_log}"

        {
            echo "--- ansible-galaxy collection install ---"
        } >>"${galaxy_log}" || true
        ansible-galaxy collection install -r "${requirements_file}" --collections-path "${REPO_ROOT}/ansible/collections" --force 2>&1 | tee -a "${galaxy_log}"
    else
        mkdir -p "${REPO_ROOT}/ansible/roles" "${REPO_ROOT}/ansible/collections" || true
        ansible-galaxy role install -r "${requirements_file}" --roles-path "${REPO_ROOT}/ansible/roles" --force
        ansible-galaxy collection install -r "${requirements_file}" --collections-path "${REPO_ROOT}/ansible/collections" --force
    fi

    # Clean old markers (hash may change over time)
    rm -f "${cache_dir}/ansible-requirements."*.installed 2>/dev/null || true
    : >"${marker}" || true
}

git_sha_short() {
    local full
    full="$(git_sha_full)"
    if [[ "${full}" != "unknown" && "${full}" =~ ^[0-9a-fA-F]{8,40}$ ]]; then
        echo "${full:0:8}"
        return 0
    fi

    if command -v git >/dev/null 2>&1 && git -C "${REPO_ROOT}" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        git -C "${REPO_ROOT}" rev-parse --short=8 HEAD 2>/dev/null || echo "unknown"
    else
        echo "unknown"
    fi
}

git_sha_full() {
    # Prefer an explicitly provided SHA (CI can pass this even if .git is not synced).
    if [[ -n "${GIT_SHA:-}" ]]; then
        if [[ "${GIT_SHA}" =~ ^[0-9a-fA-F]{7,40}$ ]]; then
            echo "${GIT_SHA}"
            return 0
        fi
    fi

    if command -v git >/dev/null 2>&1 && git -C "${REPO_ROOT}" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        git -C "${REPO_ROOT}" rev-parse HEAD 2>/dev/null || echo "unknown"
    else
        echo "unknown"
    fi
}

git_is_dirty() {
    if ! command -v git >/dev/null 2>&1; then
        echo "unknown"
        return 0
    fi
    if ! git -C "${REPO_ROOT}" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        echo "unknown"
        return 0
    fi

    # Count any tracked/untracked changes.
    if [[ -n "$(git -C "${REPO_ROOT}" status --porcelain 2>/dev/null || true)" ]]; then
        echo "true"
    else
        echo "false"
    fi
}

git_branch_name() {
    if command -v git >/dev/null 2>&1 && git -C "${REPO_ROOT}" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        git -C "${REPO_ROOT}" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "unknown"
    else
        echo "unknown"
    fi
}

emit_plan_artifact_placeholders() {
    # Ensure evidence packs remain structurally valid even when planning fails early.
    # These placeholder files satisfy the service-deploy evidence profile requirements.
    # They are overwritten later when real plan artifacts are available.
    mkdir -p "${EVIDENCE_ROOT}/reports/plan"

    local plan_json="${EVIDENCE_ROOT}/reports/plan/plan.json"
    local plan_txt="${EVIDENCE_ROOT}/reports/plan/plan.txt"
    local blast_json="${EVIDENCE_ROOT}/blast-radius.json"

    if [[ ! -f "${plan_txt}" ]]; then
        {
            echo "PLAN UNAVAILABLE"
            echo "run_id=${RUN_ID}"
            echo "environment=${ENVIRONMENT}"
            echo "service=${SERVICE}"
            echo "note=this placeholder will be replaced if terraform plan succeeds"
        } >"${plan_txt}" 2>/dev/null || true
    fi

    if [[ ! -f "${plan_json}" ]]; then
        cat >"${plan_json}" <<EOF
{
  "format_version": "0.0",
  "terraform_version": "unknown",
  "resource_changes": []
}
EOF
    fi

    if [[ ! -f "${blast_json}" ]]; then
        cat >"${blast_json}" <<EOF
{
  "schema_version": "1.0.0",
  "run_id": "${RUN_ID}",
  "environment": "${ENVIRONMENT}",
  "service": "${SERVICE}",
  "counts": { "create": 0, "update": 0, "replace": 0, "destroy": 0 },
  "resources": [],
  "destructive": false,
  "note": "placeholder; blast radius unavailable until plan.json exists"
}
EOF
    fi
}

init_evidence_pack() {
    ensure_artifact_root

    local sha_short
    sha_short="$(git_sha_short)"

    local sha_full
    sha_full="$(git_sha_full)"

    local branch
    branch="$(git_branch_name)"

    local trigger_ref="${GIT_REF:-}"
    local trigger_ref_name="${GIT_REF_NAME:-}"

    # Structured RUN_ID: deterministic components + UTC timestamp for uniqueness.
    # Resulting format: <env>-<service>-<sha8>-YYYYMMDD-HHMMSS
    export RUN_ID_PREFIX="${ENVIRONMENT:-lab}-${SERVICE:-unknown}-${sha_short}"
    RUN_ID="$(create_evidence_pack "$(artifact_runs_path)")"
    EVIDENCE_ROOT="$(artifact_run_path "${RUN_ID}")"

    mkdir -p "${EVIDENCE_ROOT}/logs"
    mkdir -p "${EVIDENCE_ROOT}/reports/plan"

    init_jsonl_events "${EVIDENCE_ROOT}/logs/events.jsonl"

    # Preflight output is required evidence for this profile.
    cat >"${EVIDENCE_ROOT}/preflight.txt" <<EOF
run_id=${RUN_ID}
profile_id=${PROFILE_ID}
environment=${ENVIRONMENT}
service=${SERVICE}
git_branch=${branch}
trigger_ref=${trigger_ref}
trigger_ref_name=${trigger_ref_name}
EOF

    cat >"${EVIDENCE_ROOT}/summary.json" <<EOF
{
  "run_id": "${RUN_ID}",
  "profile_id": "${PROFILE_ID}",
  "contract_version": "${CONTRACT_VERSION}"
}
EOF

        local dirty
        dirty="$(git_is_dirty)"

        cat >"${EVIDENCE_ROOT}/provenance.json" <<EOF
{
    "run_id": "${RUN_ID}",
    "profile_id": "${PROFILE_ID}",
    "environment": "${ENVIRONMENT}",
    "service": "${SERVICE}",
    "git_sha": "${sha_full}",
    "git_sha_short": "${sha_short}",
    "git_branch": "${branch}",
    "git_dirty": "${dirty}",
    "trigger_ref": "${trigger_ref}",
    "trigger_ref_name": "${trigger_ref_name}",
    "runner": {
        "hostname": "$(hostname -s 2>/dev/null || hostname 2>/dev/null || echo unknown)",
        "user": "${USER:-unknown}"
    }
}
EOF

    cat >"${EVIDENCE_ROOT}/checks.json" <<'EOF'
{
  "checks_schema_version": "1.0.0",
  "checks": []
}
EOF

        cat >"${EVIDENCE_ROOT}/evidence_manifest.json" <<EOF
{
    "contract_version": "${CONTRACT_VERSION}",
    "manifest_schema_version": "1.0.0",
    "artifacts": []
}
EOF

    # Snapshot is required evidence for this profile.
    # Keep failures non-fatal, but always attempt to write a schema-shaped JSON.
    if ! write_lab_snapshot "${EVIDENCE_ROOT}/reports/lab-snapshot.json" "${ENVIRONMENT}" "${STATE_PATH_DEFAULT_ROOT}"; then
        echo "WARN: snapshot generation failed" >>"${EVIDENCE_ROOT}/preflight.txt"
    fi
}

preflight_ok() {
    local msg="${1:?preflight_ok requires a message}"
    echo "OK: ${msg}" >>"${EVIDENCE_ROOT}/preflight.txt"
}

preflight_fail() {
    local msg="${1:?preflight_fail requires a message}"
    echo "FAIL: ${msg}" >>"${EVIDENCE_ROOT}/preflight.txt"
}

assert_no_target_env() {
    # Detect target usage via TF_CLI_ARGS* which Terraform automatically appends.
    # See: https://developer.hashicorp.com/terraform/cli/config/environment-variables
    local vars=(
        TF_CLI_ARGS
        TF_CLI_ARGS_plan
        TF_CLI_ARGS_apply
        TF_CLI_ARGS_init
        TF_CLI_ARGS_validate
    )

    local v
    for v in "${vars[@]}"; do
        local val="${!v:-}"
        if [[ -z "${val}" ]]; then
            continue
        fi
        if [[ " ${val} " =~ [[:space:]]-target(=|[[:space:]]) ]]; then
            preflight_fail "targeted operation detected via ${v}; -target is forbidden"
            echo "ERROR: Targeted Terraform operations are forbidden (detected -target in ${v})." >&2
            echo "Remediation: remove any TF_CLI_ARGS* env vars containing -target and run a full plan." >&2
            return 1
        fi
    done
    preflight_ok "no targeted Terraform inputs detected"
    return 0
}

ensure_state_path() {
    local service="${1:?ensure_state_path requires a service name}"
    local dir="${STATE_PATH_DEFAULT_ROOT}/${service}"
    local state_path="${dir}/terraform.tfstate"

    mkdir -p "${dir}"

    # Safety: do NOT implicitly seed state from repo-local terraform.tfstate.
    # That file (if present) may represent a different environment and can cause
    # cross-environment drift (e.g., refreshing non-existent CTIDs in LAB).
    # If you need to migrate legacy state, opt-in explicitly.
    if [[ "${SEED_STATE_FROM_REPO:-}" == "1" ]]; then
        if [[ "${ENVIRONMENT:-}" != "prod" ]]; then
            die "Refusing to seed state from repo for non-prod environment (ENVIRONMENT=${ENVIRONMENT:-unknown}). Remove SEED_STATE_FROM_REPO or switch to prod."
        fi
        if [[ ! -f "${state_path}" && -f "${REPO_ROOT}/terraform/terraform.tfstate" ]]; then
            cp "${REPO_ROOT}/terraform/terraform.tfstate" "${state_path}"
        fi
    fi

    echo "${state_path}"
}

run_offline_verify() {
    "${REPO_ROOT}/scripts/lab/ci-verify.sh" "${EVIDENCE_ROOT}"
}

terraform_chdir() {
    # Guard against any accidental -target usage (explicit args).
    local arg
    for arg in "$@"; do
        if [[ "$arg" == "-target" || "$arg" == -target=* ]]; then
            preflight_fail "targeted operation attempted via explicit CLI arg '${arg}'"
            die "Targeted Terraform operations are forbidden (-target). Remove -target and re-run a full plan."
        fi
    done

    local tf_dir="${TERRAFORM_DIR:-${REPO_ROOT}/terraform}"
    terraform -chdir="${tf_dir}" "$@"
}

set_terraform_dir_for_service() {
    local service="${1:?set_terraform_dir_for_service requires service}"
    local per_service_dir="${REPO_ROOT}/terraform/services/${service}"

    if [[ -d "${per_service_dir}" && -f "${per_service_dir}/main.tf" ]]; then
        TERRAFORM_DIR="${per_service_dir}"
        return 0
    fi

    return 1
}

ensure_terraform() {
    local bin_dir="${HOME}/.local/bin"
    export PATH="${bin_dir}:${PATH}"

    if command -v terraform >/dev/null 2>&1; then
        return 0
    fi
    if [[ -x "${bin_dir}/terraform" ]]; then
        return 0
    fi

    local version="${TERRAFORM_VERSION:-1.6.6}"
    local os="linux"
    local arch="amd64"
    local url="https://releases.hashicorp.com/terraform/${version}/terraform_${version}_${os}_${arch}.zip"

    mkdir -p "${bin_dir}"

    local tmpdir
    tmpdir="$(mktemp -d)"

    command -v curl >/dev/null 2>&1 || die "terraform missing and curl not available to download it"
    command -v python3 >/dev/null 2>&1 || die "terraform missing and python3 not available to extract it"

    curl -fsSL "${url}" -o "${tmpdir}/terraform.zip" || die "failed to download terraform ${version}"

    ZIP_PATH="${tmpdir}/terraform.zip" OUT_DIR="${bin_dir}" python3 - <<'PY'
import os
import zipfile

zip_path = os.environ["ZIP_PATH"]
out_dir = os.environ["OUT_DIR"]

with zipfile.ZipFile(zip_path, 'r') as z:
    z.extract('terraform', out_dir)
PY

    chmod +x "${bin_dir}/terraform"

    rm -rf "${tmpdir}"

    command -v terraform >/dev/null 2>&1 || die "terraform install failed"
}

assert_state_lxc_exists_or_empty() {
    local state_path="${1:?assert_state_lxc_exists_or_empty requires state_path}"
    local service="${2:?assert_state_lxc_exists_or_empty requires service}"

    if [[ ! -f "${state_path}" ]]; then
        return 0
    fi

    local addr="module.${service}_lxc.proxmox_lxc.this"
    if ! terraform_chdir state list -state="${state_path}" 2>/dev/null | grep -qx "${addr}"; then
        return 0
    fi

    local state_show
    state_show="$(terraform_chdir state show -no-color -state="${state_path}" "${addr}" 2>/dev/null || true)"
    if [[ -z "${state_show}" ]]; then
        return 0
    fi

    # telmate/proxmox provider uses an id like: pve/lxc/101
    local id_line
    id_line="$(grep -E '^[[:space:]]*id[[:space:]]*=' <<<"${state_show}" | head -n 1 || true)"
    if [[ -z "${id_line}" ]]; then
        return 0
    fi

    local vmid=""
    vmid="$(sed -E 's/.*lxc\/([0-9]+).*/\1/' <<<"${id_line}" | tr -d '"' || true)"
    if [[ -z "${vmid}" || ! "${vmid}" =~ ^[0-9]+$ ]]; then
        return 0
    fi

    if ! sudo pct status "${vmid}" >/dev/null 2>&1; then
        preflight_fail "stale terraform state: ${addr} id references missing vmid=${vmid}"
        cat >&2 <<EOF
ERROR: Terraform state for service '${service}' references a missing LXC (vmid=${vmid}).

This usually means the container was deleted/recreated outside Terraform or you're using the wrong state file.

Remediation options:
  - If the LXC should exist: import it into state (terraform import ...)
  - If the LXC was intentionally deleted: remove it from state, then re-plan/apply:
      terraform -chdir=${TERRAFORM_DIR:-${REPO_ROOT}/terraform} state rm -state=${state_path} ${addr}

Safety note: after state changes, re-run a full plan and review blast radius.
EOF
        return 1
    fi

    return 0
}

resolve_tfvars_relpath() {
    local env="$1"

    local candidates=(
        "environments/${env}.tfvars"
    )

    local candidate
    for candidate in "${candidates[@]}"; do
        if [[ -f "${REPO_ROOT}/terraform/${candidate}" ]]; then
            echo "$candidate"
            return 0
        fi
    done

    return 1
}

resolve_tfvars_path() {
    local env="$1"

    # Prefer an external tfvars location on PVE so we never have to sync
    # environment config (often gitignored) as part of the repo rsync.
    if [[ -n "${TFVARS_PATH:-}" ]]; then
        if [[ -f "${TFVARS_PATH}" ]]; then
            echo "${TFVARS_PATH}"
            return 0
        fi
    fi

    if [[ -n "${TFVARS_DIR:-}" ]]; then
        local ext_candidates=("${TFVARS_DIR}/${env}.tfvars")
        if [[ "$env" == "prod" ]]; then
            ext_candidates+=("${TFVARS_DIR}/prod.tfvars")
        fi

        local ext
        for ext in "${ext_candidates[@]}"; do
            if [[ -f "${ext}" ]]; then
                echo "${ext}"
                return 0
            fi
        done
    fi

    local rel
    if rel="$(resolve_tfvars_relpath "${env}")"; then
        echo "${REPO_ROOT}/terraform/${rel}"
        return 0
    fi

    return 1
}

write_plan_summary() {
    local intent="$1"
    local reason="$2"

    printf '%s\n' "intent=${intent}" >"${EVIDENCE_ROOT}/reports/plan/summary.txt"
    printf '%s\n' "reason=${reason}" >>"${EVIDENCE_ROOT}/reports/plan/summary.txt"
}

enforce_plan_scope_guard() {
    local plan_json="$1"
    local allowlist_path="${SERVICE_SCOPE_ALLOWLIST_PATH:-${SERVICE_SCOPE_ALLOWLIST_PATH_DEFAULT}}"
    local allowed_prefixes_json
    local violations

    if [[ ! -f "${allowlist_path}" ]]; then
        die "Missing service scope allowlist mapping at ${allowlist_path}"
    fi
    if ! command -v jq >/dev/null 2>&1; then
        die "jq is required for scope guard but not available"
    fi

    allowed_prefixes_json="$(jq -c --arg svc "${SERVICE}" '.[$svc] // empty' "${allowlist_path}" 2>/dev/null || true)"
    if [[ -z "${allowed_prefixes_json}" ]]; then
        die "No allowlist entry for service '${SERVICE}' in ${allowlist_path}"
    fi
    if ! jq -e 'type == "array" and length > 0 and all(.[]; type == "string" and length > 0)' >/dev/null 2>&1 <<<"${allowed_prefixes_json}"; then
        die "Invalid allowlist entry for service '${SERVICE}' in ${allowlist_path} (expected non-empty array of strings)"
    fi

    violations="$(
        jq -r --argjson prefixes "${allowed_prefixes_json}" '
          [ .resource_changes[]? | select(.change.actions != ["no-op"]) | .address ]
          | map(select(([$prefixes[] as $p | startswith($p)] | any) | not))
          | .[]
        ' "${plan_json}" 2>/dev/null || true
    )"

    if [[ -n "${violations}" ]]; then
        {
            echo "DENY: Planned changes outside allowed scope"
            echo "allowlist_path=${allowlist_path}"
            echo "allowed_prefixes_json=${allowed_prefixes_json}"
            echo "violations:"
            echo "${violations}" | sed 's/^/  - /'
        } >"${EVIDENCE_ROOT}/reports/plan/scope-guard.txt"
        return 1
    fi

    {
        echo "ALLOW: Planned changes within allowed scope"
        echo "allowlist_path=${allowlist_path}"
        echo "allowed_prefixes_json=${allowed_prefixes_json}"
    } >"${EVIDENCE_ROOT}/reports/plan/scope-guard.txt"
    return 0
}

cmd_plan() {
    parse_common_flags "$@"
    init_evidence_pack

    emit_plan_artifact_placeholders

    ensure_terraform

    if ! set_terraform_dir_for_service "${SERVICE}"; then
        preflight_fail "missing per-service terraform root at terraform/services/${SERVICE}"
        die "Missing per-service Terraform root for service '${SERVICE}' at ${REPO_ROOT}/terraform/services/${SERVICE} (create it to avoid cross-service plans)."
    fi

    on_plan_error() {
        local rc="$1"
        local line="$2"
        local src="${BASH_SOURCE[0]:-unknown}"
        local func="${FUNCNAME[1]:-unknown}"
        write_plan_summary "blocked" "error rc=${rc} at line ${line}"
        {
            echo "source_path=${src}"
            echo "source_file=${src##*/}"
            echo "source_func=${func}"
            echo "source_line=${line}"
        } >>"${EVIDENCE_ROOT}/reports/plan/summary.txt" 2>/dev/null || true
        emit_error "${RUN_ID}" "error rc=${rc} at line ${line}"
        run_offline_verify || true
    }
    trap 'on_plan_error $? $LINENO' ERR

    emit_phase_start "${RUN_ID}" "plan"
    emit_event "inputs" "${RUN_ID}" "environment=${ENVIRONMENT}" "service=${SERVICE}"

    assert_no_target_env || { run_offline_verify || true; return 1; }

    local state_path
    state_path="$(ensure_state_path "${SERVICE}")"
    {
        echo "state_path=${state_path}"
    } >"${EVIDENCE_ROOT}/reports/plan/state.txt"

    local planfile="${EVIDENCE_ROOT}/reports/plan/plan.tfplan"
    local plan_json="${EVIDENCE_ROOT}/reports/plan/plan.json"
    local plan_txt="${EVIDENCE_ROOT}/reports/plan/plan.txt"
    local plan_run_txt="${EVIDENCE_ROOT}/reports/plan/terraform-plan.txt"

    # Ensure we have a dedicated SSH key on PVE to reach freshly provisioned LXCs.
    # We inject the matching public key during Terraform plan/apply.
    local lxc_key_file="${ANSIBLE_LXC_SSH_KEY_FILE:-${HOME}/.ssh/id_lxc_deploy}"
    if [[ ! -f "${lxc_key_file}" ]]; then
        command -v ssh-keygen >/dev/null 2>&1 || die "ssh-keygen not available; cannot create ${lxc_key_file}"
        mkdir -p "$(dirname "${lxc_key_file}")"
        ssh-keygen -t ed25519 -f "${lxc_key_file}" -N '' -C 'ci@pve lxc deploy' >/dev/null
        chmod 600 "${lxc_key_file}" || true
        chmod 644 "${lxc_key_file}.pub" || true
    fi
    if [[ ! -f "${lxc_key_file}.pub" ]]; then
        command -v ssh-keygen >/dev/null 2>&1 || die "ssh-keygen not available; cannot derive ${lxc_key_file}.pub"
        ssh-keygen -y -f "${lxc_key_file}" >"${lxc_key_file}.pub"
        chmod 644 "${lxc_key_file}.pub" || true
    fi
    if [[ "${USE_TFVARS_SSH_KEYS:-}" != "1" ]]; then
        command -v python3 >/dev/null 2>&1 || die "python3 not available; cannot format TF_VAR_ssh_public_keys"
        local lxc_pub
        lxc_pub="$(cat "${lxc_key_file}.pub")"
        TF_VAR_ssh_public_keys="$(python3 -c 'import json,sys; print(json.dumps([sys.argv[1]]))' "${lxc_pub}")"
        export TF_VAR_ssh_public_keys
    fi

    # PROD tfvars automation: provision/validate and emit redacted proof before Terraform.
    if [[ "${ENVIRONMENT}" == "prod" ]]; then
        local tfvars_dir="${TFVARS_DIR:-/var/lib/homelab-proxmox/tfvars}"

        if ! _tfvars_provision_prod_and_write_proof "${EVIDENCE_ROOT}/reports" "${tfvars_dir}"; then
            write_plan_summary "blocked" "prod tfvars provisioning/validation failed"
            emit_error "${RUN_ID}" "prod tfvars provisioning/validation failed"
            run_offline_verify || true
            trap - ERR
            return 1
        fi

        # Prefer the rendered/provisioned PROD tfvars path.
        if [[ -f "${tfvars_dir%/}/prod.tfvars" ]]; then
            TFVARS_PATH="${tfvars_dir%/}/prod.tfvars"
            export TFVARS_PATH
        fi
    fi

    local tfvars_path
    if ! tfvars_path="$(resolve_tfvars_path "${ENVIRONMENT}")"; then
        write_plan_summary "blocked" "missing tfvars file for environment=${ENVIRONMENT}"
        emit_error "${RUN_ID}" "missing tfvars file for environment=${ENVIRONMENT}"
        run_offline_verify
        trap - ERR
        return 1
    fi

    # LAB safety: never allow PROD tfvars for a LAB run.
    if [[ "${ENVIRONMENT}" == "lab" && "${tfvars_path}" == *"/prod.tfvars" ]]; then
        write_plan_summary "blocked" "refusing to use prod.tfvars for lab run"
        emit_error "${RUN_ID}" "refusing to use prod.tfvars for lab run"
        preflight_fail "refusing to use prod.tfvars for lab run"
        run_offline_verify
        trap - ERR
        return 1
    fi

    # Non-sensitive tfvars introspection to aid debugging of credential selection.
    # Do NOT record secrets.
    local tfvars_token_id=""
    local tfvars_api_url=""
    tfvars_token_id="$(awk -F'"' '/^[[:space:]]*proxmox_api_token_id[[:space:]]*=/ {print $2; exit}' "${tfvars_path}" 2>/dev/null || true)"
    tfvars_api_url="$(awk -F'"' '/^[[:space:]]*proxmox_api_url[[:space:]]*=/ {print $2; exit}' "${tfvars_path}" 2>/dev/null || true)"
    {
        echo "environment=${ENVIRONMENT}"
        echo "tfvars_path=${tfvars_path}"
        if [[ "${tfvars_path}" == "${REPO_ROOT}/"* ]]; then
            echo "tfvars_source=repo"
        else
            echo "tfvars_source=external"
        fi

        if [[ -n "${tfvars_api_url}" ]]; then
            echo "proxmox_api_url=${tfvars_api_url}"
        fi
        if [[ -n "${tfvars_token_id}" ]]; then
            echo "proxmox_api_token_id=${tfvars_token_id}"
        fi
    } >"${EVIDENCE_ROOT}/reports/plan/tfvars.txt"

    terraform_chdir init -input=false -no-color
    terraform_chdir validate -no-color
    preflight_ok "terraform init+validate succeeded"

    # Fail early with a clearer message if state references a missing LXC.
    if ! assert_state_lxc_exists_or_empty "${state_path}" "${SERVICE}"; then
        write_plan_summary "blocked" "stale terraform state (missing lxc referenced by state)"
        emit_error "${RUN_ID}" "stale terraform state (missing lxc referenced by state)"
        run_offline_verify || true
        trap - ERR
        return 1
    fi

    # Safety: prevent accidental duplicate service LXCs.
    # If a container named $SERVICE already exists but Terraform doesn't track it,
    # a targeted plan will happily create another one (leading to IP conflicts).
    local existing_ctids=""
    existing_ctids="$(sudo pct list 2>/dev/null | awk -v s="${SERVICE}" 'NR>1 && $4==s {print $1}' | xargs || true)"
    local existing_count=0
    if [[ -n "${existing_ctids}" ]]; then
        existing_count="$(wc -w <<<"${existing_ctids}" | tr -d ' ' 2>/dev/null || echo 0)"
    fi

    local state_addr=""
    state_addr="$(terraform_chdir state list -state="${state_path}" 2>/dev/null | grep -E "^module\.${SERVICE}_lxc\.proxmox_lxc\.this$" | head -n 1 || true)"

    if [[ -z "${state_addr}" && ${existing_count} -gt 0 ]]; then
        die "Found existing LXC(s) named '${SERVICE}' (CTID(s): ${existing_ctids}) but Terraform state does not track it; refusing to create a duplicate. Import it or destroy the stray CT(s)."
    fi
    if [[ -n "${state_addr}" && ${existing_count} -gt 1 ]]; then
        die "Found multiple LXC(s) named '${SERVICE}' (CTID(s): ${existing_ctids}); expected exactly 1. Destroy stray duplicates to avoid IP conflicts."
    fi

    # terraform plan with -detailed-exitcode intentionally returns:
    #   0 = no changes, 2 = changes present
    # Wrap in an `if` to prevent the ERR trap from firing on rc=2.
    local plan_rc=0
    if terraform_chdir plan -input=false -no-color \
        -state="${state_path}" \
        -var-file="${tfvars_path}" \
        -out="${planfile}" \
        -detailed-exitcode \
        >"${plan_run_txt}" 2>&1; then
        plan_rc=0
    else
        plan_rc=$?
    fi

    echo "${plan_rc}" >"${EVIDENCE_ROOT}/reports/plan/exitcode.txt"

    if [[ "${plan_rc}" -eq 1 ]]; then
        # Preserve a readable failure artifact for offline debugging.
        cp "${plan_run_txt}" "${plan_txt}" 2>/dev/null || true

        # Emit stub JSON artifacts so offline verification can still run.
        echo "{}" >"${plan_json}"
        cat >"${EVIDENCE_ROOT}/blast-radius.json" <<EOF
{
    "schema_version": "1.0.0",
    "run_id": "${RUN_ID}",
    "environment": "${ENVIRONMENT}",
    "service": "${SERVICE}",
    "counts": { "create": 0, "update": 0, "replace": 0, "destroy": 0 },
    "resources": [],
    "destructive": false,
    "note": "terraform plan failed; blast radius unavailable"
}
EOF
        write_plan_summary "blocked" "terraform plan failed"
        emit_error "${RUN_ID}" "terraform plan failed"
        run_offline_verify
        trap - ERR
        return 1
    fi

    terraform_chdir show -no-color "${planfile}" >"${plan_txt}"
    terraform_chdir show -json "${planfile}" >"${plan_json}"
    preflight_ok "plan artifacts emitted (reports/plan/plan.txt + reports/plan/plan.json)"

    compute_blast_radius "${plan_json}" || true

    if ! enforce_plan_scope_guard "${plan_json}"; then
        write_plan_summary "blocked" "scope guard violation"
        emit_error "${RUN_ID}" "scope guard violation"
        run_offline_verify
        trap - ERR
        return 1
    fi
    preflight_ok "scope guard passed"

    if ! enforce_bind_mount_policy "${plan_json}"; then
        write_plan_summary "blocked" "bind-mount policy violation"
        emit_error "${RUN_ID}" "bind-mount policy violation"
        run_offline_verify
        trap - ERR
        return 1
    fi
    preflight_ok "bind-mount policy passed"

    local intent="no-op"
    if [[ "${plan_rc}" -eq 2 ]]; then
        # Coarse classification: if there is any create action, call it create; otherwise update.
        if jq -e '.resource_changes[]? | select(.change.actions | index("create"))' "${plan_json}" >/dev/null 2>&1; then
            intent="create"
        else
            intent="update"
        fi
    fi

    write_plan_summary "${intent}" "terraform plan exitcode=${plan_rc}"
    emit_phase_complete "${RUN_ID}" "plan"

    run_offline_verify
    trap - ERR
    return 0
}

cmd_apply() {
    parse_common_flags "$@"

    case "${ENVIRONMENT}" in
        lab)
            ;;
        prod)
            if [[ "${ALLOW_PROD_APPLY:-}" != "1" ]]; then
                die "PROD apply is disabled unless ALLOW_PROD_APPLY=1 is set"
            fi
            if [[ "${CONFIRM}" != "${PROD_CONFIRM_STRING}" ]]; then
                die "PROD apply requires --confirm '${PROD_CONFIRM_STRING}'"
            fi
            ;;
        *)
            die "Invalid --environment '${ENVIRONMENT}' (expected lab|prod)"
            ;;
    esac

    init_evidence_pack

    emit_plan_artifact_placeholders

    ensure_terraform

    if ! set_terraform_dir_for_service "${SERVICE}"; then
        preflight_fail "missing per-service terraform root at terraform/services/${SERVICE}"
        die "Missing per-service Terraform root for service '${SERVICE}' at ${REPO_ROOT}/terraform/services/${SERVICE} (create it to avoid cross-service plans)."
    fi

    assert_no_target_env || { run_offline_verify || true; return 1; }

    # PROD tfvars automation: provision/validate and emit redacted proof before Terraform.
    if [[ "${ENVIRONMENT}" == "prod" ]]; then
        local tfvars_dir="${TFVARS_DIR:-/var/lib/homelab-proxmox/tfvars}"

        if ! _tfvars_provision_prod_and_write_proof "${EVIDENCE_ROOT}/reports" "${tfvars_dir}"; then
            emit_error "${RUN_ID}" "prod tfvars provisioning/validation failed"
            run_offline_verify || true
            return 1
        fi

        if [[ -f "${tfvars_dir%/}/prod.tfvars" ]]; then
            TFVARS_PATH="${tfvars_dir%/}/prod.tfvars"
            export TFVARS_PATH
        fi
    fi

    # Ansible consumes vault secrets via a password file.
    # GitHub Actions passes secrets most conveniently as an env var, so bridge it.
    local vault_pw_file=""
    if [[ -n "${ANSIBLE_VAULT_PASSWORD:-}" && -z "${ANSIBLE_VAULT_PASSWORD_FILE:-}" ]]; then
        vault_pw_file="$(mktemp -t ansible-vault.XXXXXX)"
        chmod 600 "${vault_pw_file}"
        printf '%s' "${ANSIBLE_VAULT_PASSWORD}" >"${vault_pw_file}"
        export ANSIBLE_VAULT_PASSWORD_FILE="${vault_pw_file}"
        unset ANSIBLE_VAULT_PASSWORD
    fi

    # If no vault secret was provided by the caller, prefer a persistent password
    # file on PVE (keeps secrets out of GitHub Actions).
    if [[ -z "${ANSIBLE_VAULT_PASSWORD_FILE:-}" ]]; then
        local pve_vault_pw_file_default="${PVE_VAULT_PASSWORD_FILE:-/var/lib/homelab-proxmox/vault/.ansible_vault_pass}"
        if [[ -f "${pve_vault_pw_file_default}" ]]; then
            export ANSIBLE_VAULT_PASSWORD_FILE="${pve_vault_pw_file_default}"
        fi
    fi

    # Optional: support vault-id formatted vault files while still using a single password.
    # If your vault files include a vault-id (e.g. $ANSIBLE_VAULT;...;AES256;homelab),
    # Ansible needs an identity list mapping that vault-id to the password file.
    if [[ -n "${ANSIBLE_VAULT_PASSWORD_FILE:-}" && -z "${ANSIBLE_VAULT_IDENTITY_LIST:-}" ]]; then
        local vault_id_default="homelab"
        if [[ -n "${ENVIRONMENT:-}" ]]; then
            vault_id_default="${ENVIRONMENT}"
        fi
        local vault_id="${VAULT_ID:-${vault_id_default}}"
        export ANSIBLE_VAULT_IDENTITY_LIST="${vault_id}@${ANSIBLE_VAULT_PASSWORD_FILE}"
    fi

    # Tracks any repo-local symlinks created for vault files so we can clean them
    # up on error/success. Must be declared before the ERR trap (set -u).
    local -a linked_vault_files=()

    on_apply_error() {
        local rc="$1"
        local line="$2"
        local src="${BASH_SOURCE[0]:-unknown}"
        local func="${FUNCNAME[1]:-unknown}"
        {
            echo "status=failure"
            echo "reason=error rc=${rc} at line ${line}"
            echo "source_path=${src}"
            echo "source_file=${src##*/}"
            echo "source_func=${func}"
            echo "source_line=${line}"
        } >"${EVIDENCE_ROOT}/reports/apply/summary.txt" 2>/dev/null || true
        emit_error "${RUN_ID}" "error rc=${rc} at line ${line}"
        run_offline_verify || true
        if [[ -n "${vault_pw_file}" ]]; then
            rm -f "${vault_pw_file}" || true
        fi
        if [[ ${#linked_vault_files[@]} -gt 0 ]]; then
            rm -f "${linked_vault_files[@]}" || true
        fi
    }
    trap 'on_apply_error $? $LINENO' ERR

    mkdir -p "${EVIDENCE_ROOT}/reports/plan"
    mkdir -p "${EVIDENCE_ROOT}/reports/apply"
    mkdir -p "${EVIDENCE_ROOT}/reports/healthcheck"

    # Ensure any Ansible Galaxy dependencies (roles/collections) are present on PVE.
    # This is required for services like AdGuard which use geerlingguy.docker and community.docker.
    ensure_ansible_galaxy_requirements

    emit_phase_start "${RUN_ID}" "apply"
    emit_event "inputs" "${RUN_ID}" "environment=${ENVIRONMENT}" "service=${SERVICE}"

    local state_path
    state_path="$(ensure_state_path "${SERVICE}")"
    {
        echo "state_path=${state_path}"
    } >"${EVIDENCE_ROOT}/reports/plan/state.txt"

    # Service existence is validated by requiring a per-service Terraform root.

    local tfvars_path
    if ! tfvars_path="$(resolve_tfvars_path "${ENVIRONMENT}")"; then
        {
            echo "status=failure"
            echo "reason=missing tfvars file for environment=${ENVIRONMENT}"
        } >"${EVIDENCE_ROOT}/reports/apply/summary.txt"
        emit_error "${RUN_ID}" "missing tfvars file for environment=${ENVIRONMENT}"
        run_offline_verify
        trap - ERR
        return 1
    fi

    # Non-sensitive tfvars introspection to aid debugging of credential selection.
    # Do NOT record secrets.
    local tfvars_token_id=""
    local tfvars_api_url=""
    tfvars_token_id="$(awk -F'"' '/^[[:space:]]*proxmox_api_token_id[[:space:]]*=/ {print $2; exit}' "${tfvars_path}" 2>/dev/null || true)"
    tfvars_api_url="$(awk -F'"' '/^[[:space:]]*proxmox_api_url[[:space:]]*=/ {print $2; exit}' "${tfvars_path}" 2>/dev/null || true)"
    {
        echo "environment=${ENVIRONMENT}"
        echo "tfvars_path=${tfvars_path}"
        if [[ "${tfvars_path}" == "${REPO_ROOT}/"* ]]; then
            echo "tfvars_source=repo"
        else
            echo "tfvars_source=external"
        fi

        if [[ -n "${tfvars_api_url}" ]]; then
            echo "proxmox_api_url=${tfvars_api_url}"
        fi
        if [[ -n "${tfvars_token_id}" ]]; then
            echo "proxmox_api_token_id=${tfvars_token_id}"
        fi
    } >"${EVIDENCE_ROOT}/reports/plan/tfvars.txt"

    local planfile="${EVIDENCE_ROOT}/reports/plan/plan.tfplan"
    local plan_json="${EVIDENCE_ROOT}/reports/plan/plan.json"
    local plan_txt="${EVIDENCE_ROOT}/reports/plan/plan.txt"

    # Ensure we have a dedicated SSH key on PVE to reach freshly provisioned LXCs.
    # We inject the matching public key during Terraform plan/apply.
    local lxc_key_file="${ANSIBLE_LXC_SSH_KEY_FILE:-${HOME}/.ssh/id_lxc_deploy}"
    if [[ ! -f "${lxc_key_file}" ]]; then
        command -v ssh-keygen >/dev/null 2>&1 || die "ssh-keygen not available; cannot create ${lxc_key_file}"
        mkdir -p "$(dirname "${lxc_key_file}")"
        ssh-keygen -t ed25519 -f "${lxc_key_file}" -N '' -C 'ci@pve lxc deploy' >/dev/null
        chmod 600 "${lxc_key_file}" || true
        chmod 644 "${lxc_key_file}.pub" || true
    fi
    if [[ ! -f "${lxc_key_file}.pub" ]]; then
        command -v ssh-keygen >/dev/null 2>&1 || die "ssh-keygen not available; cannot derive ${lxc_key_file}.pub"
        ssh-keygen -y -f "${lxc_key_file}" >"${lxc_key_file}.pub"
        chmod 644 "${lxc_key_file}.pub" || true
    fi
    if [[ "${USE_TFVARS_SSH_KEYS:-}" != "1" ]]; then
        command -v python3 >/dev/null 2>&1 || die "python3 not available; cannot format TF_VAR_ssh_public_keys"
        local lxc_pub
        lxc_pub="$(cat "${lxc_key_file}.pub")"
        TF_VAR_ssh_public_keys="$(python3 -c 'import json,sys; print(json.dumps([sys.argv[1]]))' "${lxc_pub}")"
        export TF_VAR_ssh_public_keys
    fi

    terraform_chdir init -input=false -no-color
    terraform_chdir validate -no-color

    local plan_source_run_id="${FROM_PLAN_RUN_ID:-}"
    local plan_source_sha256=""

    # terraform plan with -detailed-exitcode intentionally returns:
    #   0 = no changes, 2 = changes present
    # Wrap in an `if` to prevent the ERR trap from firing on rc=2.
    local plan_rc=0
    if [[ -n "${plan_source_run_id}" ]]; then
        local plan_source_root
        plan_source_root="$(artifact_run_path "${plan_source_run_id}")"

        if [[ ! -d "${plan_source_root}" ]]; then
            {
                echo "status=failure"
                echo "reason=missing plan evidence directory for plan_source_run_id=${plan_source_run_id}"
                echo "hint=verify Plan(PROD) completed and artifacts remain on PVE"
            } >"${EVIDENCE_ROOT}/reports/apply/summary.txt" 2>/dev/null || true
            emit_error "${RUN_ID}" "missing plan evidence directory for plan_source_run_id=${plan_source_run_id}"
            run_offline_verify || true
            trap - ERR
            return 1
        fi

        local plan_source_prov="${plan_source_root}/provenance.json"
        if [[ ! -f "${plan_source_prov}" ]]; then
            {
                echo "status=failure"
                echo "reason=missing provenance.json for plan_source_run_id=${plan_source_run_id}"
                echo "hint=verify the plan run produced a complete evidence pack"
            } >"${EVIDENCE_ROOT}/reports/apply/summary.txt" 2>/dev/null || true
            emit_error "${RUN_ID}" "missing provenance.json for plan_source_run_id=${plan_source_run_id}"
            run_offline_verify || true
            trap - ERR
            return 1
        fi

        local src_env=""
        local src_service=""
        src_env="$(jq -r '.environment // empty' "${plan_source_prov}" 2>/dev/null || true)"
        src_service="$(jq -r '.service // empty' "${plan_source_prov}" 2>/dev/null || true)"
        if [[ -z "${src_env}" || -z "${src_service}" || "${src_env}" != "${ENVIRONMENT}" || "${src_service}" != "${SERVICE}" ]]; then
            {
                echo "status=failure"
                echo "reason=plan metadata mismatch for plan_source_run_id=${plan_source_run_id}"
                echo "expected=environment=${ENVIRONMENT} service=${SERVICE}"
                echo "actual=environment=${src_env:-missing} service=${src_service:-missing}"
            } >"${EVIDENCE_ROOT}/reports/apply/summary.txt" 2>/dev/null || true
            emit_error "${RUN_ID}" "plan metadata mismatch for plan_source_run_id=${plan_source_run_id}"
            run_offline_verify || true
            trap - ERR
            return 1
        fi

        local plan_source_planfile="${plan_source_root}/reports/plan/plan.tfplan"
        if [[ ! -f "${plan_source_planfile}" ]]; then
            {
                echo "status=failure"
                echo "reason=missing planfile at reports/plan/plan.tfplan for plan_source_run_id=${plan_source_run_id}"
                echo "hint=ensure Plan(PROD) uploaded full evidence pack including plan.tfplan"
            } >"${EVIDENCE_ROOT}/reports/apply/summary.txt" 2>/dev/null || true
            emit_error "${RUN_ID}" "missing planfile for plan_source_run_id=${plan_source_run_id}"
            run_offline_verify || true
            trap - ERR
            return 1
        fi

        plan_source_sha256="$(sha256_file "${plan_source_planfile}" 2>/dev/null || true)"

        # Materialize plan artifacts into this apply run's evidence pack so
        # verification remains self-contained.
        cp "${plan_source_planfile}" "${planfile}"

        local plan_source_exitcode="${plan_source_root}/reports/plan/exitcode.txt"
        if [[ -f "${plan_source_exitcode}" ]]; then
            plan_rc="$(tr -d '\r\n' <"${plan_source_exitcode}" | head -c 16)"
        else
            plan_rc=0
        fi

        local plan_source_plan_json="${plan_source_root}/reports/plan/plan.json"
        local plan_source_plan_txt="${plan_source_root}/reports/plan/plan.txt"
        if [[ -f "${plan_source_plan_txt}" ]]; then
            cp "${plan_source_plan_txt}" "${plan_txt}" 2>/dev/null || true
        else
            terraform_chdir show -no-color "${planfile}" >"${plan_txt}"
        fi
        if [[ -f "${plan_source_plan_json}" ]]; then
            cp "${plan_source_plan_json}" "${plan_json}" 2>/dev/null || true
        else
            terraform_chdir show -json "${planfile}" >"${plan_json}"
        fi

        preflight_ok "using saved planfile from run_id=${plan_source_run_id}"

        {
            echo "plan_source_run_id=${plan_source_run_id}"
            echo "plan_source_path=${plan_source_root}"
            if [[ -n "${plan_source_sha256}" ]]; then
                echo "plan_sha256=${plan_source_sha256}"
            fi
        } >"${EVIDENCE_ROOT}/reports/apply/plan-provenance.txt" 2>/dev/null || true

        if [[ -n "${plan_source_sha256}" ]]; then
            local prov_tmp="${EVIDENCE_ROOT}/provenance.json.tmp"
            jq --arg plan_source_run_id "${plan_source_run_id}" \
               --arg plan_sha256 "${plan_source_sha256}" \
               '. + {plan_source_run_id: $plan_source_run_id, plan_sha256: $plan_sha256}' \
               "${EVIDENCE_ROOT}/provenance.json" >"${prov_tmp}"
            mv -f "${prov_tmp}" "${EVIDENCE_ROOT}/provenance.json"
        fi
    else
        if terraform_chdir plan -input=false -no-color \
            -state="${state_path}" \
            -var-file="${tfvars_path}" \
            -out="${planfile}" \
            -detailed-exitcode; then
            plan_rc=0
        else
            plan_rc=$?
        fi

        terraform_chdir show -no-color "${planfile}" >"${plan_txt}"
        terraform_chdir show -json "${planfile}" >"${plan_json}"
        preflight_ok "plan artifacts emitted (reports/plan/plan.txt + reports/plan/plan.json)"
    fi
    echo "${plan_rc}" >"${EVIDENCE_ROOT}/reports/plan/exitcode.txt"

    if [[ "${plan_rc}" -eq 1 ]]; then
        {
            echo "status=failure"
            echo "reason=terraform plan failed"
        } >"${EVIDENCE_ROOT}/reports/apply/summary.txt"
        emit_error "${RUN_ID}" "terraform plan failed"
        run_offline_verify
        trap - ERR
        return 1
    fi

    compute_blast_radius "${plan_json}" || true

    if ! enforce_plan_scope_guard "${plan_json}"; then
        {
            echo "status=failure"
            echo "reason=scope guard violation"
        } >"${EVIDENCE_ROOT}/reports/apply/summary.txt"
        emit_error "${RUN_ID}" "scope guard violation"
        run_offline_verify
        trap - ERR
        return 1
    fi
    preflight_ok "scope guard passed"

    if ! enforce_bind_mount_policy "${plan_json}"; then
        {
            echo "status=failure"
            echo "reason=bind-mount policy violation"
        } >"${EVIDENCE_ROOT}/reports/apply/summary.txt"
        emit_error "${RUN_ID}" "bind-mount policy violation"
        run_offline_verify
        trap - ERR
        return 1
    fi
    preflight_ok "bind-mount policy passed"

    # Apply exactly the reviewed plan
    terraform_chdir apply -input=false -no-color -auto-approve \
        -state="${state_path}" \
        "${planfile}" \
        | tee "${EVIDENCE_ROOT}/reports/apply/terraform-apply.txt"

    # Backup state to Synology after successful apply.
    # Proof is captured into evidence to satisfy SD-002.
    #
    # In PROD this is mandatory and failures must fail the run.
    # In LAB we record the failure but do not fail the apply, since LAB hosts
    # may not have the Synology mount available.
    if "${REPO_ROOT}/scripts/backup_tfstate.sh" --state-path "${state_path}" --prefix "${ENVIRONMENT}-${SERVICE}" \
        >"${EVIDENCE_ROOT}/reports/apply/state-backup.txt" 2>&1; then
        preflight_ok "state backup succeeded"
    else
        if [[ "${ENVIRONMENT}" == "prod" ]]; then
            preflight_fail "state backup failed"
            {
                echo "status=failure"
                echo "reason=state backup failed"
                echo "hint=see reports/apply/state-backup.txt"
            } >"${EVIDENCE_ROOT}/reports/apply/summary.txt" 2>/dev/null || true
            emit_error "${RUN_ID}" "state backup failed"
            run_offline_verify
            trap - ERR
            return 1
        fi

        preflight_fail "state backup failed (lab non-fatal)"
    fi

    # LAB idempotency verification: a second plan must be a no-op.
    if [[ "${ENVIRONMENT}" == "lab" ]]; then
        local idem_planfile="${EVIDENCE_ROOT}/reports/apply/idempotency.tfplan"
        local idem_txt="${EVIDENCE_ROOT}/reports/apply/idempotency-plan.txt"
        local idem_rc=0

        if terraform_chdir plan -input=false -no-color \
            -state="${state_path}" \
            -var-file="${tfvars_path}" \
            -out="${idem_planfile}" \
            -detailed-exitcode; then
            idem_rc=0
        else
            idem_rc=$?
        fi

        echo "${idem_rc}" >"${EVIDENCE_ROOT}/reports/apply/idempotency-exitcode.txt"

        if [[ "${idem_rc}" -eq 2 ]]; then
            terraform_chdir show -no-color "${idem_planfile}" >"${idem_txt}" || true
            {
                echo "status=failure"
                echo "reason=idempotency check failed: second plan had changes"
            } >"${EVIDENCE_ROOT}/reports/apply/summary.txt"
            emit_error "${RUN_ID}" "idempotency check failed (second plan had changes)"
            run_offline_verify
            trap - ERR
            return 1
        fi
    fi

    # Prefer root output when present, else fall back to module output from state.
    local ansible_inventory_json=""
    local inventory_rc=0
    if ansible_inventory_json="$(terraform_chdir output -json -state="${state_path}" ansible_inventory 2>/dev/null)"; then
        inventory_rc=0
    else
        inventory_rc=$?
    fi

    if [[ ${inventory_rc} -ne 0 || -z "${ansible_inventory_json}" ]]; then
        # Prefer `terraform state pull` here: it works even when root outputs were not
        # updated due to resource targeting. Capture stderr into evidence so failures
        # are diagnosable without leaking full state into the pack.
        local state_pull_stderr="${EVIDENCE_ROOT}/reports/apply/terraform-state-pull.stderr.txt"
        local state_json=""
        local state_rc=0
        if state_json="$(terraform_chdir state pull -state="${state_path}" 2>"${state_pull_stderr}")"; then
            state_rc=0
        else
            state_rc=$?
        fi

        if [[ ${state_rc} -ne 0 || -z "${state_json}" ]]; then
            die "terraform state pull failed (rc=${state_rc}) or returned empty output; see ${state_pull_stderr}"
        fi

        local inv_from_state_stderr="${EVIDENCE_ROOT}/reports/apply/ansible-inventory-from-state.stderr.txt"
        local inv_from_state_rc=0
        if ! ansible_inventory_json="$(printf '%s' "${state_json}" | SERVICE="${SERVICE}" python3 -c '
import json
import os
import sys

service = os.environ.get("SERVICE")
if not service:
    print("Missing SERVICE env", file=sys.stderr)
    sys.exit(2)

raw = sys.stdin.read()
if not raw.strip():
    print("terraform state pull produced empty stdout", file=sys.stderr)
    sys.exit(4)

try:
    doc = json.loads(raw)
except json.JSONDecodeError:
    print("terraform state pull did not return valid JSON", file=sys.stderr)
    sys.exit(5)

module_addr = f"module.{service}_lxc"

# terraform state pull format (v4): look for the proxmox_lxc resource and grab network[0].ip
for res in doc.get("resources") or []:
    if res.get("module") != module_addr:
        continue
    if res.get("type") != "proxmox_lxc" or res.get("name") != "this":
        continue
    for inst in res.get("instances") or []:
        attrs = inst.get("attributes") or {}
        net = (attrs.get("network") or [])
        if net and isinstance(net, list):
            ip = (net[0] or {}).get("ip")
            if ip:
                print(json.dumps({"services": {service: ip}}, sort_keys=True))
                sys.exit(0)

print(f"Could not find proxmox_lxc network ip in state for module={module_addr}", file=sys.stderr)
sys.exit(3)
')" 2>"${inv_from_state_stderr}"; then
            inv_from_state_rc=$?
        fi

        if [[ ${inv_from_state_rc} -ne 0 || -z "${ansible_inventory_json}" ]]; then
            {
                echo "status=failure"
                echo "reason=failed to derive ansible inventory from terraform state"
                echo "hint=see reports/apply/terraform-state-pull.stderr.txt and reports/apply/ansible-inventory-from-state.stderr.txt"
                echo "inventory_from_state_rc=${inv_from_state_rc}"
            } >"${EVIDENCE_ROOT}/reports/apply/summary.txt" 2>/dev/null || true
            emit_error "${RUN_ID}" "failed to derive ansible inventory from terraform state"
            run_offline_verify
            trap - ERR
            return 1
        fi
    fi

    printf '%s\n' "${ansible_inventory_json}" >"${EVIDENCE_ROOT}/reports/apply/ansible-inventory.json"

    # From here on, ensure we run from repo root so relative paths resolve
    # correctly in helper scripts and ansible.cfg.
    pushd "${REPO_ROOT}" >/dev/null

    # Vault files are intentionally gitignored in this repo. In CI, they must be
    # sourced from a persistent location on PVE.
    #
    # Convention: store encrypted vault files under /var/lib/homelab-proxmox/vault,
    # mirroring ansible's group_vars layout:
    #   /var/lib/homelab-proxmox/vault/group_vars/all/vault.yml
    #   /var/lib/homelab-proxmox/vault/group_vars/<group>/vault.yml
    local vault_source_root="${VAULT_SOURCE_ROOT:-/var/lib/homelab-proxmox/vault}"
    # Optional safety: if per-environment vault directories exist on PVE, prefer them.
    # This reduces the risk of accidentally reusing PROD secrets in LAB (or vice versa).
    # Layout:
    #   /var/lib/homelab-proxmox/vault/lab/group_vars/...
    #   /var/lib/homelab-proxmox/vault/prod/group_vars/...
    if [[ -z "${VAULT_SOURCE_ROOT:-}" && -n "${ENVIRONMENT:-}" ]]; then
        local env_vault_root="${vault_source_root}/${ENVIRONMENT}"
        if [[ -d "${env_vault_root}" ]]; then
            vault_source_root="${env_vault_root}"
        fi
    fi
    # linked_vault_files is declared earlier so traps can safely clean up.
    link_vault_file_if_needed() {
        local rel="$1"                     # e.g. ansible/group_vars/all/vault.yml
        local dest="${REPO_ROOT}/${rel}"

        if [[ -f "${dest}" ]]; then
            return 0
        fi

        local alt_rel="${rel#ansible/}"    # e.g. group_vars/all/vault.yml
        local cand1="${vault_source_root}/${rel}"
        local cand2="${vault_source_root}/${alt_rel}"
        local src=""
        if [[ -f "${cand1}" ]]; then
            src="${cand1}"
        elif [[ -f "${cand2}" ]]; then
            src="${cand2}"
        fi

        if [[ -z "${src}" ]]; then
            return 0
        fi

        mkdir -p "$(dirname "${dest}")"
        ln -sf "${src}" "${dest}"
        linked_vault_files+=("${dest}")
        return 0
    }

    # Vault-encrypted files are intentionally gitignored, so CI sources them from PVE.
    # NOTE: even if a secret is not used by a given service, Ansible may still need to
    # decrypt group_vars files for groups present in the generated inventory.
    link_vault_file_if_needed "ansible/group_vars/all/vault.yml"
    link_vault_file_if_needed "ansible/group_vars/services/secrets.yml"

    # Fail fast with a clear error if the vault password cannot decrypt the expected vault.
    # This avoids confusing downstream failures during inventory parsing or playbook execution.
    local expected_vault_file="${REPO_ROOT}/ansible/group_vars/all/vault.yml"
    if [[ -f "${expected_vault_file}" ]]; then
        # If the repo (or linked PVE vault) contains an encrypted vault file but we
        # have no secret configured, fail early with actionable guidance.
        if head -n 1 "${expected_vault_file}" 2>/dev/null | grep -q '^\$ANSIBLE_VAULT' && [[ -z "${ANSIBLE_VAULT_PASSWORD_FILE:-}" ]]; then
            {
                echo "Vault secret required but not configured."
                echo "This run encountered an Ansible vault-encrypted file: ${expected_vault_file}"
                echo "Provide one of:"
                echo "  - ANSIBLE_VAULT_PASSWORD (env), or"
                echo "  - ANSIBLE_VAULT_PASSWORD_FILE (path), or"
                echo "  - Create a persistent PVE vault password file at: /var/lib/homelab-proxmox/vault/.ansible_vault_pass (mode 0600, owned by ci)"
                echo "Note: do not print the password in logs."
            } >"${EVIDENCE_ROOT}/reports/apply/vault-check.stderr.txt"
            echo "vault_check_rc=2" >"${EVIDENCE_ROOT}/reports/apply/vault-check.txt"
            die "ansible vault password missing; see reports/apply/vault-check.stderr.txt"
        fi
    fi

    if [[ -n "${ANSIBLE_VAULT_PASSWORD_FILE:-}" ]]; then
        if [[ ! -f "${ANSIBLE_VAULT_PASSWORD_FILE}" ]]; then
            die "ANSIBLE_VAULT_PASSWORD_FILE is set but does not exist: ${ANSIBLE_VAULT_PASSWORD_FILE}"
        fi

        if [[ ! -f "${expected_vault_file}" ]]; then
            {
                echo "Missing expected vault file: ${expected_vault_file}"
                echo "This repo intentionally gitignores vault.yml, so CI must source it from PVE."
                echo "Create an encrypted vault file on PVE, e.g.:"
                echo "  sudo mkdir -p ${vault_source_root}/group_vars/all"
                echo "  sudo chown -R ci:ci ${vault_source_root}"
                echo "  cp <your-local-repo>/ansible/group_vars/all/vault.yml ${vault_source_root}/group_vars/all/vault.yml"
                echo "Or set VAULT_SOURCE_ROOT to a different directory."
            } >"${EVIDENCE_ROOT}/reports/apply/vault-check.stderr.txt"
            echo "vault_check_rc=2" >"${EVIDENCE_ROOT}/reports/apply/vault-check.txt"
            die "missing required ansible vault file; see reports/apply/vault-check.stderr.txt"
        fi

        local vault_check_rc=0
        if ansible-vault view "${expected_vault_file}" \
            >"/dev/null" \
            2>"${EVIDENCE_ROOT}/reports/apply/vault-check.stderr.txt"; then
            vault_check_rc=0
        else
            vault_check_rc=$?
        fi

        echo "vault_check_rc=${vault_check_rc}" >"${EVIDENCE_ROOT}/reports/apply/vault-check.txt"
        if [[ ${vault_check_rc} -ne 0 ]]; then
            die "vault password could not decrypt ansible/group_vars/all/vault.yml (rc=${vault_check_rc}); see reports/apply/vault-check.stderr.txt"
        fi
    fi

    # Generate ansible/inventories/generated/hosts.yml
    ANSIBLE_INVENTORY_JSON="${ansible_inventory_json}" \
        ANSIBLE_SSH_PRIVATE_KEY_FILE="${lxc_key_file}" \
        ./scripts/update_ansible_inventory.sh \
        >"${EVIDENCE_ROOT}/reports/apply/update-inventory.txt" 2>&1

    # Wait for SSH to come up on the newly created/started LXC.
    # The Proxmox provider can return before sshd is ready, causing flaky bootstrap.
    local service_ip
    service_ip="$(printf '%s' "${ansible_inventory_json}" | python3 -c 'import json,sys; d=json.load(sys.stdin); (svc,)=list(d.get("services",{}).keys()); ip=d["services"][svc].split("/")[0]; print(ip)')"
    if [[ -z "${service_ip}" ]]; then
        die "could not resolve service IP from ansible inventory json"
    fi

    # Clear stale host key to avoid MAN-IN-THE-MIDDLE prompts when the CT is recreated.
    ssh-keygen -f "${HOME}/.ssh/known_hosts" -R "${service_ip}" >/dev/null 2>&1 || true

    # Ensure Ansible uses consistent, non-interactive SSH settings. In lab we deliberately
    # avoid failing on host key changes because LXCs can be recreated while keeping the
    # same IP, which otherwise bricks CI with known_hosts mismatches.
    local ssh_common_args
    ssh_common_args="${ANSIBLE_SSH_COMMON_ARGS:--o BatchMode=yes -o ConnectTimeout=5 -o StrictHostKeyChecking=no -o CheckHostIP=no -o UserKnownHostsFile=/dev/null -o GlobalKnownHostsFile=/dev/null}"

    local ssh_wait_seconds="${SSH_WAIT_SECONDS:-300}"
    local ssh_sleep_seconds="${SSH_WAIT_SLEEP_SECONDS:-5}"
    local waited=0
    local attempt=1
    echo "[ssh-wait] waiting for ssh on ${service_ip} (timeout=${ssh_wait_seconds}s, step=${ssh_sleep_seconds}s)"
    while true; do
        if ssh -i "${lxc_key_file}" \
            ${ssh_common_args} \
            "root@${service_ip}" 'true' >/dev/null 2>&1; then
            echo "[ssh-wait] success after ${waited}s (attempt=${attempt})"
            break
        fi
        echo "[ssh-wait] attempt=${attempt} waited=${waited}s"
        if (( waited >= ssh_wait_seconds )); then
            die "ssh not ready on ${service_ip} after ${ssh_wait_seconds}s"
        fi
        sleep "${ssh_sleep_seconds}"
        waited=$((waited + ssh_sleep_seconds))
        attempt=$((attempt + 1))
    done

    # DNS sanity: Proxmox may set CT nameserver in config, but the container's
    # /etc/resolv.conf might not reflect it until a reboot. If DNS is wrong,
    # bootstrap's apt-get will fail.
    local ctid=""
    local state_addr=""
    local tf_id=""

    local ctid_report="${EVIDENCE_ROOT}/reports/apply/ctid-discovery.txt"
    local ctid_stderr="${EVIDENCE_ROOT}/reports/apply/ctid-discovery.stderr.txt"
    : >"${ctid_stderr}"

    local state_list_output=""
    state_list_output="$(terraform_chdir state list -state="${state_path}" 2>>"${ctid_stderr}" || true)"

    # Most services follow: module.<service>_lxc.proxmox_lxc.this
    # Some terraform addresses can include an index suffix, so accept that too.
    state_addr="$(printf '%s\n' "${state_list_output}" | grep -E "^module\\.${SERVICE}_lxc\\.proxmox_lxc\\.this(\\[[0-9]+\\])?$" | head -n 1 || true)"

    # Fallback: if no match, but exactly one proxmox_lxc.this exists in state, use it.
    if [[ -z "${state_addr}" ]]; then
        local lxc_addrs=""
        lxc_addrs="$(printf '%s\n' "${state_list_output}" | grep -E "proxmox_lxc\\.this(\\[[0-9]+\\])?$" || true)"
        if [[ "$(printf '%s\n' "${lxc_addrs}" | sed '/^$/d' | wc -l | tr -d ' ')" == "1" ]]; then
            state_addr="$(printf '%s\n' "${lxc_addrs}" | head -n 1)"
        fi
    fi

    local id_raw=""
    local vmid_raw=""
    if [[ -n "${state_addr}" ]]; then
        local state_show_output=""
        state_show_output="$(terraform_chdir state show -no-color -state="${state_path}" "${state_addr}" 2>>"${ctid_stderr}" || true)"

        # Terraform state output may render values with or without quotes.
        id_raw="$(printf '%s\n' "${state_show_output}" | awk -F= '/^[[:space:]]*id[[:space:]]*=/{sub(/^[^=]*=\s*/,"",$0); gsub(/"/,"",$0); print $0; exit}' || true)"
        vmid_raw="$(printf '%s\n' "${state_show_output}" | awk -F= '/^[[:space:]]*vmid[[:space:]]*=/{sub(/^[^=]*=\s*/,"",$0); gsub(/"/,"",$0); print $0; exit}' || true)"

        if [[ -n "${id_raw}" ]]; then
            tf_id="${id_raw}"
        elif [[ -n "${vmid_raw}" ]]; then
            tf_id="${vmid_raw}"
        else
            tf_id=""
        fi

        if [[ -n "${tf_id}" ]]; then
            # id formats seen: 104, "104", pve/lxc/104
            ctid="$(printf '%s' "${tf_id}" | awk -F/ '{print $NF}')"
        fi
    fi

    {
        echo "state_path=${state_path}"
        echo "state_addr=${state_addr}"
        echo "tf_id=${tf_id}"
        echo "id_raw=${id_raw}"
        echo "vmid_raw=${vmid_raw}"
        echo "ctid=${ctid}"
        echo "--- terraform state list ---"
        printf '%s\n' "${state_list_output}"
    } >"${ctid_report}"

    if [[ -n "${ctid}" ]]; then
        local dns_report="${EVIDENCE_ROOT}/reports/apply/dns-check.txt"
        local dns_stderr="${EVIDENCE_ROOT}/reports/apply/dns-check.stderr.txt"
        local configured_nameserver=""
        configured_nameserver="$(sudo pct config "${ctid}" 2>"${dns_stderr}" | awk '/^nameserver:/ {print $2; exit}' || true)"

        {
            echo "ctid=${ctid}"
            echo "configured_nameserver=${configured_nameserver:-}" 
        } >"${dns_report}"

        if [[ -n "${configured_nameserver}" ]]; then
            local attempt=1
            while [[ ${attempt} -le 2 ]]; do
                local resolv_contents=""
                resolv_contents="$(sudo pct exec "${ctid}" -- cat /etc/resolv.conf 2>>"${dns_stderr}" || true)"
                {
                    echo "--- resolv.conf (attempt ${attempt}) ---"
                    printf '%s\n' "${resolv_contents}"
                } >>"${dns_report}"

                if printf '%s\n' "${resolv_contents}" | grep -q "^nameserver ${configured_nameserver}$"; then
                    echo "dns_status=ok" >>"${dns_report}"
                    break
                fi

                echo "dns_status=mismatch" >>"${dns_report}"
                if [[ ${attempt} -eq 1 ]]; then
                    echo "action=reboot" >>"${dns_report}"
                    sudo pct reboot "${ctid}" >>"${dns_report}" 2>>"${dns_stderr}" || true

                    # After reboot, wait for SSH again.
                    waited=0
                    while true; do
                        if ssh -i "${lxc_key_file}" \
                            ${ssh_common_args} \
                            "root@${service_ip}" 'true' >/dev/null 2>&1; then
                            break
                        fi
                        echo "[ssh-wait-reboot] attempt=${attempt} waited=${waited}s"
                        if (( waited >= ssh_wait_seconds )); then
                            die "ssh not ready on ${service_ip} after reboot (${ssh_wait_seconds}s)"
                        fi
                        sleep "${ssh_sleep_seconds}"
                        waited=$((waited + ssh_sleep_seconds))
                        attempt=$((attempt + 1))
                    done
                fi

                attempt=$((attempt + 1))
            done
        fi
    fi

    # Proxmox API tokens cannot change certain feature flags (e.g., mount=nfs) unless
    # authenticated as root@pam. To keep least-privilege (no root SSH) while still
    # enabling in-guest NFS mounts, set the feature via local sudo+pct and record proof.
    if [[ -n "${ctid}" ]]; then
        local features_report="${EVIDENCE_ROOT}/reports/apply/lxc-features.txt"
        local features_stderr="${EVIDENCE_ROOT}/reports/apply/lxc-features.stderr.txt"
        local had_mount_nfs_before=0
        local had_mount_nfs_after=0

        {
            echo "ctid=${ctid}"
            echo "requested_features=mount=nfs"
            echo "--- pct config (before) ---"
            sudo pct config "${ctid}" 2>>"${features_stderr}" | awk '/^(features|unprivileged|lxc\.apparmor|lxc\.cgroup|lxc\.mount)/ {print}' || true
        } >"${features_report}"

        if sudo pct config "${ctid}" 2>>"${features_stderr}" | grep -qE '^features:.*\bmount=nfs\b'; then
            had_mount_nfs_before=1
        fi

        if sudo -n pct set "${ctid}" -features "mount=nfs,nesting=1" >>"${features_report}" 2>>"${features_stderr}"; then
            {
                echo "--- pct config (after) ---"
                sudo pct config "${ctid}" 2>>"${features_stderr}" | awk '/^(features|unprivileged|lxc\.apparmor|lxc\.cgroup|lxc\.mount)/ {print}' || true
            } >>"${features_report}"

            if sudo pct config "${ctid}" 2>>"${features_stderr}" | grep -qE '^features:.*\bmount=nfs\b'; then
                had_mount_nfs_after=1
                preflight_ok "lxc features include mount=nfs"
            else
                preflight_fail "lxc features missing mount=nfs"
                die "LXC ${ctid} is missing features mount=nfs (see reports/apply/lxc-features.txt)"
            fi
        else
            preflight_fail "failed to set lxc features mount=nfs"
            die "Failed to set LXC ${ctid} feature mount=nfs via pct (see reports/apply/lxc-features.txt)"
        fi

        # Feature changes typically require a restart to take effect.
        if [[ ${had_mount_nfs_before} -eq 0 && ${had_mount_nfs_after} -eq 1 ]]; then
            echo "action=reboot" >>"${features_report}"
            sudo -n pct reboot "${ctid}" >>"${features_report}" 2>>"${features_stderr}" || true

            waited=0
            attempt=1
            while true; do
                if ssh -i "${lxc_key_file}" \
                    ${ssh_common_args} \
                    "root@${service_ip}" 'true' >/dev/null 2>&1; then
                    break
                fi
                echo "[ssh-wait-features-reboot] attempt=${attempt} waited=${waited}s"
                if (( waited >= ssh_wait_seconds )); then
                    die "ssh not ready on ${service_ip} after features reboot (${ssh_wait_seconds}s)"
                fi
                sleep "${ssh_sleep_seconds}"
                waited=$((waited + ssh_sleep_seconds))
                attempt=$((attempt + 1))
            done
        fi
    fi

    # In-guest NFS mounts can be blocked for unprivileged LXCs (kernel userns mount restrictions)
    # even when Proxmox features include mount=nfs. For Jellyfin, bind-mount the already-mounted
    # host NFS path into the container (read-only) and record proof.
    if [[ -n "${ctid}" && "${SERVICE}" == "jellyfin" ]]; then
        local mp_report="${EVIDENCE_ROOT}/reports/apply/lxc-mountpoints.txt"
        local mp_stderr="${EVIDENCE_ROOT}/reports/apply/lxc-mountpoints.stderr.txt"
        local host_path="/mnt/nas/video"
        local mp_target="/media/video"
        local desired_mp0="${host_path},mp=${mp_target},ro=1"

        {
            echo "ctid=${ctid}"
            echo "service=${SERVICE}"
            echo "host_path=${host_path}"
            echo "container_target=${mp_target}"
            echo "requested_mp0=${desired_mp0}"
            echo "--- host findmnt (target) ---"
            findmnt -n -o SOURCE,FSTYPE,OPTIONS,TARGET --target "${host_path}" 2>>"${mp_stderr}" || true
            echo "--- pct config (before) ---"
            sudo pct config "${ctid}" 2>>"${mp_stderr}" | awk '/^(mp[0-9]+:|features:|unprivileged:)/ {print}' || true
        } >"${mp_report}"

        local mp0_before=""
        mp0_before="$(sudo pct config "${ctid}" 2>>"${mp_stderr}" | awk -F': ' '/^mp0:/ {print $2; exit}' || true)"

        if [[ "${mp0_before}" != "${desired_mp0}" ]]; then
            if sudo -n pct set "${ctid}" -mp0 "${desired_mp0}" >>"${mp_report}" 2>>"${mp_stderr}"; then
                {
                    echo "--- pct config (after) ---"
                    sudo pct config "${ctid}" 2>>"${mp_stderr}" | awk '/^(mp[0-9]+:|features:|unprivileged:)/ {print}' || true
                    echo "action=reboot"
                } >>"${mp_report}"

                sudo -n pct reboot "${ctid}" >>"${mp_report}" 2>>"${mp_stderr}" || true

                waited=0
                attempt=1
                while true; do
                    if ssh -i "${lxc_key_file}" \
                        ${ssh_common_args} \
                        "root@${service_ip}" 'true' >/dev/null 2>&1; then
                        break
                    fi
                    echo "[ssh-wait-mp-reboot] attempt=${attempt} waited=${waited}s"
                    if (( waited >= ssh_wait_seconds )); then
                        die "ssh not ready on ${service_ip} after mp0 reboot (${ssh_wait_seconds}s)"
                    fi
                    sleep "${ssh_sleep_seconds}"
                    waited=$((waited + ssh_sleep_seconds))
                    attempt=$((attempt + 1))
                done
            else
                preflight_fail "failed to set lxc mountpoint mp0"
                die "Failed to set LXC ${ctid} mountpoint mp0 via pct (see reports/apply/lxc-mountpoints.txt)"
            fi
        else
            echo "status=already-correct" >>"${mp_report}"
        fi
    fi

    # Bootstrap the host (as root) so the 'ansible' user exists and is trusted.
    local inventory_file="${REPO_ROOT}/ansible/inventories/generated/hosts.yml"
    local bootstrap_playbook="${REPO_ROOT}/ansible/playbooks/bootstrap.yml"
    if [[ ! -f "${bootstrap_playbook}" ]]; then
        die "missing bootstrap playbook: ${bootstrap_playbook}"
    fi
    ansible-playbook -i "${inventory_file}" "${bootstrap_playbook}" \
        --limit "${SERVICE}" \
        --ssh-common-args "${ssh_common_args}" \
        -u root \
        -e ansible_user=root \
        2>&1 | tee "${EVIDENCE_ROOT}/reports/apply/ansible-bootstrap.txt"

    # Configure inside the LXC
    local playbook="${REPO_ROOT}/ansible/playbooks/${SERVICE}.yml"
    if [[ ! -f "${playbook}" ]]; then
        die "missing ansible playbook for service=${SERVICE}: ${playbook}"
    fi
    ansible-playbook -i "${inventory_file}" "${playbook}" \
        --limit "${SERVICE}" \
        --ssh-common-args "${ssh_common_args}" \
        -e "evidence_dir=${EVIDENCE_ROOT}" \
        -e "run_id=${RUN_ID}" \
        -e "profile_id=${PROFILE_ID}" \
        2>&1 | tee "${EVIDENCE_ROOT}/reports/apply/ansible-${SERVICE}.txt"

    # Healthcheck
    # We intentionally read healthcheck_enabled directly from host_vars to avoid
    # vault decryption issues (ansible-inventory loads group_vars/*/vault.yml).
    local hc_enabled="true"
    local hc_reason=""
    local host_vars_file="${REPO_ROOT}/ansible/host_vars/${SERVICE}.yml"

    local python_bin=""
    if command -v python3 >/dev/null 2>&1; then
        python_bin="$(command -v python3)"
    elif [[ -x /usr/bin/python3 ]]; then
        python_bin="/usr/bin/python3"
    fi

    # Capture minimal diagnostics for troubleshooting (no secrets): whether the
    # host_vars file exists, and whether python3 is available.
    local hc_diag_txt="${EVIDENCE_ROOT}/reports/healthcheck/${SERVICE}.diag.txt"
    : >"${hc_diag_txt}"
    {
        echo "host_vars_file=${host_vars_file}"
        if [[ -f "${host_vars_file}" ]]; then
            echo "host_vars_file_exists=true"
        else
            echo "host_vars_file_exists=false"
        fi
        echo "python_bin=${python_bin}"
        if [[ -n "${python_bin}" ]]; then
            "${python_bin}" --version 2>&1 | head -n 1 | sed 's/^/python3_version=/'
        else
            echo "python3_version="
        fi
    } >>"${hc_diag_txt}" || true

    if [[ -f "${host_vars_file}" ]] && [[ -n "${python_bin}" ]]; then
        local -a hc_lines=()
        mapfile -t hc_lines < <(
            "${python_bin}" - "${host_vars_file}" <<'PY' 2>/dev/null || true
import sys
import re

# Simple YAML parser for healthcheck_enabled (avoids needing PyYAML and vault)
enabled = True
reason = ""

try:
    with open(sys.argv[1], 'r') as f:
        for line in f:
            # Skip vault-encrypted blocks
            if '$ANSIBLE_VAULT' in line:
                break
            # Look for healthcheck_enabled: false/true
            match = re.match(r'^\s*healthcheck_enabled:\s*(true|false)\s*$', line, re.IGNORECASE)
            if match:
                enabled = match.group(1).lower() == 'true'
            # Look for healthcheck_reason
            match = re.match(r'^\s*healthcheck_reason:\s*["\']?([^"\']*)["\']?\s*$', line)
            if match:
                reason = match.group(1)
except Exception:
    pass

sys.stdout.write("false\n" if not enabled else "true\n")
sys.stdout.write(reason)
PY
        )
        hc_enabled="${hc_lines[0]:-true}"
        hc_reason="${hc_lines[1]:-}"
        {
            echo "parsed_hc_enabled=${hc_enabled}"
            if [[ -n "${hc_reason}" ]]; then
                echo "parsed_hc_reason_present=true"
            else
                echo "parsed_hc_reason_present=false"
            fi
        } >>"${hc_diag_txt}" || true
    else
        # If we can't evaluate host_vars (missing file or python3), we default to enabled.
        echo "parsed_hc_enabled=default_true" >>"${hc_diag_txt}" || true
    fi

    local hc="${REPO_ROOT}/scripts/healthcheck/${SERVICE}.sh"
    local hc_json="${EVIDENCE_ROOT}/reports/healthcheck/${SERVICE}.json"
    local hc_txt="${EVIDENCE_ROOT}/reports/healthcheck/${SERVICE}.txt"
    : >"${hc_txt}"

    if [[ "${hc_enabled}" == "false" ]]; then
        {
            echo "healthcheck: skipped (healthcheck_enabled=false)"
            if [[ -n "${hc_reason}" ]]; then
                echo "reason: ${hc_reason}"
            fi
        } | tee -a "${hc_txt}"
        cat >"${hc_json}" <<EOF
{
  "schema_version": "1.0.0",
  "run_id": "${RUN_ID}",
  "environment": "${ENVIRONMENT}",
  "service": "${SERVICE}",
  "ok": true,
  "status": "skipped",
  "reason": "${hc_reason}"
}
EOF
        popd >/dev/null

        {
            echo "status=success"
            echo "terraform_plan_exitcode=${plan_rc}"
        } >"${EVIDENCE_ROOT}/reports/apply/summary.txt"

        emit_phase_complete "${RUN_ID}" "apply"
        run_offline_verify
        trap - ERR
        if [[ -n "${vault_pw_file}" ]]; then
            rm -f "${vault_pw_file}" || true
        fi
        if [[ ${#linked_vault_files[@]} -gt 0 ]]; then
            rm -f "${linked_vault_files[@]}" || true
        fi
        return 0
    fi

    if [[ ! -x "${hc}" ]]; then
        die "missing healthcheck script for service=${SERVICE}: ${hc}"
    fi

    # Services may briefly return 503 right after first start (package install + systemd).
    # Treat healthcheck as a readiness probe with a bounded retry window.
    local hc_timeout_seconds="${HEALTHCHECK_TIMEOUT_SECONDS:-180}"
    local hc_retry_seconds="${HEALTHCHECK_RETRY_SECONDS:-5}"
    local hc_waited=0
    local hc_attempt=1
    local hc_rc=1

    while (( hc_waited <= hc_timeout_seconds )); do
        echo "--- healthcheck attempt ${hc_attempt} (waited=${hc_waited}s) ---" | tee -a "${hc_txt}"
        if HC_SSH_TARGET="root@${service_ip}" \
            HC_SSH_KEY_FILE="${lxc_key_file}" \
            HC_SSH_COMMON_ARGS="${ssh_common_args}" \
            "${hc}" \
            --profile lan \
            --output-json "${hc_json}" \
            | tee -a "${hc_txt}"; then
            hc_rc=0
            break
        else
            hc_rc=$?
        fi

        if (( hc_waited >= hc_timeout_seconds )); then
            break
        fi

        sleep "${hc_retry_seconds}"
        hc_waited=$((hc_waited + hc_retry_seconds))
        hc_attempt=$((hc_attempt + 1))
    done

    if (( hc_rc != 0 )); then
        die "healthcheck failed for service=${SERVICE} after ${hc_waited}s (rc=${hc_rc}); see reports/healthcheck/${SERVICE}.txt"
    fi

    popd >/dev/null

    {
        echo "status=success"
        echo "terraform_plan_exitcode=${plan_rc}"
    } >"${EVIDENCE_ROOT}/reports/apply/summary.txt"

    emit_phase_complete "${RUN_ID}" "apply"
    run_offline_verify
    trap - ERR
    if [[ -n "${vault_pw_file}" ]]; then
        rm -f "${vault_pw_file}" || true
    fi
    if [[ ${#linked_vault_files[@]} -gt 0 ]]; then
        rm -f "${linked_vault_files[@]}" || true
    fi
    return 0
}

compute_blast_radius() {
        local plan_json="$1"
        local out="${EVIDENCE_ROOT}/blast-radius.json"

        if ! command -v jq >/dev/null 2>&1; then
                preflight_fail "jq not available; cannot compute blast radius"
                return 1
        fi

        jq -c '{
            "schema_version": "1.0.0",
            "run_id": ($run_id),
            "environment": ($env),
            "service": ($service),
            "counts": {
                "create": ([.resource_changes[]? | select(.change.actions == ["create"]) ] | length),
                "update": ([.resource_changes[]? | select(.change.actions == ["update"]) ] | length),
                "replace": ([.resource_changes[]? | select((.change.actions | index("create")) and (.change.actions | index("delete"))) ] | length),
                "destroy": ([.resource_changes[]? | select(.change.actions == ["delete"]) ] | length)
            },
            "resources": ([
                .resource_changes[]? | {
                    address: .address,
                    actions: .change.actions
                }
            ]),
            "destructive": (
                ([.resource_changes[]? | select(.change.actions == ["delete"] or ((.change.actions | index("create")) and (.change.actions | index("delete"))))] | length) > 0
            )
        }' \
            --arg run_id "${RUN_ID}" \
            --arg env "${ENVIRONMENT}" \
            --arg service "${SERVICE}" \
            "${plan_json}" >"${out}"

        preflight_ok "blast-radius.json emitted"
        return 0
}

enforce_bind_mount_policy() {
        local plan_json="$1"

        if ! command -v jq >/dev/null 2>&1; then
                preflight_fail "jq not available; cannot enforce bind-mount policy"
                return 1
        fi

        local violations
        violations="$(jq -r '
            .resource_changes[]? as $rc
            | ($rc.change.after // empty) as $after
            | select($after != null)
            | (
                    ($after.mountpoint // [])[]? | .volume? // empty
                ) as $vol
            | select(($vol | type == "string") and ($vol | startswith("/")))
            | "\($rc.address)\t\($vol)"
        ' "${plan_json}" 2>/dev/null || true)"

        if [[ -n "${violations}" ]]; then
                {
                        echo "DENY: Host-path bind mount(s) detected (volume starts with '/')"
                        echo "Each line: <terraform_address><TAB><volume>"
                        echo
                        echo "${violations}"
                } >"${EVIDENCE_ROOT}/reports/plan/bind-mount-guard.txt"
                preflight_fail "bind-mount policy violation (host-path bind mount detected)"
                return 1
        fi

        {
                echo "ALLOW: No host-path bind mounts detected"
        } >"${EVIDENCE_ROOT}/reports/plan/bind-mount-guard.txt"
        return 0
}

main() {
    local subcommand="${1:-}"
    shift || true

    case "$subcommand" in
        -h|--help|help|"")
            usage
            return 0
            ;;
        plan)
            cmd_plan "$@"
            ;;
        apply)
            cmd_apply "$@"
            ;;
        *)
            echo "ERROR: Unknown subcommand: $subcommand" >&2
            usage >&2
            return 2
            ;;
    esac
}

main "$@"
