{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://homelab-proxmox/schemas/profile.schema.json",
  "title": "Profile",
  "description": "Named validation intent that declares prerequisites, execution phases, and expected checks",
  "type": "object",
  "required": [
    "profile_id",
    "display_name",
    "tier",
    "mode",
    "safety_level",
    "expected_duration_minutes",
    "prerequisites",
    "checks",
    "phases"
  ],
  "properties": {
    "profile_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "Stable identifier in kebab-case",
      "examples": ["hypervisor-control-plane", "hypervisor-nested-workload"]
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "description": "Human-readable name"
    },
    "tier": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9,
      "description": "Numeric tier (maps to legacy concept)"
    },
    "mode": {
      "type": "string",
      "enum": ["min", "plus", "custom"],
      "description": "Mode within tier"
    },
    "safety_level": {
      "type": "string",
      "enum": ["standard", "strict"],
      "description": "Guardrail enforcement level"
    },
    "expected_duration_minutes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 120,
      "description": "Target execution time (informational)"
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 20,
      "description": "Host capability checks (e.g., nested-kvm, min-memory-4g)"
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z]+-[0-9]{3}$"
      },
      "minItems": 1,
      "maxItems": 100,
      "description": "Check IDs this profile expects to execute"
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": ["name", "type", "path"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Phase name (e.g., bootstrap, tier2, validation)"
          },
          "type": {
            "type": "string",
            "enum": ["playbook", "script", "role"],
            "description": "Execution type"
          },
          "path": {
            "type": "string",
            "description": "Relative path from repository root"
          }
        }
      },
      "description": "Execution phases with playbook/script paths"
    }
  }
}
