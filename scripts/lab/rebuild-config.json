      "path": "/mnt/immich-external/photo"
    }
  ],
  "immich_ctid": 101,
  "service_allowlist_path": "scripts/lab/service-scope-allowlist.json",
  "phases": [
    "mounts",
    "restore",
    "iac",
    "services",
    "verify"
  ]
}
