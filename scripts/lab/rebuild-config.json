{
  "default_environment": "lab",
  "prod_confirm_string": "rebuild-prod",
  "service_deploy_confirm_string": "deploy-prod",
  "required_host_mounts": [
    "/mnt/nas/homelab_immich",
    "/mnt/nas/photo"
  ],
  "immich_bind_mounts": [
    {
      "mp": "mp0",
      "path": "/mnt/immich"
