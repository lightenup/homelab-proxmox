# --- Feature 019c1: Preflight Environment Checks ---

# ENV-001: Verify lab environment via hostname pattern
check_env_001() {
    local ssh_target="${SSH_USER}@${PROXMOX_HOST}"
    
    log_info "Running ENV-001: Verify lab environment (hostname pattern)"
    
    # Check hostname contains 'lab' or is in test environment
    local hostname
    hostname="$(ssh $SSH_OPTS "$ssh_target" "hostname")"
    
    if [[ "$hostname" =~ lab ]] || [[ "$hostname" == "pve" ]]; then
        log_info "  ENV-001 PASS: Hostname '$hostname' contains 'lab'"
        record_check "ENV-001" \
            "Target is lab environment (not production)" \
            "blocker" \
            "PASS" \
            "PASS" \
            "Hostname pattern check passed: $hostname"
        return 0
    else
        log_error "  ENV-001 FAIL: Hostname '$hostname' does not contain 'lab'"
        log_error "  This appears to be a production environment!"
        log_error "  Lab harness should only run against lab/test systems"
        log_error "  → REMEDIATION: Set hostname with 'lab' in name (e.g., 'hostnamectl set-hostname lab-pve-01')"
        record_check "ENV-001" \
            "Target is lab environment (not production)" \
            "blocker" \
            "PASS" \
            "FAIL" \
            "Hostname pattern check failed: $hostname (expected 'lab' in hostname)"
        return 1
    fi
}

# ENV-002: Verify required resources available
check_env_002() {
    local ssh_target="${SSH_USER}@${PROXMOX_HOST}"
    
    log_info "Running ENV-002: Verify required resources (memory, CPU, storage)"
    
    # Check memory (require at least 8GB free)
    local free_mem_mb
    free_mem_mb="$(ssh $SSH_OPTS "$ssh_target" "free -m | awk '/^Mem:/{print \$7}'")"
    
    if [[ -z "$free_mem_mb" ]]; then
        log_warn "  Could not determine host memory"
        record_check "ENV-002" \
            "Required resources available (memory, CPU)" \
            "high" \
            "PASS" \
            "SKIP" \
            "Could not determine host memory"
        return 0
    fi
    
    if [[ "$free_mem_mb" -lt 8192 ]]; then
        log_error "  ENV-002 FAIL: Insufficient memory ($free_mem_mb MB < 8192 MB)"
        log_error "  → REMEDIATION: Free up memory by stopping services or increasing host RAM"
        record_check "ENV-002" \
            "Required resources available (memory, CPU)" \
            "high" \
            "PASS" \
            "FAIL" \
            "Insufficient host memory: ${free_mem_mb}MB free (need 8192MB)"
        return 1
    else
        log_info "  ENV-002 PASS: Sufficient memory ($free_mem_mb MB)"
        record_check "ENV-002" \
            "Required resources available (memory, CPU)" \
            "high" \
            "PASS" \
            "PASS" \
            "Host resources OK: ${free_mem_mb}MB free"
        return 0
    fi
}

# CLEANUP-PRE-001: Preflight check for stale resources
check_cleanup_pre_001() {
    local ssh_target="${SSH_USER}@${PROXMOX_HOST}"
    local evidence_file="${EVIDENCE_ROOT}/reports/cleanup/preflight-inventory.txt"
    mkdir -p "$(dirname "$evidence_file")"

    log_info "Running CLEANUP-PRE-001: Preflight check for stale resources"

    # 1. Scan for VMs in range (excluding templates)
    local stale_vms
    stale_vms="$(ssh $SSH_OPTS "$ssh_target" "qm list 2>/dev/null | awk '\$1 >= $LAB_VMID_START && \$1 <= $LAB_VMID_END && \$1 != $LAB_TEMPLATE_VMID && \$1 != $LAB_TEMPLATE_VMID_TIER2 {print \$1}'")"
    
    # Capture inventory evidence
    ssh $SSH_OPTS "$ssh_target" "qm list" > "$evidence_file"

    if [[ -z "$stale_vms" ]]; then
        log_info "  CLEANUP-PRE-001 PASS: No stale resources found"
        record_check "CLEANUP-PRE-001" \
            "Preflight cleanup check" \
            "blocker" \
            "PASS" \
            "PASS" \
            "No stale resources found in range $LAB_VMID_START-$LAB_VMID_END" \
            "file:reports/cleanup/preflight-inventory.txt"
        return 0
    fi

    log_warn "  CLEANUP-PRE-001: Found stale VMs: $(echo "$stale_vms" | tr '\n' ' ')"
    log_info "  Attempting cleanup..."

    # 2. Attempt cleanup
    local cleanup_failed=0
    for vmid in $stale_vms; do
        log_info "    Destroying stale VM $vmid..."
        if ! ssh $SSH_OPTS "$ssh_target" "qm stop $vmid --skiplock >/dev/null 2>&1; qm destroy $vmid --purge >/dev/null 2>&1"; then
            log_error "    Failed to destroy VM $vmid"
            cleanup_failed=1
        fi
    done

    # 3. Verify cleanup
    local remaining_vms
    remaining_vms="$(ssh $SSH_OPTS "$ssh_target" "qm list 2>/dev/null | awk '\$1 >= $LAB_VMID_START && \$1 <= $LAB_VMID_END && \$1 != $LAB_TEMPLATE_VMID && \$1 != $LAB_TEMPLATE_VMID_TIER2 {print \$1}'")"

    if [[ -n "$remaining_vms" ]]; then
        log_error "  CLEANUP-PRE-001 FAIL: Failed to remove stale resources: $(echo "$remaining_vms" | tr '\n' ' ')"
        record_check "CLEANUP-PRE-001" \
            "Preflight cleanup check" \
            "blocker" \
            "PASS" \
            "FAIL" \
            "Failed to remove stale resources: $(echo "$remaining_vms" | tr '\n' ' ')" \
            "file:reports/cleanup/preflight-inventory.txt"
        return 1
    else
        log_info "  CLEANUP-PRE-001 PASS: Stale resources found and removed"
        record_check "CLEANUP-PRE-001" \
            "Preflight cleanup check" \
            "blocker" \
            "PASS" \
            "PASS" \
            "Stale resources found and removed: $(echo "$stale_vms" | tr '\n' ' ')" \
            "file:reports/cleanup/preflight-inventory.txt"
        return 0
    fi
}

# Suite execution semantics: Check if suite should abort
# Returns: 0 if should continue, 1 if should abort
should_abort_suite() {
    local check_id="$1"
    local severity="$2"
    local expected="$3"
    local result="$4"
    
    # Abort condition 1: Blocker severity check failed
    if [[ "$severity" == "blocker" && "$result" == "FAIL" ]]; then
        log_error "ABORT: Blocker check $check_id failed"
        SUITE_ABORT_REQUESTED=1
        return 1
    fi
    
    # Abort condition 2: Negative test with unexpected success (safety hole)
    if [[ "$expected" == "FAIL" && "$result" == "PASS" ]]; then
        log_error "ABORT: Negative test $check_id unexpectedly passed (safety hole detected)"
        SUITE_ABORT_REQUESTED=1
        return 1
    fi
    
    return 0
}

# Console check summary formatter (019c1)
# Prints compact checklist (<2 lines per check)
print_check_summary() {
    echo ""
    echo "=== Check Summary ==="
    echo ""
    
    local total=0
    local passed=0
    local failed=0
    local skipped=0
    
    # Parse CHECKS_ARRAY and print each check
    for check_json in "${CHECKS_ARRAY[@]}"; do
        total=$((total + 1))
        
        # Extract fields from JSON (using jq if available, otherwise basic parsing)
        local check_id result title
        if command -v jq &>/dev/null; then
            check_id=$(echo "$check_json" | jq -r '.check_id')
            result=$(echo "$check_json" | jq -r '.result')
            title=$(echo "$check_json" | jq -r '.title')
        else
            # Basic grep parsing
            check_id=$(echo "$check_json" | grep -o '"check_id"[[:space:]]*:[[:space:]]*"[^"]*"' | sed 's/.*"\([^"]*\)"/\1/')
            result=$(echo "$check_json" | grep -o '"result"[[:space:]]*:[[:space:]]*"[^"]*"' | sed 's/.*"\([^"]*\)"/\1/')
            title=$(echo "$check_json" | grep -o '"title"[[:space:]]*:[[:space:]]*"[^"]*"' | sed 's/.*"\([^"]*\)"/\1/')
        fi
        
        # Count by result
        case "$result" in
            PASS) passed=$((passed + 1)) ;;
            FAIL) failed=$((failed + 1)) ;;
            SKIP) skipped=$((skipped + 1)) ;;
        esac
        
        # Format result with color
        local result_display
        case "$result" in
            PASS) result_display="${GREEN}✓ PASS${NC}" ;;
            FAIL) result_display="${RED}✗ FAIL${NC}" ;;
            SKIP) result_display="${YELLOW}○ SKIP${NC}" ;;
            ERROR) result_display="${RED}✗ ERROR${NC}" ;;
            *) result_display="? $result" ;;
        esac
        
        # Print check (single line: check_id result title)
        printf "%-12s %b  %s\n" "$check_id" "$result_display" "$title"
    done
    
    echo ""
    echo "Total: $total | Passed: $passed | Failed: $failed | Skipped: $skipped"
    echo ""
}

