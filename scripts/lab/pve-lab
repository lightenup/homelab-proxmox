#!/bin/bash
set -e

# Ensure Ansible uses the correct configuration (including vault password)
export ANSIBLE_CONFIG="ansible/ansible.cfg"

# Configuration
LAB_VMID_START=9000
LAB_VMID_END=9099
LAB_TEMPLATE_VMID=${LAB_TEMPLATE_VMID:-9001}
LAB_TEMPLATE_VMID_TIER2=${LAB_TEMPLATE_VMID_TIER2:-9002}
LAB_IP="10.99.0.10"
LAB_GATEWAY="10.99.0.1"
LAB_BRIDGE="vmbr99"
IDENTITY_TAG_KEY="ManagedBy"
IDENTITY_TAG_VAL="019a"
PROXMOX_HOST="192.168.1.112" # Hostname or IP in SSH config
SSH_USER="root"
LOCK_FILE="artifacts/019-lab/.lock"
SSH_OPTS="-o BatchMode=yes -o ConnectTimeout=5 -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Global Artifact Dir (set in cmd_run)
ARTIFACT_DIR=""

log_info() { echo -e "${GREEN}[INFO]${NC} $1"; }
log_warn() { echo -e "${YELLOW}[WARN]${NC} $1"; }
log_error() { echo -e "${RED}[ERROR]${NC} $1"; }

# --- Feature 019c: Confidence Suite ---

# Profile Definitions
# Usage: parse_profile "profile_name"
# Sets: PROFILE_TIER, PROFILE_MODE, PROFILE_SAFETY
parse_profile() {
    local profile=$1
    case "$profile" in
        "bootstrap")
            PROFILE_TIER=1
            PROFILE_MODE="min"
            PROFILE_SAFETY="standard"
            ;;
        "hypervisor-control-plane")
            PROFILE_TIER=2
            PROFILE_MODE="min"
            PROFILE_SAFETY="standard"
            ;;
        "hypervisor-nested-workload")
            PROFILE_TIER=2
            PROFILE_MODE="plus"
            PROFILE_SAFETY="strict"
            ;;
        *)
            log_error "Unknown profile: $profile"
            return 1
            ;;
    esac
    log_info "Profile Selected: $profile (Tier=$PROFILE_TIER, Mode=$PROFILE_MODE, Safety=$PROFILE_SAFETY)"
}

# Evidence Pack Functions
EVIDENCE_ROOT=""

evidence_init() {
    local run_id=$1
    local profile=$2
    EVIDENCE_ROOT="artifacts/019-lab/$run_id"
    
    mkdir -p "$EVIDENCE_ROOT"/{logs,config,validation}
    
    # Initialize Manifest
    cat <<JSON > "$EVIDENCE_ROOT/evidence_manifest.json"
{
  "run_id": "$run_id",
  "profile": "$profile",
  "timestamp_start": "$(date -u +"%Y-%m-%dT%H:%M:%SZ")",
  "artifacts": [],
  "validation_results": {}
}
JSON
    log_info "Evidence Pack initialized at $EVIDENCE_ROOT"
}

evidence_finalize() {
    local status=$1
    local end_time=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
    
    # Create a final status file to complement the manifest
    cat <<JSON > "$EVIDENCE_ROOT/status.json"
{
  "status": "$status",
  "timestamp_end": "$end_time"
}
JSON
    log_info "Evidence Pack finalized. Status: $status"
}

# Ensure artifacts dir exists
mkdir -p artifacts/019-lab

# Helper: Get timestamp in milliseconds
get_ms_timestamp() {
    if command -v python3 >/dev/null 2>&1; then
        python3 -c 'import time; print(int(time.time() * 1000))'
    else
        # Fallback to seconds * 1000
        echo $(($(date +%s) * 1000))
    fi
}

# Helper: Log command execution
log_cmd_exec() {
    local cmd="$*"
    local start_ts=$(get_ms_timestamp)
    local exit_code=0
    
    # Run command
    eval "$cmd" || exit_code=$?
    
    local end_ts=$(get_ms_timestamp)
    local duration=$((end_ts - start_ts))
    local timestamp=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
    
    # Log to jsonl if ARTIFACT_DIR is set
    if [[ -n "$ARTIFACT_DIR" ]]; then
        # Simple JSON construction (escaping quotes in cmd is minimal here, be careful)
        # For bash, proper JSON escaping is hard without jq. We'll do basic escaping.
        local safe_cmd=${cmd//\"/\\\"}
        echo "{\"timestamp\": \"$timestamp\", \"command\": \"$safe_cmd\", \"exit_code\": $exit_code, \"duration_ms\": $duration}" >> "$ARTIFACT_DIR/commands.jsonl"
    fi
    
    return $exit_code
}

# Helper: Run command on Proxmox host
pve_exec() {
    # We don't log every pve_exec to jsonl to avoid noise, or maybe we do?
    # Let's log it.
    # But pve_exec is often used in subshells $(pve_exec ...), which makes logging hard (stdout pollution).
    # So we ONLY log if NOT in a subshell context where stdout is captured.
    # Actually, for simplicity, we won't wrap pve_exec in log_cmd_exec when used for data retrieval.
    # We will wrap "Action" commands.
    ssh $SSH_OPTS "$SSH_USER@$PROXMOX_HOST" "$@"
}

# Helper: Check if VM exists
vm_exists() {
    local vmid=$1
    pve_exec "qm status $vmid" >/dev/null 2>&1
}

# Helper: Get VM Status
vm_status() {
    local vmid=$1
    pve_exec "qm status $vmid" | awk '{print $2}'
}

# Helper: Find next free VMID
get_free_vmid() {
    local vmid
    # Get list of all VMIDs once to avoid spamming SSH
    local existing_vmids
    existing_vmids=$(pve_exec "qm list" | awk '{print $1}' | grep -E "^[0-9]+$")
    
    for ((vmid=LAB_VMID_START; vmid<=LAB_VMID_END; vmid++)); do
        if ! echo "$existing_vmids" | grep -q "^$vmid$"; then
            echo "$vmid"
            return 0
        fi
    done
    return 1
}

# Helper: Find existing Lab VMs (Safety Checked)
find_lab_vms() {
    local vmid
    local found_vmids=""
    # Optimization: Get all VMs in range first
    local range_vmids
    range_vmids=$(pve_exec "qm list" | awk -v start="$LAB_VMID_START" -v end="$LAB_VMID_END" '$1 >= start && $1 <= end {print $1}')
    
    for vmid in $range_vmids; do
        if check_safety "$vmid" "quiet"; then
            found_vmids="$found_vmids $vmid"
        fi
    done
    echo "$found_vmids"
}

# Safety Guardrail
check_safety() {
    local vmid=$1
    local mode=$2 # "quiet" to suppress logs
    
    # Check 1: Range
    if [[ "$vmid" -lt "$LAB_VMID_START" ]] || [[ "$vmid" -gt "$LAB_VMID_END" ]]; then
        [[ "$mode" != "quiet" ]] && log_error "Safety Violation: VMID $vmid is outside lab range ($LAB_VMID_START-$LAB_VMID_END)"
        return 1
    fi

    # Check 1b: Ignore Templates
    if [[ "$vmid" == "$LAB_TEMPLATE_VMID" ]] || [[ "$vmid" == "$LAB_TEMPLATE_VMID_TIER2" ]]; then
        return 1
    fi

    # Check 2: Identity
    local config
    config=$(pve_exec "qm config $vmid" 2>/dev/null || true)
    
    # Must have ManagedBy tag
    if [[ "$config" != *"$IDENTITY_TAG_KEY=$IDENTITY_TAG_VAL"* ]]; then
        [[ "$mode" != "quiet" ]] && log_error "Safety Violation: VMID $vmid missing tag '$IDENTITY_TAG_KEY=$IDENTITY_TAG_VAL'"
        return 1
    fi
    
    # Must have RunId tag (any value)
    if [[ "$config" != *"RunId="* ]]; then
        [[ "$mode" != "quiet" ]] && log_error "Safety Violation: VMID $vmid missing 'RunId' tag"
        return 1
    fi
    
    # Must have Name prefix
    local name
    name=$(echo "$config" | grep "^name:" | awk '{print $2}')
    if [[ "$name" != "lab-pve-"* ]]; then
        [[ "$mode" != "quiet" ]] && log_error "Safety Violation: VMID $vmid name '$name' does not start with 'lab-pve-'"
        return 1
    fi
    
    return 0
}

# Environment Safety Validation
validate_safety_profile() {
    local level=${PROFILE_SAFETY:-standard}
    log_info "Validating Safety Profile: $level"
    
    # Standard checks are mostly per-VM and enforced during operations.
    # Here we check environment-wide safety.
    
    if [[ "$level" == "strict" ]]; then
        log_info "Performing Strict Safety Checks..."
        
        # 1. Check for orphaned Lab VMs (VMs in range but missing tags)
        # We get all VMs in range, then check if they pass check_safety.
        # If check_safety fails, it means it's an invalid/orphaned VM in our reserved range.
        local all_vmids_in_range
        all_vmids_in_range=$(pve_exec "qm list" | awk -v start="$LAB_VMID_START" -v end="$LAB_VMID_END" '$1 >= start && $1 <= end {print $1}')
        
        for vmid in $all_vmids_in_range; do
            # Ignore Templates
            if [[ "$vmid" == "$LAB_TEMPLATE_VMID" ]] || [[ "$vmid" == "$LAB_TEMPLATE_VMID_TIER2" ]]; then
                continue
            fi

            if ! check_safety "$vmid" "quiet"; then
                log_error "Strict Safety Violation: Orphaned or Invalid VM found in Lab Range: $vmid"
                log_error "Please investigate and remove manually."
                return 1
            fi
        done
        
        # 2. Check Host Resources (Simple check: ensure enough RAM)
        # Assume we need at least 8GB free for a strict run
        local free_mem_mb
        free_mem_mb=$(pve_exec "free -m | awk '/^Mem:/{print \$7}'")
        # Handle case where pve_exec fails or returns empty
        if [[ -z "$free_mem_mb" ]]; then
             log_warn "Could not determine host memory. Skipping resource check."
        elif [[ "$free_mem_mb" -lt 8192 ]]; then
             log_error "Strict Safety Violation: Insufficient Host Memory ($free_mem_mb MB < 8192 MB)"
             return 1
        else
             log_info "  Host Memory: OK ($free_mem_mb MB free)"
        fi
        
        log_info "Strict Safety Checks Passed."
    fi
}

# Helper: Check Host Requirements (Nested KVM)
check_host_requirements() {
    local tier2_mode=$1
    
    if [[ "$tier2_mode" == "plus" ]]; then
        log_info "Performing Tier 2 Plus Preflight Checks..."
        
        # 1. Host Check (Intel or AMD)
        local nested_val_intel
        local nested_val_amd
        
        nested_val_intel=$(pve_exec "cat /sys/module/kvm_intel/parameters/nested 2>/dev/null || echo 'N'")
        nested_val_amd=$(pve_exec "cat /sys/module/kvm_amd/parameters/nested 2>/dev/null || echo 'N'")
        
        if [[ "$nested_val_intel" == "Y" || "$nested_val_intel" == "1" ]]; then
             log_info "  Host Nested KVM (Intel): OK"
        elif [[ "$nested_val_amd" == "Y" || "$nested_val_amd" == "1" ]]; then
             log_info "  Host Nested KVM (AMD): OK"
        else
            log_error "Host Nested KVM check failed."
            log_error "  Intel: $nested_val_intel"
            log_error "  AMD:   $nested_val_amd"
            log_error "Please enable nested virtualization on the host ($PROXMOX_HOST)."
            return 1
        fi
        
        # 2. Guest Check
        if ! ssh $SSH_OPTS -J "$SSH_USER@$PROXMOX_HOST" "ansible@$LAB_IP" "test -e /dev/kvm"; then
            log_error "Guest /dev/kvm check failed. Nested virtualization not passed to Lab VM."
            return 1
        fi
        log_info "  Guest /dev/kvm: OK"
    fi
    return 0
}

# Helper: Check Network Requirements
check_network_requirements() {
    log_info "Checking Network Requirements..."
    
    # Check FQDN resolution (from Lab VM)
    # Using 'getent hosts' or 'host' or 'ping'
    if ! ssh $SSH_OPTS -J "$SSH_USER@$PROXMOX_HOST" "ansible@$LAB_IP" "getent hosts deb.debian.org >/dev/null"; then
        log_error "DNS Resolution failed on Lab VM (deb.debian.org)."
        return 1
    fi
    log_info "  DNS Resolution: OK"

    # Check Internet Connectivity
    if ! ssh $SSH_OPTS -J "$SSH_USER@$PROXMOX_HOST" "ansible@$LAB_IP" "curl -I -s --connect-timeout 5 https://deb.debian.org >/dev/null"; then
        log_error "Internet Connectivity failed on Lab VM."
        return 1
    fi
    log_info "  Internet Connectivity: OK"
    
    return 0
}

# Helper: Collect Artifacts
collect_artifacts() {
    local run_id=$1
    local artifact_dir="${EVIDENCE_ROOT:-artifacts/019-lab/$run_id}"
    
    log_info "Collecting artifacts for run $run_id..."
    
    # Create subdirectories
    mkdir -p "$artifact_dir/logs" "$artifact_dir/config"
    
    # Commands to run on Lab VM
    # We use a single SSH connection to run multiple commands if possible, or just loop.
    # Since we need to fetch files back, we'll generate them on the VM first.
    
    local remote_cmds="
        pveversion -v > /tmp/pveversion.txt 2>&1;
        pvesh version > /tmp/pvesh_version.txt 2>&1;
        apt-cache policy > /tmp/apt_policy.txt 2>&1;
        systemctl status --no-pager > /tmp/systemctl_status.txt 2>&1;
        journalctl -n 1000 --no-pager > /tmp/journal.log 2>&1;
    "
    
    if ssh $SSH_OPTS -J "$SSH_USER@$PROXMOX_HOST" "ansible@$LAB_IP" "$remote_cmds"; then
        # Fetch files
        # Using scp with ProxyJump
        scp $SSH_OPTS -o ProxyJump="$SSH_USER@$PROXMOX_HOST" "ansible@$LAB_IP:/tmp/*.txt" "$artifact_dir/config/" 2>/dev/null || log_warn "Failed to fetch config artifacts"
        scp $SSH_OPTS -o ProxyJump="$SSH_USER@$PROXMOX_HOST" "ansible@$LAB_IP:/tmp/*.log" "$artifact_dir/logs/" 2>/dev/null || log_warn "Failed to fetch log artifacts"
        
        # Fetch Validation Report
        scp $SSH_OPTS -o ProxyJump="$SSH_USER@$PROXMOX_HOST" "ansible@$LAB_IP:/var/lib/validation/checks.json" "$artifact_dir/validation/" 2>/dev/null || log_warn "Failed to fetch validation report"
        
        # Register artifacts in manifest (if function exists)
        if command -v evidence_add_artifact >/dev/null; then
             for f in "$artifact_dir/config"/*.txt; do evidence_add_artifact "config" "$f" "Config Dump"; done
             for f in "$artifact_dir/logs"/*.log; do evidence_add_artifact "log" "$f" "System Log"; done
             for f in "$artifact_dir/validation"/*.json; do evidence_add_artifact "report" "$f" "Validation Report"; done
        fi
    else
        log_warn "Failed to execute artifact collection commands on Lab VM."
    fi
    
    log_info "Artifacts collected in $artifact_dir"
}

# Helper: Evidence Retention Policy (FR-003)
enforce_evidence_retention() {
    local max_keep=${1:-5}
    local artifact_base="artifacts/019-lab"
    
    log_info "Enforcing Evidence Retention Policy (Keep Last $max_keep)..."
    
    # List directories starting with lab-, sort by name (timestamp)
    local dirs
    dirs=$(ls -1d "$artifact_base"/lab-* 2>/dev/null | sort)
    
    # Count total
    local total
    total=$(echo "$dirs" | wc -l | tr -d ' ')
    
    if [[ "$total" -gt "$max_keep" ]]; then
        local to_delete=$((total - max_keep))
        local dirs_to_remove
        dirs_to_remove=$(echo "$dirs" | head -n "$to_delete")
        
        for dir in $dirs_to_remove; do
            log_info "Removing old evidence pack: $dir"
            rm -rf "$dir"
        done
    fi
}

cmd_status() {
    log_info "Checking status of Lab Environment..."
    local vmids
    vmids=$(find_lab_vms)
    
    if [[ -z "$vmids" ]]; then
        log_info "No active Lab VMs found."
        return 0
    fi
    
    for vmid in $vmids; do
        local state=$(vm_status "$vmid")
        log_info "Found Lab VM: $vmid ($state)"
        if [[ "$state" == "running" ]]; then
            log_info "  IP Address: $LAB_IP (Static)"
            # Check reachability
            if ssh $SSH_OPTS -J "$SSH_USER@$PROXMOX_HOST" "ansible@$LAB_IP" "echo ready" >/dev/null 2>&1; then
                log_info "  SSH Reachable: YES"
            else
                log_warn "  SSH Reachable: NO"
            fi
        fi
    done
}

cmd_up() {
    local run_id=${1:-"manual-$(date +%H%M%S)"}
    local tier=${2:-1}
    
    # Select Template based on Tier
    local template_id=$LAB_TEMPLATE_VMID
    if [[ "$tier" -ge 2 ]]; then
        template_id=$LAB_TEMPLATE_VMID_TIER2
        log_info "Tier $tier selected. Using Template ID: $template_id"
    fi
    
    # 1. Verify Prod Host Reachability & IP
    log_info "Verifying Production Host Network..."
    if ! pve_exec "ip addr show $LAB_BRIDGE | grep -q '$LAB_GATEWAY'"; then
        log_error "Production host does not have IP $LAB_GATEWAY on $LAB_BRIDGE. Aborting."
        return 1
    fi

    # 1b. Verify Template Exists
    if ! vm_exists "$template_id"; then
        log_error "Template VM $template_id does not exist on host."
        return 1
    fi

    # 2. Check for existing VMs
    local existing_vmids
    existing_vmids=$(find_lab_vms)
    if [[ -n "$existing_vmids" ]]; then
        log_error "Existing Lab VMs found: $existing_vmids. Please destroy them first."
        return 1
    fi

    # 3. Allocate VMID
    local vmid
    vmid=$(get_free_vmid)
    if [[ -z "$vmid" ]]; then
        log_error "No free VMIDs in range $LAB_VMID_START-$LAB_VMID_END."
        return 1
    fi
    log_info "Allocated VMID: $vmid"

    # 4. Clone
    log_info "Cloning template $template_id to $vmid..."
    log_cmd_exec pve_exec "qm clone $template_id $vmid --name lab-pve-$vmid --full 1"
    
    # 5. Configure
    log_info "Configuring VM..."
    local tags="$IDENTITY_TAG_KEY=$IDENTITY_TAG_VAL,RunId=$run_id"
    
    local resource_args=""
    if [[ "$tier" -ge 2 ]]; then
        # Enforce Resource Floor (FR-008)
        log_info "Enforcing Tier 2 Resource Floor (4GB RAM, 2 vCPU, CPU=host)..."
        resource_args="--memory 4096 --cores 2 --cpu host"
    fi
    
    log_cmd_exec pve_exec "qm set $vmid --description '$tags' --ipconfig0 ip=$LAB_IP/24,gw=$LAB_GATEWAY --net0 virtio,bridge=$LAB_BRIDGE $resource_args"
    
    # 6. Start
    log_info "Starting VM..."
    log_cmd_exec pve_exec "qm start $vmid"
    
    # 7. Wait for SSH
    log_info "Waiting for SSH at $LAB_IP..."
    for i in {1..60}; do
        if ssh $SSH_OPTS -J "$SSH_USER@$PROXMOX_HOST" "ansible@$LAB_IP" "echo ready" >/dev/null 2>&1; then
            log_info "SSH is ready!"
            return 0
        fi
        sleep 2
        echo -n "."
    done
    
    log_error "Timeout waiting for SSH."
    return 1
}

cmd_destroy() {
    log_info "Scanning for Lab VMs to destroy..."
    local vmids
    vmids=$(find_lab_vms)
    
    if [[ -z "$vmids" ]]; then
        log_info "No Lab VMs found to destroy."
        return 0
    fi
    
    for vmid in $vmids; do
        log_info "Processing VM $vmid..."
        if ! check_safety "$vmid"; then
            log_error "Safety check failed for $vmid. Skipping."
            continue
        fi
        
        log_info "Stopping VM $vmid..."
        log_cmd_exec pve_exec "qm stop $vmid" 2>/dev/null || true
        sleep 2
        
        log_info "Removing VM $vmid..."
        log_cmd_exec pve_exec "qm destroy $vmid"
        log_info "VM $vmid destroyed."
    done
}

cmd_test() {
    local tier=${1:-1}
    local tier2_mode=${2:-"min"}

    log_info "Running tests (Tier: $tier)..."
    
    # Tier 0: Static Checks
    log_info "Tier 0: Static Checks"
    
    log_info "Running Terraform fmt check..."
    if log_cmd_exec terraform fmt -check -recursive terraform/; then
        log_info "Terraform fmt passed."
    else
        log_error "Terraform fmt failed."
        return 1
    fi
    
    log_info "Running Ansible syntax check..."
    if log_cmd_exec ansible-playbook ansible/playbooks/lab_bootstrap.yml -i ansible/inventories/lab/hosts.yml --syntax-check; then
        log_info "Ansible syntax check passed."
    else
        log_error "Ansible syntax check failed."
        return 1
    fi

    # Tier 1: Convergence
    log_info "Tier 1: Convergence"
    
    if ! check_network_requirements; then
        return 1
    fi

    log_info "Running Lab Bootstrap Playbook..."
    
    if log_cmd_exec ansible-playbook ansible/playbooks/lab_bootstrap.yml -i ansible/inventories/lab/hosts.yml; then
        log_info "Tier 1 Convergence passed."
    else
        log_error "Tier 1 Convergence failed."
        return 1
    fi

    # Tier 2: PVE Install & Verification
    if [[ "$tier" -ge 2 ]]; then
        log_info "Tier 2: PVE Install & Verification (Mode: $tier2_mode)"
        
        # Tier 2 Plus Preflight Checks (FR-016)
        if ! check_host_requirements "$tier2_mode"; then
            return 1
        fi
        
        # Run Tier 2 Playbook
        if log_cmd_exec ansible-playbook ansible/playbooks/lab_tier2_pve.yml -i ansible/inventories/lab/hosts.yml --extra-vars "tier2_mode=$tier2_mode"; then
             log_info "Tier 2 passed."
        else
             log_error "Tier 2 failed."
             return 1
        fi
    fi
}

cmd_run() {
    # Defaults
    local tier=1
    local tier2_mode="min"
    local keep_vm=false
    local profile=""
    
    # Parse args
    while [[ $# -gt 0 ]]; do
        case $1 in
            --profile) profile="$2"; shift ;;
            --tier) tier="$2"; shift ;;
            --tier2-mode) tier2_mode="$2"; shift ;;
            --keep) keep_vm=true ;;
            *) log_error "Unknown argument: $1"; exit 1 ;;
        esac
        shift
    done

    # Apply Profile if set
    if [[ -n "$profile" ]]; then
        if ! parse_profile "$profile"; then
            exit 1
        fi
        tier=$PROFILE_TIER
        tier2_mode=$PROFILE_MODE
        # Safety level will be used later
    fi

    # Locking (flock)
    exec 200>"$LOCK_FILE"
    if ! flock -n 200; then
        log_error "Another instance is running (Lock: $LOCK_FILE). Aborting."
        exit 1
    fi
    
    local run_id="lab-$(date +%Y%m%d-%H%M%S)"
    
    # Initialize Evidence Pack
    evidence_init "$run_id" "${profile:-custom}"
    local artifact_dir="$EVIDENCE_ROOT"
    local summary_file="$artifact_dir/summary.json"
    local log_file="$artifact_dir/run.log"
    
    # Set Global ARTIFACT_DIR for logging
    export ARTIFACT_DIR="$artifact_dir"
    
    # Redirect output to log file and stdout
    exec > >(tee -a "$log_file") 2>&1
    
    log_info "Starting Lab Run: $run_id"
    log_info "Artifacts: $artifact_dir"
    log_info "Configuration: Tier=$tier, Mode=$tier2_mode, Keep=$keep_vm, Profile=${profile:-custom}"
    
    local start_time=$(date +%s)
    local status="FAILED"
    
    # Ensure clean state
    cmd_destroy
    
    # Validate Safety Profile (FR-019c)
    if ! validate_safety_profile; then
        log_error "Safety Validation Failed. Aborting."
        exit 1
    fi
    
    # Trap to ensure destroy runs (unless keep_vm is set)
    if [[ "$keep_vm" == "true" ]]; then
        trap "log_info 'Keeping VM as requested (--keep).'" EXIT
    else
        trap "cmd_destroy" EXIT
    fi
    
    if cmd_up "$run_id" "$tier"; then
        if cmd_test "$tier" "$tier2_mode"; then
            status="SUCCESS"
        else
            log_error "Tests failed."
        fi
    else
        log_error "Setup failed."
    fi
    
    # Collect Artifacts (FR-011)
    collect_artifacts "$run_id"
    
    local end_time=$(date +%s)
    local duration=$((end_time - start_time))
    
    # Generate Summary
    cat <<JSON > "$summary_file"
{
  "run_id": "$run_id",
  "status": "$status",
  "profile": "${profile:-custom}",
  "tier": $tier,
  "tier2_mode": "$tier2_mode",
  "keep_vm": $keep_vm,
  "start_time": "$start_time",
  "end_time": "$end_time",
  "duration_seconds": $duration
}
JSON
    
    log_info "Run completed with status: $status"
    
    # Finalize Evidence
    evidence_finalize "$status"
    
    # Finalize Evidence
    evidence_finalize "$status"
    
    # Enforce Retention (FR-003)
    enforce_evidence_retention 5
    
    if [[ "$status" != "SUCCESS" ]]; then
        exit 1
    fi
}

cmd_safety_suite() {
    log_info "Running Safety Suite (Negative Tests)..."
    
    # Run in subshell to isolate mock
    (
        # Mock pve_exec
        pve_exec() {
            local cmd="$*"
            # Mock qm config
            if [[ "$cmd" == "qm config 9999" ]]; then
                echo "name: prod-vm-9999" # Missing tags
            elif [[ "$cmd" == "qm config 9010" ]]; then
                echo "name: lab-pve-9010"
                echo "ManagedBy=019a"
                echo "RunId=test"
            else
                # Default fail for others
                return 1
            fi
        }
        
        # Test 1: Check Safety on Prod VM (Should Fail)
        if check_safety 9999 "quiet"; then
            log_error "[FAIL] Safety Check passed for Prod VM (9999)"
            exit 1
        else
            log_info "[PASS] Safety Check blocked Prod VM (9999)"
        fi
        
        # Test 2: Check Safety on Valid Lab VM (Should Pass)
        if check_safety 9010 "quiet"; then
            log_info "[PASS] Safety Check allowed Lab VM (9010)"
        else
            log_error "[FAIL] Safety Check blocked Valid Lab VM (9010)"
            exit 1
        fi
        
        # Test 3: Check Safety on Out of Range (Should Fail)
        if check_safety 8000 "quiet"; then
             log_error "[FAIL] Safety Check passed for Out of Range (8000)"
             exit 1
        else
             log_info "[PASS] Safety Check blocked Out of Range (8000)"
        fi
    )
    
    if [[ $? -eq 0 ]]; then
        log_info "Safety Suite Passed."
        return 0
    else
        log_error "Safety Suite Failed."
        return 1
    fi
}

cmd_confidence_suite() {
    log_info "Running Confidence Suite (Full Validation)..."
    
    # 1. Safety Suite
    if ! cmd_safety_suite; then
        log_error "Confidence Suite Failed at Safety Step."
        exit 1
    fi
    
    # 2. Bootstrap Profile
    log_info "Confidence Suite: Running Bootstrap Profile..."
    if ! cmd_run --profile bootstrap; then
        log_error "Confidence Suite Failed at Bootstrap Profile."
        exit 1
    fi
    
    # 3. Control Plane Profile
    log_info "Confidence Suite: Running Hypervisor Control Plane Profile..."
    if ! cmd_run --profile hypervisor-control-plane; then
        log_error "Confidence Suite Failed at Control Plane Profile."
        exit 1
    fi
    
    # 4. Nested Workload Profile
    log_info "Confidence Suite: Running Hypervisor Nested Workload Profile..."
    if ! cmd_run --profile hypervisor-nested-workload; then
        log_error "Confidence Suite Failed at Nested Workload Profile."
        exit 1
    fi
    
    log_info "Confidence Suite Completed Successfully."
}

usage() {
    echo "Usage: $0 {up|down|destroy|status|test|run|safety|suite}"
    echo ""
    echo "Commands:"
    echo "  up       - Provision a new Lab VM (manual mode)"
    echo "  down     - Destroy all Lab VMs"
    echo "  status   - Check status of Lab VMs"
    echo "  test     - Run tests against existing Lab VM"
    echo "  run      - Full workflow: destroy -> up -> test -> destroy"
    echo "  safety   - Run Safety Suite (Negative Tests)"
    echo "  suite    - Run Confidence Suite (Safety + All Profiles)"
    echo ""
    echo "Run Options:"
    echo "  --profile <name>      Profile to run (bootstrap, hypervisor-control-plane, hypervisor-nested-workload)"
    echo "  --tier <1|2>          Target tier level (legacy)"
    echo "  --tier2-mode <mode>   Tier 2 verification mode (legacy)"
    echo "  --keep                Keep VM after run (don't destroy on exit)"
    exit 1
}

case "$1" in
    up) 
        # Manual up needs lock too? Maybe not strictly, but safer.
        # For now, only 'run' enforces strict lock, but 'up' should probably check it.
        cmd_up 
        ;;
    down|destroy) cmd_destroy ;;
    status) cmd_status ;;
    test) cmd_test ;;
    run) 
        shift
        cmd_run "$@" 
        ;;
    safety) cmd_safety_suite ;;
    suite) cmd_confidence_suite ;;
    *) usage ;;
esac
