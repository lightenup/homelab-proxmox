# Helper: Ingest Ansible Assertion Reports (019d)
ingest_ansible_reports() {
    local evidence_dir="$1"
    local report_pattern="$evidence_dir/reports/assertions.*.json"
    local catalog_path="$SCRIPT_DIR/checks.d/catalog.json"
    
    log_info "Ingesting Ansible assertion reports from $evidence_dir/reports..."
    
    # Check if any reports exist
    if [[ -z $(find "$evidence_dir/reports" -name "assertions.*.json" 2>/dev/null) ]]; then
        log_warn "No assertion reports found in $evidence_dir/reports"
        return 0
    fi
    
    for report_file in $evidence_dir/reports/assertions.*.json; do
        log_info "Processing report: $report_file"
        
        if ! command -v jq &> /dev/null; then
            log_warn "jq not found, skipping report ingestion"
            continue
        fi
        
        # Validate JSON structure
        if ! jq . "$report_file" >/dev/null 2>&1; then
            log_error "Invalid JSON in report: $report_file"
            continue
        fi
        
        # Read assertions array
        local count
        count=$(jq '.assertions | length' "$report_file")
        log_info "  Found $count assertions"
        
        # Extract phase from report
        local report_phase
        report_phase=$(jq -r '.phase // "unknown"' "$report_file")

        # Iterate using jq to output newline-delimited JSON objects
        while IFS= read -r item; do
            local id status description details severity catalog_phase
            # Normalize schema (handle both check_id/result and id/status formats)
            id=$(echo "$item" | jq -r '.check_id // .id')
            status=$(echo "$item" | jq -r '.result // .status')
            description=$(echo "$item" | jq -r '.title // .description')
            details=$(echo "$item" | jq -r '.reason // .details')

            # Pull severity and phase from catalog when available
            if [[ -f "$catalog_path" ]]; then
                catalog_phase=$(jq -r --arg id "$id" '.[$id].phase // ""' "$catalog_path" 2>/dev/null || echo "")
                severity=$(jq -r --arg id "$id" '.[$id].severity // ""' "$catalog_path" 2>/dev/null || echo "")
            fi
            [[ -z "$severity" || "$severity" == "null" ]] && severity="high"
            [[ -z "$catalog_phase" || "$catalog_phase" == "null" ]] && catalog_phase="$report_phase"
            
            # Set context for record_check
            export CURRENT_SOURCE="ansible"
            export CURRENT_PHASE="$catalog_phase"

            # Evidence: assertion report file relative to pack root
            local evidence_ref="reports/$(basename "$report_file")"

            # Map to record_check
            record_check "$id" \
                "$description" \
                "$severity" \
                "PASS" \
                "$status" \
                "$details" \
                "source: ansible" \
                "$evidence_ref"
                
        done < <(jq -c '.assertions[]' "$report_file")
    done
}

cmd_run() {
    # Defaults
    local tier=1
    local tier2_mode="min"
    local keep_vm=false
    local profile=""
    local verify_evidence=true
    
    # Parse args
    while [[ $# -gt 0 ]]; do
        case $1 in
            --profile) profile="$2"; shift ;;
            --tier) tier="$2"; shift ;;
            --tier2-mode) tier2_mode="$2"; shift ;;
            --keep) keep_vm=true ;;
            --verify) verify_evidence=true ;;
            --no-verify) verify_evidence=false ;;
            *) log_error "Unknown argument: $1"; exit 1 ;;
        esac
        shift
    done

    # 019c1 Phase 7: Legacy-to-Profile Mapping (T052, T053, T054)
    local legacy_mode_used=false
    
    # T053: Map legacy flags to profiles if --profile not explicitly set
    if [[ -z "$profile" ]]; then
        if [[ "$tier" == "2" ]]; then
            legacy_mode_used=true
            if [[ "$tier2_mode" == "plus" ]]; then
                profile="hypervisor-nested-workload"
            else
                profile="hypervisor-control-plane"
            fi
        fi
    fi
    
    # T054: Emit deprecation warning for legacy flags
    if [[ "$legacy_mode_used" == "true" ]]; then
        log_warn "⚠️  DEPRECATION NOTICE: --tier and --tier2-mode flags are deprecated"
        log_warn "   Please use: pve-lab suite $profile"
        log_warn ""
    fi

    # Apply Profile if set
    if [[ -n "$profile" ]]; then
        if ! parse_profile "$profile"; then
            exit 1
        fi
        tier=$PROFILE_TIER
        tier2_mode=$PROFILE_MODE
        PROFILE_ID="$profile"
        # Safety level will be used later
    else
        PROFILE_ID="custom"
    fi

    # Map Profile to Catalog Phase (019e1)
    local profile_phase="unknown"
    case "$PROFILE_ID" in
        "bootstrap")
            profile_phase="bootstrap"
            ;;
        "hypervisor-control-plane"|"hypervisor-nested-workload")
            profile_phase="tier2"
            ;;
        *)
            # Fallback or custom
            profile_phase="unknown"
            ;;
    esac
    export CURRENT_SOURCE="harness"
    # Preflight checks must record under bootstrap phase regardless of profile
    export CURRENT_PHASE="bootstrap"

    # Locking (flock)
    exec 200>"$LOCK_FILE"
    if [[ "${SKIP_LOCK:-false}" != "true" ]]; then
        if ! flock -n 200; then
            log_error "Another instance is running (Lock: $LOCK_FILE). Aborting."
            exit 1
        fi
    fi
    
    # 019c1: Create evidence pack with new runid format
    local run_id
    if [[ -n "${RUN_ID:-}" && -n "${ARTIFACT_DIR:-}" ]]; then
        run_id="$RUN_ID"
        log_info "Using existing evidence pack: $run_id"
    else
        run_id="$(create_evidence_pack "artifacts/019-lab")"
        export RUN_ID="$run_id"
        export ARTIFACT_DIR="artifacts/019-lab/${run_id}"
    fi
    
    # Export context for sub-functions and Ansible
    export RUN_ID="$run_id"
    export PROFILE_ID="${PROFILE_ID:-custom}"
    export EVIDENCE_DIR="$PWD/artifacts/019-lab/$run_id"

    # Legacy: Also set EVIDENCE_ROOT for backward compatibility
    evidence_init "$run_id" "${profile:-custom}"
    local artifact_dir="$EVIDENCE_ROOT"
    local summary_file="$artifact_dir/summary.json"
    local log_file="$artifact_dir/run.log"
    
    # 019c1: Initialize JSONL events
    init_jsonl_events "$artifact_dir/logs/events.jsonl"
    
    # Set Global ARTIFACT_DIR for logging
    export ARTIFACT_DIR="$artifact_dir"
    
    # Redirect output to log file and stdout
    exec > >(tee -a "$log_file") 2>&1
    
    log_info "Starting Lab Run: $run_id"
    log_info "Artifacts: $artifact_dir"
    log_info "Configuration: Tier=$tier, Mode=$tier2_mode, Keep=$keep_vm, Profile=${profile:-custom}"
    
    # 019c1 Phase 6: Generate provenance.json (T050)
    log_info "=== Capturing Provenance ==="
    
    # T047: Check and warn if git working tree is dirty
    check_git_dirty "$SCRIPT_DIR/.."
    
    # T045-T049: Generate complete provenance file
    local ssh_target="${SSH_USER}@${PROXMOX_HOST}"
    generate_provenance \
        "$artifact_dir/provenance.json" \
        "${profile:-custom}" \
        "$ssh_target" \
        "tier=$tier" \
        "mode=$tier2_mode" \
        "keep=$keep_vm" \
        "run_id=$run_id"
    
    log_info "Provenance captured: provenance.json"
    
    local start_time=$(date +%s)
    local status="FAILED"
    
    # --- 019c1: Preflight Environment Checks (ENV-001, ENV-002) ---
    log_info "=== Preflight Environment Checks ==="
    
    if ! check_env_001; then
        log_error "ENV-001 failed: Not a lab environment. Aborting."
        exit 1
    fi
    
    if ! check_env_002; then
        log_warn "ENV-002 failed: Insufficient resources. Continuing with caution..."
    fi
    
    log_info "=== Preflight Checks Complete ==="
    
    # 019c1: Emit phase event
    emit_phase_start "$run_id" "destroy-cleanup"
    
    # Ensure clean state (CLEANUP-PRE-001)
    if ! check_cleanup_pre_001; then
        log_error "CLEANUP-PRE-001 failed: Could not clean up stale resources. Aborting."
        exit 1
    fi
    
    emit_phase_complete "$run_id" "destroy-cleanup"

    # Switch to profile-mapped phase for provisioning/testing that follows
    export CURRENT_PHASE="$profile_phase"
    
    # Validate Safety Profile (FR-019c)
    if ! validate_safety_profile; then
        log_error "Safety Validation Failed. Aborting."
        exit 1
    fi
    
    # Trap to ensure destroy runs (unless keep_vm is set)
    if [[ "$keep_vm" == "true" ]]; then
        trap "log_info 'Keeping VM as requested (--keep).'" EXIT
    else
        trap "cmd_destroy" EXIT
    fi
    
    # 019c1: Emit phase event for provisioning
    emit_phase_start "$run_id" "vm-provision"
    
    if cmd_up "$run_id" "$tier"; then
        emit_phase_complete "$run_id" "vm-provision"
        
        # 019c1: Emit phase event for testing
        emit_phase_start "$run_id" "validation"
        
        if cmd_test "$tier" "$tier2_mode"; then
            status="SUCCESS"
        else
            log_error "Tests failed."
        fi
        
        emit_phase_complete "$run_id" "validation"
        
        # 019c1: Run guardrail checks (negative tests) - Phase 4 US2
        emit_phase_start "$run_id" "guardrails"
        log_info "Running guardrail checks (negative tests)..."
        
        if bash "${SCRIPT_DIR}/guardrails.sh" "$artifact_dir" "$run_id"; then
            log_info "Guardrail checks passed (all guards working)"
        else
            local guard_rc=$?
            if [[ $guard_rc -eq 2 ]]; then
                # Safety hole detected (negative test unexpectedly passed)
                log_error "CRITICAL: Safety hole detected in guardrail checks!"
                log_error "Suite aborting due to guardrail breach."
                emit_error "$run_id" "Guardrail safety hole detected - negative test unexpectedly passed"
                status="FAILED"
                # Check for any PASS results where FAIL was expected
                for check_json in "${CHECKS_ARRAY[@]}"; do
                    if echo "$check_json" | grep -q '"expected":"FAIL"' && echo "$check_json" | grep -q '"result":"PASS"'; then
                        local check_id=$(echo "$check_json" | grep -oP '"check_id":"\K[^"]+' || echo "UNKNOWN")
                        log_error "Check $check_id: Expected FAIL but got PASS (SAFETY HOLE)"
                    fi
                done
                # Mark suite as aborted
                SUITE_ABORT_REQUESTED=1
            else
                log_warn "Some guardrail checks could not be executed (non-critical)"
            fi
        fi
        
        emit_phase_complete "$run_id" "guardrails"
        
        # Abort if safety hole detected
        if [[ "${SUITE_ABORT_REQUESTED:-0}" -eq 1 ]]; then
            log_error "Suite aborted due to safety hole in guardrail checks"
            status="ABORTED"
        fi

        # Collect artifacts before teardown so SSH still succeeds (avoid "No route to host" post-destroy)
        if [[ "${SUITE_ABORT_REQUESTED:-0}" -ne 1 ]]; then
            collect_artifacts "$run_id"
        fi
        
        # 019c1: Run cleanup verification checks - Phase 5 US3
        if [[ "${SUITE_ABORT_REQUESTED:-0}" -ne 1 ]]; then
            # Switch to cleanup phase for checks
            export CURRENT_PHASE="cleanup"

            emit_phase_start "$run_id" "cleanup-verification"
            log_info "Running cleanup verification checks..."
            
            if [[ "$keep_vm" == "true" ]]; then
                # T043: --keep flag handler - skip cleanup checks with reason
                log_info "CLEANUP-001: SKIP (VM kept by operator)"
                record_check "CLEANUP-001" \
                    "No lab VMs remain in range after run" \
                    "medium" \
                    "PASS" \
                    "SKIP" \
                    "VM kept by operator (--keep flag)" \
                    "reports/vm_inventory.json"
                
                log_info "CLEANUP-002: SKIP (VM kept by operator)"
                record_check "CLEANUP-002" \
                    "No active locks remain after run" \
                    "medium" \
                    "PASS" \
                    "SKIP" \
                    "VM kept by operator (--keep flag)" \
                    "reports/lock_status.json"
            else
                # T038-T044: Run cleanup verification checks
                local ssh_target="${SSH_USER}@${PROXMOX_HOST}"
                local lock_dir="artifacts/019-lab"
                
                # Explicitly destroy resources before verification (T003)
                log_info "Teardown: Destroying lab resources..."
                cmd_destroy

                # CLEANUP-001: Verify no lab VMs remain
                log_info "CLEANUP-001: Checking for remaining lab VMs..."
                if check_no_lab_vms "$ssh_target" "$artifact_dir"; then
                    record_check "CLEANUP-001" \
                        "No lab VMs remain in range after run" \
                        "medium" \
                        "PASS" \
                        "PASS" \
                        "No VMs found in range 9000-9099" \
                        "reports/vm_inventory.json"
                else
                    record_check "CLEANUP-001" \
                        "No lab VMs remain in range after run" \
                        "medium" \
                        "PASS" \
                        "FAIL" \
                        "Lab VMs still present after cleanup" \
                        "reports/vm_inventory.json"
                    log_warn "CLEANUP-001 failed: VMs still present (non-critical)"
                fi
                
                # CLEANUP-002: Verify no active locks remain
                log_info "CLEANUP-002: Checking for active locks..."
                if check_no_active_locks "$lock_dir" "$artifact_dir"; then
                    record_check "CLEANUP-002" \
                        "No active locks remain after run" \
                        "medium" \
                        "PASS" \
                        "PASS" \
                        "No processes hold locks" \
                        "reports/lock_status.json"
                else
                    record_check "CLEANUP-002" \
                        "No active locks remain after run" \
                        "medium" \
                        "PASS" \
                        "FAIL" \
                        "Active locks detected after cleanup" \
                        "reports/lock_status.json"
                    log_warn "CLEANUP-002 failed: Active locks remain (non-critical)"
                fi
            fi
            
            emit_phase_complete "$run_id" "cleanup-verification"
        fi
    else
        log_error "Setup failed."
        emit_error "$run_id" "VM provisioning failed"
    fi
    
    local end_time=$(date +%s)
    local duration=$((end_time - start_time))
    
    # 019d: Ingest Ansible Reports
    ingest_ansible_reports "$artifact_dir"

    # 019c1: Generate checks.json
    local checks_file="$artifact_dir/checks.json"
    serialize_checks "$checks_file"
    log_info "Generated checks.json: $checks_file"
    
    # 019c1: Print console check summary
    print_check_summary
    
    # Generate Summary (019c1: updated with profile reference)
    cat <<JSON > "$summary_file"
{
  "contract_version": "1.0.0",
  "run_id": "$run_id",
  "status": "$status",
  "profile": "${profile:-custom}",
  "profile_id": "${PROFILE_ID:-unknown}",
  "tier": $tier,
  "tier2_mode": "$tier2_mode",
  "keep_vm": $keep_vm,
  "start_time": "$start_time",
  "end_time": "$end_time",
  "duration_seconds": $duration,
  "checks_file": "checks.json",
  "provenance_file": "provenance.json",
  "evidence_manifest_file": "evidence_manifest.json"
}
JSON
    
    log_info "Run completed with status: $status"
    
    # Finalize Evidence
    evidence_finalize "$status"
    
    # 019e1: Auto-Verification (FR-008)
    if [[ "$verify_evidence" == "true" ]]; then
        log_info "Running Evidence Verification..."
        if python3 "$SCRIPT_DIR/verify_evidence.py" "$artifact_dir" > "$artifact_dir/reports/verify.txt" 2>&1; then
            log_info "  Verification: PASS"
            # Append verification result to summary
            # Using temp file to avoid reading/writing same file with jq (if we had jq)
            # Since we don't assume jq, we'll just append a field if possible or leave it separate.
            # But spec says "record result in summary.json".
            # Let's just log it for now, or use a simple sed if we really need to inject it.
            # Actually, verify_evidence.py doesn't output JSON, it outputs text.
            # We can just save the report.
        else
            log_error "  Verification: FAIL"
            cat "$artifact_dir/reports/verify.txt"
            # If verification fails, we should probably fail the run if status was SUCCESS?
            # Spec says: "Given suite produces an invalid evidence pack... suite exits non-zero"
            if [[ "$status" == "SUCCESS" ]]; then
                status="FAILED_VERIFICATION"
                log_error "Run marked as FAILED due to verification errors."
                # Update summary status
                if command -v sed &>/dev/null; then
                    sed -i.bak 's/"status": "SUCCESS"/"status": "FAILED_VERIFICATION"/' "$summary_file" && rm "${summary_file}.bak"
                fi
            fi
        fi
    else
        log_warn "Verification skipped (--no-verify)"
    fi

    # Enforce Retention (FR-003)
    enforce_evidence_retention 5
    
    if [[ "$status" != "SUCCESS" ]]; then
        exit 1
    fi
}

cmd_safety_suite() {
    log_info "Running Safety Suite (Negative Tests)..."
    
    # Run in subshell to isolate mock
    (
        # Mock pve_exec
        pve_exec() {
            local cmd="$*"
            # Mock qm config
            if [[ "$cmd" == "qm config 9999" ]]; then
                echo "name: prod-vm-9999" # Missing tags
            elif [[ "$cmd" == "qm config 9010" ]]; then
                echo "name: lab-pve-9010"
                echo "ManagedBy=019a"
                echo "RunId=test"
            else
                # Default fail for others
                return 1
            fi
        }
        
        # Test 1: Check Safety on Prod VM (Should Fail)
        if check_safety 9999 "quiet"; then
            log_error "[FAIL] Safety Check passed for Prod VM (9999)"
            exit 1
        else
            log_info "[PASS] Safety Check blocked Prod VM (9999)"
        fi
        
        # Test 2: Check Safety on Valid Lab VM (Should Pass)
        if check_safety 9010 "quiet"; then
            log_info "[PASS] Safety Check allowed Lab VM (9010)"
        else
            log_error "[FAIL] Safety Check blocked Valid Lab VM (9010)"
            exit 1
        fi
        
        # Test 3: Check Safety on Out of Range (Should Fail)
        if check_safety 8000 "quiet"; then
             log_error "[FAIL] Safety Check passed for Out of Range (8000)"
             exit 1
        else
             log_info "[PASS] Safety Check blocked Out of Range (8000)"
        fi
    )
    
    if [[ $? -eq 0 ]]; then
        log_info "Safety Suite Passed."
        return 0
    else
        log_error "Safety Suite Failed."
        return 1
    fi
}

cmd_confidence_suite() {
    log_info "Running Confidence Suite (Full Validation)..."
    
    # 1. Safety Suite
    if ! cmd_safety_suite; then
        log_error "Confidence Suite Failed at Safety Step."
        exit 1
    fi
    
    # 2. Bootstrap Profile
    log_info "Confidence Suite: Running Bootstrap Profile..."
    if ! cmd_run --profile bootstrap; then
        log_error "Confidence Suite Failed at Bootstrap Profile."
        exit 1
    fi
    
    # 3. Control Plane Profile
    log_info "Confidence Suite: Running Hypervisor Control Plane Profile..."
    if ! cmd_run --profile hypervisor-control-plane; then
        log_error "Confidence Suite Failed at Control Plane Profile."
        exit 1
    fi
    
    # 4. Nested Workload Profile
    log_info "Confidence Suite: Running Hypervisor Nested Workload Profile..."
    if ! cmd_run --profile hypervisor-nested-workload; then
        log_error "Confidence Suite Failed at Nested Workload Profile."
        exit 1
    fi
    
    log_info "Confidence Suite Completed Successfully."
}

# 019c1: New suite command with profile-based execution
cmd_suite() {
    local profile_name="$1"
    shift
    
    if [[ -z "$profile_name" ]]; then
        log_error "Usage: $0 suite <profile-name>"
        log_error "Available profiles:"
        log_error "  - hypervisor-control-plane"
        log_error "  - hypervisor-nested-workload"
        exit 1
    fi
    
    # Load profile
    export PROFILES_DIR="${SCRIPT_DIR}/profiles.d"
    if ! load_profile "$profile_name"; then
        log_error "Failed to load profile: $profile_name"
        exit 1
    fi
    
    log_info "=== Suite Execution: $PROFILE_ID ==="
    log_info "Display Name: $DISPLAY_NAME"
    log_info "Safety Level: $SAFETY_LEVEL"
    log_info "Expected Duration: ${EXPECTED_DURATION_MINUTES} minutes"
    
    # Execute using cmd_run with --profile flag
    cmd_run --profile "$profile_name" "$@"
}

# 019e: Verify Evidence Pack
cmd_verify_evidence() {
    local pack_path="$1"
    if [[ -z "$pack_path" ]]; then
        log_error "Usage: $0 verify-evidence <path/to/evidence/pack>"
        exit 1
    fi
    
    if [[ ! -d "$pack_path" ]]; then
        log_error "Evidence pack not found: $pack_path"
        exit 1
    fi
    
    log_info "Verifying evidence pack: $pack_path"
    python3 "${SCRIPT_DIR}/verify_evidence.py" "$pack_path"
}

# 019e: Diff Evidence Packs
cmd_diff_evidence() {
    local run_a="$1"
    local run_b="$2"
    
    if [[ -z "$run_a" || -z "$run_b" ]]; then
        log_error "Usage: $0 diff-evidence <path/to/runA> <path/to/runB>"
        exit 1
    fi
    
    if [[ ! -d "$run_a" ]]; then
        log_error "Evidence pack A not found: $run_a"
        exit 1
    fi
    
    if [[ ! -d "$run_b" ]]; then
        log_error "Evidence pack B not found: $run_b"
        exit 1
    fi
    
    log_info "Diffing evidence packs: $run_a vs $run_b"
    python3 "${SCRIPT_DIR}/diff_evidence.py" "$run_a" "$run_b"
}

usage() {
    echo "Usage: $0 {up|down|destroy|status|test|run|safety|confidence|suite|verify-evidence|diff-evidence}"
    echo ""
    echo "Commands:"
    echo "  up              - Provision a new Lab VM (manual mode)"
    echo "  down            - Destroy all Lab VMs"
    echo "  status          - Check status of Lab VMs"
    echo "  test            - Run tests against existing Lab VM"
    echo "  run             - Full workflow: destroy -> up -> test -> destroy"
    echo "  safety          - Run Safety Suite (Negative Tests)"
    echo "  confidence      - Run Confidence Suite (Safety + All Profiles)"
    echo "  suite <profile> - Run specific profile suite (019c1 primary interface)"
    echo "  rebuild         - Run Rebuild Orchestrator (Baseline + Suite) (019f)"
    echo "  verify-evidence <path> - Verify an evidence pack (019e)"
    echo "  diff-evidence <runA> <runB> - Compare two evidence packs (019e)"
    echo ""
    echo "Suite Profiles (019c1):"
    echo "  hypervisor-control-plane   - PVE install + API verification"
    echo "  hypervisor-nested-workload - Full validation with nested VMs"
    echo ""
    echo "Run Options:"
    echo "  --profile <name>      Profile to run (bootstrap, hypervisor-control-plane, hypervisor-nested-workload)"
    echo "  --tier <1|2>          Target tier level (DEPRECATED - use --profile)"
    echo "  --tier2-mode <mode>   Tier 2 verification mode (DEPRECATED - use --profile)"
    echo "  --keep                Keep VM after run (don't destroy on exit)"
    echo "  --verify              Run evidence verification (default)"
    echo "  --no-verify           Skip evidence verification"
    exit 1
}

case "$1" in
    up) 
        # Manual up needs lock too? Maybe not strictly, but safer.
        # For now, only 'run' enforces strict lock, but 'up' should probably check it.
        cmd_up 
        ;;
    down|destroy) cmd_destroy ;;
    status) cmd_status ;;
    test) cmd_test ;;
    run) 
        shift
        cmd_run "$@" 
        ;;
    safety) cmd_safety_suite ;;
    confidence) cmd_confidence_suite ;;
    suite)
        shift
        cmd_suite "$@"
        ;;
    rebuild)
        shift
        cmd_rebuild "$@"
        ;;
    verify-evidence)
        shift
        cmd_verify_evidence "$@"
        ;;
    diff-evidence)
        shift
        cmd_diff_evidence "$@"
        ;;
    *) usage ;;
esac
