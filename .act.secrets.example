# Secrets for local `act` runs (do not commit real values)
#
# Usage:
#   cp .act.secrets.example .act.secrets
#   act workflow_dispatch -W .github/workflows/proxmox-apply.yml -j apply \
#     --secret-file .act.secrets \
#     --container-options "-v $(pwd)/.act-ssh:/root/.ssh:ro"
#
# LXC service deploy (gated) example:
#   cat > /tmp/act-lxc-deploy-lab.json <<'JSON'
#   {
#     "inputs": { "environment": "lab", "service": "jellyfin", "confirm": "", "confirm_destructive": "" }
#   }
#   JSON
#   act workflow_dispatch -W .github/workflows/lxc-deploy.yml -j plan \
#     -e /tmp/act-lxc-deploy-lab.json \
#     --secret-file .act.secrets \
#     --container-options "-v $(pwd)/.act-ssh:/root/.ssh:ro"
#
# Required for the Proxmox lab apply (Ansible Vault encrypted vars):
ANSIBLE_VAULT_PASSWORD=
