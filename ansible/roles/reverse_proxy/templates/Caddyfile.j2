{
{% if (deploy_environment | default('prod')) == 'lab' %}
    # LAB (067): no DNS-provider credential and no certificate authority traffic; a lab copy
    # signs its own certificates.
    local_certs
{% else %}
    acme_dns {{ caddy_acme_dns_provider }} {$DOMENESHOP_API_TOKEN} {$DOMENESHOP_API_SECRET}
{% endif %}
{% if caddy_metrics_enabled | default(false) %}
    servers {
        metrics
    }
{% endif %}
    log {
        output stdout
    }
}

{% if caddy_metrics_enabled | default(false) %}
:{{ caddy_metrics_port }} {
    metrics /metrics
}

{% endif %}
# Plain-HTTP health endpoint for the gated-deploy healthcheck (dedicated
# port bypasses the automatic :80 -> :443 redirect).
:{{ caddy_health_port | default(2021) }} {
    respond /healthz "OK" 200
}

import {{ caddy_conf_dir }}/*.caddy
