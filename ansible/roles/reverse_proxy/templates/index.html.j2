<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ caddy_base_domain }}</title>
  {# Favicon: hus-sky = "house-sky" — a house nestled inside a mountain (negative space). #}
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%237c7cff'/%3E%3Cpath d='M3 26 L16 6 L29 26 Z' fill='%23ffffff'/%3E%3Cpath d='M9 20 L16 14 L23 20 Z' fill='%237c7cff'/%3E%3Crect x='10' y='20' width='12' height='6' fill='%237c7cff'/%3E%3C/svg%3E">
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      font-family: system-ui, sans-serif;
      max-width: 900px;
      margin: 2rem auto;
      padding: 0 1rem;
      background: #f9f9fb;
      color: #1a1a2e;
    }
    h1 { margin-bottom: 1.5rem; font-size: 1.6rem; }
    .cards {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      gap: 1rem;
    }
    .card {
      background: #fff;
      border: 1px solid #e0e0e8;
      border-radius: 10px;
      padding: 1.1rem 1.2rem;
      text-decoration: none;
      color: inherit;
      display: block;
      transition: border-color 0.15s, box-shadow 0.15s;
    }
    .card:hover { border-color: #7c7cff; box-shadow: 0 2px 8px rgba(0,0,0,0.08); }
    .card h2 { margin: 0 0 0.3rem; font-size: 1.05rem; }
    .card p  { margin: 0 0 0.7rem; color: #555; font-size: 0.88rem; min-height: 1.2em; }
    .health {
      display: inline-block;
      font-size: 0.75rem;
      font-weight: 600;
      padding: 0.2rem 0.55rem;
      border-radius: 5px;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }
    .health[data-state="up"]      { background: #d4f5e2; color: #1a6640; }
    .health[data-state="down"]    { background: #fde0e0; color: #891515; }
    .health[data-state="unknown"] { background: #ebebf0; color: #5a5a6e; }
  </style>
</head>
<body>
  <h1>{{ caddy_base_domain }}</h1>
  <div class="cards">
{% for svc in caddy_services | selectattr('enabled') | selectattr('user_facing') %}
    <a class="card"
       href="{{ svc.link | default('https://' + svc.host + '.' + caddy_base_domain) }}"
       data-probe="https://{{ svc.host }}.{{ caddy_base_domain }}">
      <h2>{{ svc.title | default(svc.host | capitalize) }}</h2>
      <p>{{ svc.desc | default('') }}</p>
      <span class="health" data-state="unknown">unknown</span>
    </a>
{% endfor %}
{# Landing-only entries: a tile, but no vhost and no route. The loop above iterates
   caddy_services, every enabled member of which is publicly reverse-proxied; these are
   deliberately excluded from that list so nothing routes to them. See caddy_landing_links
   in group_vars/services/vars.yml. #}
{% for extra in caddy_landing_links | default([]) | selectattr('enabled') %}
    <a class="card" href="{{ extra.link }}"{% if extra.probe is defined %} data-probe="{{ extra.probe }}"{% endif %}>
      <h2>{{ extra.title }}</h2>
      <p>{{ extra.desc | default('') }}</p>
{% if extra.probe is defined %}
      <span class="health" data-state="unknown">unknown</span>
{% endif %}
    </a>
{% endfor %}
  </div>
  <script>
  (function () {
    function update() {
      fetch('/api/status')
        .then(function (r) { return r.ok ? r.json() : Promise.reject(); })
        .then(function (data) {
          var results = (data.data && data.data.result) || [];
          var map = {};
          results.forEach(function (r) { map[r.metric.instance] = r.value[1]; });
          document.querySelectorAll('[data-probe]').forEach(function (card) {
            var probe = card.getAttribute('data-probe');
            var badge = card.querySelector('.health');
            var v = map[probe];
            var state = v === '1' ? 'up' : v === '0' ? 'down' : 'unknown';
            badge.setAttribute('data-state', state);
            badge.textContent = state;
          });
        })
        .catch(function () {
          // Prometheus unreachable: degrade every card back to unknown (FR-010).
          document.querySelectorAll('.health').forEach(function (badge) {
            badge.setAttribute('data-state', 'unknown');
            badge.textContent = 'unknown';
          });
        });
    }
    update();
    setInterval(update, 30000);
  })();
  </script>
</body>
</html>
