# {{ ansible_managed }}
# systemd service unit for Proxmox configuration backup
# Feature: 013-proxmox-config-backup
# File: /etc/systemd/system/proxmox-backup.service

[Unit]
Description=Proxmox Configuration Backup
Documentation=file:///usr/local/share/doc/proxmox-backup/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart={{ proxmox_backup_script_path }}
User=root
Group=root

# Security hardening
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths={{ proxmox_backup_staging_base }} {{ proxmox_backup_nas_mount_point }}

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=proxmox-backup

# Timeout (max 1 hour for backup)
TimeoutStartSec=3600

[Install]
WantedBy=multi-user.target
