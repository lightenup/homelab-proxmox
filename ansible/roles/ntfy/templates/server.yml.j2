# ntfy server configuration
# Feature: 082-ntfy-push-service
# Generated by Ansible - DO NOT EDIT MANUALLY
#
# Contract: specs/082-ntfy-push-service/contracts/server-config.md
# Keys under "Forbidden" in that contract must never appear here (FR-004, R-009);
# preflight asserts this after rendering.
base-url: https://ntfy.{{ caddy_base_domain }}
listen-http: ":80"
behind-proxy: true
metrics-listen-http: ":9090"
cache-file: /var/lib/ntfy/cache.db
cache-duration: "72h"
auth-file: /var/lib/ntfy/user.db
auth-default-access: deny-all
auth-users:
  - "owner:{{ ntfy_owner_password_hash }}:user"
{% for user in ntfy_users %}
  - "{{ user.name }}:{{ user.password_hash }}:user"
{% endfor %}
auth-access:
  - "owner:*:read-only"
{% for user in ntfy_users %}
  - "{{ user.name }}:{{ user.topic }}:write-only"
{% endfor %}
auth-tokens:
  - "owner:{{ ntfy_owner_token }}:owner-phone"
{% for user in ntfy_users %}
  - "{{ user.name }}:{{ user.token }}:{{ user.name }}"
{% endfor %}
template-dir: /etc/ntfy/templates
message-size-limit: "32k"
