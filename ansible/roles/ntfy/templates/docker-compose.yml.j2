# ntfy Docker Compose Stack
# Feature: 082-ntfy-push-service
# Generated by Ansible - DO NOT EDIT MANUALLY
#
# Contract: specs/082-ntfy-push-service/contracts/server-config.md § Compose shape.
# No secrets in this file (R-011): credentials live in server.yml (mode 0600),
# rendered from vault on every deploy.

services:
  ntfy:
    container_name: ntfy
    image: {{ ntfy_image }}:{{ ntfy_version }}
    command: serve
    ports:
      - "{{ ntfy_port }}:80"
      - "{{ ntfy_metrics_port }}:9090"
    volumes:
      - "{{ ntfy_install_dir }}/server.yml:/etc/ntfy/server.yml:ro"
      - "{{ ntfy_install_dir }}/templates:/etc/ntfy/templates:ro"
      - "{{ ntfy_data_dir }}:/var/lib/ntfy"
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "wget", "-q", "--spider", "http://localhost/v1/health"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 15s
