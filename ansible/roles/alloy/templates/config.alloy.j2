// Alloy collector pipeline, spec 092 (contracts/log-pipeline.md C3, plan "Collector role").
// Generated by Ansible — DO NOT EDIT MANUALLY.
//
// journal -> loki.relabel (env/host/service/source/ident/unit) -> loki.process "redact"
// docker (if alloy_docker_logs) -> discovery.docker -> loki.source.docker -> redact
// files (for alloy_file_logs) -> local.file_match -> loki.source.file -> redact
// pve only: loki.process "oom" extracts the LXC name from the kernel's oom-kill: line
// redact = stage.limit (per-host throttle, drop=false) -> one stage.replace per
//          alloy_redaction_patterns -> loki.write (max_backoff_retries = 0)
// relay (monitoring only): loki.source.api on :{{ alloy_relay_port }} -> loki.write 127.0.0.1:3100

loki.write "default" {
  endpoint {
    url                 = "{{ alloy_relay | ternary(alloy_local_loki_url, alloy_push_url) }}"
    max_backoff_retries = 0
  }
}

loki.process "redact" {
  forward_to = [loki.write.default.receiver]

  stage.static_labels {
    values = {
      env     = "prod",
      host    = "{{ inventory_hostname }}",
      service = "{{ 'proxmox' if inventory_hostname in groups['proxmox_hosts'] | default([]) else inventory_hostname }}",
    }
  }

  // Per-host throttle (research R9): excess lines queue on the host's own disk, nothing is
  // dropped (drop = false). Well over 100x the busiest host's average line rate.
  stage.limit {
    rate  = {{ alloy_rate_limit }}
    burst = {{ alloy_rate_burst }}
    drop  = false
  }

{% for p in alloy_redaction_patterns %}
  // {{ p.name }}
  stage.replace {
    expression = {{ p.expression | to_json }}
    replace    = "<redacted>"
  }
{% endfor %}
}

loki.relabel "journal" {
  forward_to = []

  rule {
    source_labels = ["__journal__systemd_unit"]
    regex         = "(.+\\.service)"
    target_label  = "unit"
  }

  rule {
    source_labels = ["__journal_syslog_identifier"]
    target_label  = "ident"
  }

  rule {
    target_label = "source"
    replacement  = "journal"
  }
}

loki.source.journal "journal" {
  max_age       = "{{ alloy_journal_max_age }}"
  relabel_rules = loki.relabel.journal.rules
{% if inventory_hostname in groups['proxmox_hosts'] | default([]) %}
  forward_to    = [loki.process.oom.receiver]
{% else %}
  forward_to    = [loki.process.redact.receiver]
{% endif %}
}

{% if inventory_hostname in groups['proxmox_hosts'] | default([]) %}
// OOM kill name mapping (research R6). alloy_vmid_names is set at deploy from `pct list`
// (tasks/main.yml), VMID (string) -> LXC name. Falls back to the VMID for an unknown VMID
// and to "host" for a non-LXC cgroup.
{% set vmid_map = alloy_vmid_names | default({}) %}
{% set go_lines = [] %}
{% for vmid in vmid_map %}
{% if loop.first %}
{% set _ = go_lines.append('{{ if eq .vmid "' ~ vmid ~ '" }}' ~ vmid_map[vmid]) %}
{% else %}
{% set _ = go_lines.append('{{ else if eq .vmid "' ~ vmid ~ '" }}' ~ vmid_map[vmid]) %}
{% endif %}
{% endfor %}
{% if vmid_map | length > 0 %}
{% set _ = go_lines.append('{{ else if .vmid }}{{ .vmid }}{{ else }}host{{ end }}') %}
{% else %}
{% set _ = go_lines.append('{{ if .vmid }}{{ .vmid }}{{ else }}host{{ end }}') %}
{% endif %}
{% set oom_go_template = go_lines | join('') %}
loki.process "oom" {
  forward_to = [loki.process.redact.receiver]

  stage.match {
    selector = "{ident=\"kernel\"} |= \"oom-kill:\""

    stage.regex {
      expression = "task_memcg=/lxc/(?P<vmid>[0-9]+)/"
    }

    stage.template {
      source   = "lxc"
      template = {{ oom_go_template | to_json }}
    }

    stage.structured_metadata {
      values = { lxc = "" }
    }
  }
}
{% endif %}

{% if alloy_docker_logs %}
discovery.docker "local" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "docker" {
  targets = discovery.docker.local.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }

  rule {
    target_label = "source"
    replacement  = "docker"
  }
}

loki.source.docker "docker" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.docker.output
  forward_to = [loki.process.redact.receiver]
}
{% endif %}

{% for f in alloy_file_logs %}
local.file_match "file_{{ loop.index }}" {
  path_targets = [{"__path__" = {{ f.path_glob | to_json }}, "source" = "file"}]
}

loki.source.file "file_{{ loop.index }}" {
  targets       = local.file_match.file_{{ loop.index }}.targets
  tail_from_end = {{ f.tail_from_end | default(false) | lower }}
  forward_to    = [loki.process.redact.receiver]
}
{% endfor %}

{% if alloy_relay %}
// Push-only relay on :{{ alloy_relay_port }} -> host-local Loki (FR-013, R4). The relay keeps
// incoming labels and timestamps, and does NOT go through redact: senders already redacted.
loki.source.api "relay" {
  http {
    listen_address = "0.0.0.0"
    listen_port = {{ alloy_relay_port }}
  }
  use_incoming_timestamp = true
  forward_to = [loki.write.default.receiver]
}
{% endif %}
