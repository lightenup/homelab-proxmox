# Memory Docker Compose Stack
# Feature: 097-hermes-long-term-memory
# Generated by Ansible - DO NOT EDIT MANUALLY
#
# No secrets in this file: they live in server.env and db.env (both 0600). Log rotation comes
# from the Docker daemon options (spec 089), as for every other stack.

services:
  memory_postgres:
    container_name: memory_postgres
    image: {{ memory_postgres_image }}
    env_file: db.env
    volumes:
      - "{{ memory_data_dir }}/postgres:/var/lib/postgresql/data"
    restart: unless-stopped
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U hindsight -d hindsight"]
      interval: 10s
      timeout: 5s
      retries: 10

  memory_api:
    container_name: memory_api
    image: {{ memory_api_image }}
    env_file: server.env
    volumes:
      # The policy module and shim (R-001): code mounted read-only, the image stays stock.
      - "{{ memory_ext_dir }}:{{ memory_ext_dir }}:ro"
      - "{{ memory_install_dir }}/clients.json:/run/memory/clients.json:ro"
    # memory_ip only: Caddy, Prometheus and the health check reach it there (FR-010).
    ports:
      - "{{ memory_ip }}:{{ memory_api_port }}:8888"
    restart: unless-stopped
    depends_on:
      memory_postgres:
        condition: service_healthy
    healthcheck:
      test: ["CMD-SHELL", "python -c \"import urllib.request;urllib.request.urlopen('http://localhost:8888/health',timeout=3)\""]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 60s

  # The web UI (R-020, FR-023): its own container, so it shares neither the API's environment
  # (gateway key, database password) nor its memory budget or restarts. It reaches the API on
  # the compose network and holds only its login key and the curator key (ui.env).
  memory_ui:
    container_name: memory_ui
    image: {{ memory_ui_image }}
    env_file: ui.env
    environment:
      HINDSIGHT_CP_DATAPLANE_API_URL: http://memory_api:8888
    ports:
      - "{{ memory_ip }}:{{ memory_ui_port }}:9999"
    mem_limit: 384m
    restart: unless-stopped
    depends_on:
      memory_api:
        condition: service_healthy
