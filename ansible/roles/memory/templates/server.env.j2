# Hindsight server environment (spec 097, research R-004)
# Generated by Ansible - DO NOT EDIT MANUALLY
# Mode 0600: holds the database password and the gateway key.
#
# Verbatim chunks, no LLM: retain stores turn text as-is and nothing on this server calls a
# chat model (FR-003, FR-004). Embeddings and rerank go to the gateway with the memory key,
# which the gateway scopes to those two aliases (R-011).
HINDSIGHT_API_DATABASE_URL=postgresql://hindsight:{{ memory_db_password }}@memory_postgres:5432/hindsight
HINDSIGHT_API_RETAIN_EXTRACTION_MODE=chunks
HINDSIGHT_API_ENABLE_OBSERVATIONS=false
HINDSIGHT_API_ENABLE_AUTO_CONSOLIDATION=false
HINDSIGHT_API_LLM_PROVIDER=none
HINDSIGHT_API_EMBEDDINGS_PROVIDER=openai
HINDSIGHT_API_EMBEDDINGS_OPENAI_BASE_URL=http://{{ llm_router_ip }}:{{ llm_router_port }}/v1
HINDSIGHT_API_EMBEDDINGS_OPENAI_API_KEY={{ llm_router_client_memory_key }}
HINDSIGHT_API_EMBEDDINGS_OPENAI_MODEL=hermes-embed
# A known dimension skips the startup probe, so the server starts with the gateway down.
HINDSIGHT_API_EMBEDDINGS_OPENAI_DIMENSIONS=1024
HINDSIGHT_API_RERANKER_PROVIDER=litellm
HINDSIGHT_API_RERANKER_LITELLM_API_BASE=http://{{ llm_router_ip }}:{{ llm_router_port }}
HINDSIGHT_API_RERANKER_LITELLM_API_KEY={{ llm_router_client_memory_key }}
HINDSIGHT_API_RERANKER_LITELLM_MODEL=hermes-rerank
HINDSIGHT_API_MCP_ENABLED_TOOLS={{ memory_mcp_enabled_tools | join(',') }}
HINDSIGHT_API_METRICS_BACKLOG_ENABLED=true
# The web UI runs in its own container (memory_ui), never inside the API's (R-020).
HINDSIGHT_ENABLE_CP=false
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
# Per-client keys and scopes (R-001): shim.py translates, memory_access.py decides.
HINDSIGHT_API_TENANT_EXTENSION=shim:ClientKeyTenantExtension
HINDSIGHT_API_TENANT_CLIENTS_FILE=/run/memory/clients.json
HINDSIGHT_API_OPERATION_VALIDATOR_EXTENSION=shim:ClientScopeValidator
HINDSIGHT_API_OPERATION_VALIDATOR_CLIENTS_FILE=/run/memory/clients.json
PYTHONPATH={{ memory_ext_dir }}
