# Hindsight web UI (spec 097, research R-020). Generated by Ansible - DO NOT EDIT MANUALLY.
# Mode 0600. The login key gates every page; without it upstream serves the UI open, so the
# preflight refuses to deploy. The API key is the control-plane client's (scope curator): the
# UI calls the API server-side, and the browser never holds it.
HINDSIGHT_CP_ACCESS_KEY={{ memory_ui_access_key }}
HINDSIGHT_CP_DATAPLANE_API_KEY={{ memory_client_control_plane_key }}
