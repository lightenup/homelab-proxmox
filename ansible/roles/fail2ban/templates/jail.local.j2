# fail2ban jail configuration
# Feature: 042-monitoring-tier-c (FR-009, FR-010, FR-011, FR-012)
# Generated by Ansible - DO NOT EDIT MANUALLY

[DEFAULT]
banaction = iptables-multiport

{% for jail in fail2ban_jails %}
[{{ jail.name }}]
enabled = true
filter = {{ jail.filter | default(jail.name) }}
{% if jail.backend is defined %}
backend = {{ jail.backend }}
{% endif %}
{% if jail.logpath is defined %}
logpath = {{ jail.logpath }}
{% endif %}
maxretry = {{ jail.maxretry }}
bantime = {{ jail.bantime }}
findtime = {{ jail.findtime }}

{% endfor %}
