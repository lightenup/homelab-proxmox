# Home Assistant Docker Compose Stack
# Generated by Ansible - DO NOT EDIT MANUALLY
#
# network_mode: host so mDNS/SSDP discovery of Wi-Fi devices works; Home Assistant listens
# on :{{ homeassistant_port }} directly. Not privileged and no devices: there is no USB radio.

services:
  homeassistant:
    container_name: homeassistant
    image: {{ homeassistant_image }}:{{ homeassistant_version }}
    network_mode: host
    volumes:
      - "{{ homeassistant_config_dir }}:/config"
      - "/etc/localtime:/etc/localtime:ro"
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "curl", "-fsS", "-o", "/dev/null", "http://localhost:{{ homeassistant_port }}/manifest.json"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 180s
