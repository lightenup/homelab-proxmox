# Market Model Docker Compose Stack
# Generated by Ansible - DO NOT EDIT MANUALLY
#
# Two services from one image. Both ports are published directly on the LAN/tailnet.
# No GUI, no nginx, no auth gate (read/compute-only MCP).
# MARKET_MODEL_DB_PATH is intentionally unset — the app default /app/data/path-sets.sqlite
# resolves correctly given the bind-mount (D-007).

services:
  api:
    container_name: market_model_api
    image: {{ market_model_image }}:{{ market_model_version }}
    ports:
      - "{{ market_model_api_port }}:8000"
    volumes:
      - "{{ market_model_data_dir }}/data:/app/data"
      - "/etc/localtime:/etc/localtime:ro"
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "python", "-c", "import urllib.request; urllib.request.urlopen('http://localhost:8000/healthz')"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 20s

  mcp:
    container_name: market_model_mcp
    image: {{ market_model_image }}:{{ market_model_version }}
    command: ["python", "-m", "market_model.mcp.server"]
    ports:
      - "{{ market_model_mcp_port }}:8001"
    volumes:
      - "/etc/localtime:/etc/localtime:ro"
    environment:
      MCP_TRANSPORT: "http"
      MCP_PORT: "8001"
      API_BASE_URL: "http://api:8000"
    depends_on:
      api:
        condition: service_healthy
    restart: unless-stopped
    healthcheck:
      # FastMCP serves /mcp (not /health); a TCP connect is the available signal.
      test: ["CMD", "python", "-c", "import socket; socket.create_connection(('localhost', 8001), timeout=5).close()"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 20s
