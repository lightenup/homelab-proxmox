# Euro-Office Document Server Docker Compose Stack
# Generated by Ansible - DO NOT EDIT MANUALLY
#
# Runs the Euro-Office DocumentServer (AGPL fork of ONLYOFFICE 9.3.x) from its public GHCR image.
# The server bundles its own Postgres, RabbitMQ, and Redis internally.
# Documents are stored in Nextcloud; this container holds only caches and config.
# Port 80 is published (eurooffice_port = 80) so the LAN callback URL and Caddy
# upstream both resolve to http://<ip>/ without an explicit port.

services:
  documentserver:
    container_name: eurooffice
    image: {{ eurooffice_image }}:{{ eurooffice_version }}
    ports:
      - "{{ eurooffice_port }}:80"
    environment:
      JWT_ENABLED: "true"
      JWT_SECRET: "{{ eurooffice_jwt_secret }}"
      EXAMPLE_ENABLED: "false"
    volumes:
      - "{{ eurooffice_data_dir }}/data:/var/lib/euro-office/documentserver"
      - "{{ eurooffice_data_dir }}/logs:/var/log/euro-office/documentserver"
      - "{{ eurooffice_data_dir }}/config:/etc/euro-office/documentserver"
      - "/etc/localtime:/etc/localtime:ro"
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "curl", "-fsS", "http://localhost/healthcheck"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 60s
