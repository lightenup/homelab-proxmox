# Euro-Office Document Server Docker Compose Stack
# Generated by Ansible - DO NOT EDIT MANUALLY
#
# Runs the upstream ONLYOFFICE DocumentServer (Euro-Office 9.3.x is a fork of ONLYOFFICE 9.3.x;
# no Euro-Office Docker image is published — this uses the API-compatible upstream image).
# The server bundles its own Postgres, RabbitMQ, and Redis internally.
# Documents are stored in Nextcloud; this container holds only caches and config.
# Port 80 is published (eurooffice_port = 80) so the LAN callback URL and Caddy
# upstream both resolve to http://<ip>/ without an explicit port.

services:
  documentserver:
    container_name: eurooffice
    image: {{ eurooffice_image }}:{{ eurooffice_version }}
    ports:
      - "{{ eurooffice_port }}:80"
    environment:
      JWT_ENABLED: "true"
      JWT_SECRET: "{{ eurooffice_jwt_secret }}"
      EXAMPLE_ENABLED: "false"
    volumes:
      - "{{ eurooffice_data_dir }}/data:/var/www/onlyoffice/Data"
      - "{{ eurooffice_data_dir }}/logs:/var/log/onlyoffice"
      - "{{ eurooffice_data_dir }}/lib:/var/lib/onlyoffice"
      - "{{ eurooffice_data_dir }}/fonts:/usr/share/fonts/truetype/custom"
      - "/etc/localtime:/etc/localtime:ro"
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "curl", "-fsS", "http://localhost/healthcheck"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 60s
