# {{ ansible_managed }}
# Environment for alerting-heartbeat.service (role alerting_heartbeat). Holds the Pushover
# credentials: root-only (0600).
AM_URL={{ alerting_heartbeat_alertmanager_url }}
PUSHOVER_USER_KEY={{ alerting_heartbeat_pushover_user_key }}
PUSHOVER_API_TOKEN={{ alerting_heartbeat_pushover_api_token }}
STATE_DIR={{ alerting_heartbeat_state_dir }}
FAIL_THRESHOLD={{ alerting_heartbeat_fail_threshold }}
REPEAT_SECONDS={{ alerting_heartbeat_repeat_seconds }}
