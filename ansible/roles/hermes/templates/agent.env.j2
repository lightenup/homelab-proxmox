# Hermes agent environment — spec 083 (R-004, data-model.md § Agent secrets).
#
# DEPLOY-OWNED: rendered by Ansible from the vault on every deploy, mode 0600, owned by the
# agent's UID. Restores never bring this file back — the following deploy re-renders it
# (FR-010).
#
# HERMES_DASHBOARD MUST NOT appear here (FR-005): the dashboard only runs when it is set,
# and "not set" is what keeps it off. Do not add it.
#
# The NTFY_* block is appended at the end of this file by the US1 task (T021), guarded by
# hermes_agent_operational.

# API server (R-002): the OpenAI-compatible endpoint Open WebUI connects to. Bound inside
# the container's own network namespace; nothing is published to the host or LAN.
API_SERVER_ENABLED=true
API_SERVER_HOST=0.0.0.0
API_SERVER_KEY={{ hermes_agent_api_server_key }}

# Gateway client key (R-003): the variable name the custom provider reads its API key from
# (agent-config.yaml key_env). Minted by the llm_router role's virtual_keys.yml.
LLM_ROUTER_CLIENT_HERMES_AGENT_KEY={{ llm_router_client_hermes_agent_key }}

# Web search endpoint (R-005): the SearXNG sidecar, compose-network name.
SEARXNG_URL=http://searxng:8080

{% for server in hermes_mcp_servers | selectattr('enabled', 'defined') | selectattr('enabled') | selectattr('auth', 'equalto', 'bearer') | list %}
# MCP bearer token for {{ server.name }} (FR-011): referenced by name from
# agent-config.yaml's mcp_servers headers, resolved at connect time.
{{ server.credential_env }}={{ lookup('vars', server.credential_env | lower) }}
{% endfor %}
{% for name in hermes_agent_env_passthrough %}
# Job secret exposed to cron scripts by name (R-004, spec Edge Cases).
{{ name }}={{ lookup('vars', name | lower) }}
{% endfor %}
