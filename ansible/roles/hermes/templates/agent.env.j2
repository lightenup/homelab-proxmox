# Hermes agent environment — spec 083 (R-004, data-model.md § Agent secrets).
#
# DEPLOY-OWNED: rendered by Ansible from the vault on every deploy, mode 0600, owned by the
# agent's UID. Restores never bring this file back — the following deploy re-renders it
# (FR-010).
#
# HERMES_DASHBOARD MUST NOT appear here (FR-005): the dashboard only runs when it is set,
# and "not set" is what keeps it off. Do not add it.
#
# The NTFY_* block at the end carries the push channel (082). The token is rendered only when
# hermes_agent_operational (PROD): the LAB stage must never reach the phone (FR-014).

# API server (R-002): the OpenAI-compatible endpoint Open WebUI connects to. Bound inside
# the container's own network namespace; nothing is published to the host or LAN.
API_SERVER_ENABLED=true
API_SERVER_HOST=0.0.0.0
API_SERVER_KEY={{ hermes_agent_api_server_key }}

# Gateway client key (R-003): the variable name the custom provider reads its API key from
# (agent-config.yaml key_env). Minted by the llm_router role's virtual_keys.yml. Named so
# upstream strips it from job scripts and the terminal (research R-004 key-scope finding).
AUXILIARY_HERMES_API_KEY={{ llm_router_client_hermes_agent_key }}

# Web search endpoint (R-005): the SearXNG sidecar, compose-network name.
SEARXNG_URL=http://searxng:8080

{% for server in hermes_mcp_servers | selectattr('enabled', 'defined') | selectattr('enabled') | selectattr('auth', 'equalto', 'bearer') | list %}
# MCP bearer token for {{ server.name }} (FR-011): referenced by name from
# agent-config.yaml's mcp_servers headers, resolved at connect time.
{{ server.credential_env }}={{ lookup('vars', server.credential_env | lower) }}
{% endfor %}
{% for name in hermes_agent_env_passthrough %}
# Job secret exposed to cron scripts by name (R-004, spec Edge Cases).
{{ name }}={{ lookup('vars', name | lower) }}
{% endfor %}

# Push channel (082 publish + 095 inbound). Three branches, selected by inventory/stage:
#   PROD (hermes_agent_operational)      -> inbound hermes-in, publish hermes, PROD token.
#   LAB rig (lab_inventory)              -> scratch pair hermes-lab-in / hermes-lab, LAB token.
#   Pipeline LAB stage (anything else)   -> no NTFY_TOPIC, no NTFY_TOKEN: the ntfy platform
#       is disabled upstream (required_env=["NTFY_TOPIC"], adapter.py:362), which also ends
#       the anonymous 403 stream (083 FR-014, 095 FR-011).
# Inbound is read-only for this token: only the owner's token can write hermes-in
# (095 FR-002, contracts/acl-matrix.md). NTFY_ALLOWED_USERS is the *sender* allowlist and
# equals the topic name (R-003: the adapter receives the topic as the sender id).
# NTFY_ALLOW_ALL_USERS / GATEWAY_ALLOW_ALL_USERS must NEVER be set here (FR-003): a topic
# that can talk to the agent would be a shell credential.
NTFY_SERVER_URL=https://ntfy.{{ caddy_base_domain }}
NTFY_MARKDOWN=true
{% if hermes_agent_operational %}
NTFY_TOPIC=hermes-in
NTFY_ALLOWED_USERS=hermes-in
NTFY_PUBLISH_TOPIC=hermes
NTFY_HOME_CHANNEL=hermes
NTFY_TOKEN={{ ntfy_hermes_token }}
{% elif lab_inventory | default(false) | bool %}
NTFY_TOPIC=hermes-lab-in
NTFY_ALLOWED_USERS=hermes-lab-in
NTFY_PUBLISH_TOPIC=hermes-lab
NTFY_HOME_CHANNEL=hermes-lab
NTFY_TOKEN={{ ntfy_hermes_lab_token }}
{% else %}
# Pipeline LAB stage: platform off (no topic, no token) — never reaches the phone.
{% endif %}
