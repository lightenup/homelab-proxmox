# Hermes Docker Compose Stack — generated by Ansible. DO NOT EDIT MANUALLY.
#
# Three services (research R-005):
#   open-webui — the workspace itself, the only one published on the LAN (FR-001)
#   searxng    — self-hosted web search sidecar (FR-022), reachable only over the compose
#                network as `searxng` — never published, per data-model.md
#   hermes-agent — the stock agent runtime (spec 083): cron scheduler + API server on
#                :8642, reachable only over the `agent` network as `hermes-agent`.
#                NO published ports, no privileged, no cap_add, no Docker socket (FR-004,
#                FR-007). The egress allowlist (FR-008) filters its fixed source address.
#
# Networks: `default` is the original open-webui ↔ searxng topology, unchanged. `agent` is
# the agent's own subnet (fixed IP, IPv6 off). A service that lists ONLY `agent` in its
# `networks:` is silently removed from `default`, so open-webui and searxng list BOTH
# explicitly — that is what keeps the existing topology intact while letting them reach
# `hermes-agent:8642`.
#
# No application code here (FR-026) — every requirement is upstream Open WebUI/SearXNG
# configuration. Models are addressed as capability aliases through the 064 gateway only,
# never a provider model ID or the inference host directly (contracts/gateway-usage.md).
#
# TOOL_SERVER_CONNECTIONS (FR-012, FR-013) — Open WebUI's env-seeded tool-server list.
#
# The list is built as a fact in tasks/main.yml, NOT here, because the same value has a second
# consumer: the reconcile task that rewrites the persisted copy. Rendering it twice would let
# the two drift.
#
# This env var only ever seeds the FIRST boot. The key is a PersistentConfig, so after that
# the database wins and edits here are inert — see the reconcile task for the other half.
#
# Shape corrected 2026-09-21 after the original was silently ignored. Upstream gates listing
# on `config.enable` (routers/tools.py) and matches execution on `info.id`
# (utils/middleware.py); the first version used `enabled`/`id`/`name` at the top level and was
# dropped by both paths without an error.
#
# Note for whoever reads the logs: `Initialized 0 tool server(s)` at startup is EXPECTED and
# is not a fault. get_tool_servers_data handles `type: openapi` only, so it reports 0 even
# when MCP servers are registered correctly.

services:
  open-webui:
    container_name: hermes_open_webui
    image: {{ hermes_image }}:{{ hermes_version }}
    ports:
      - "{{ hermes_port }}:8080"
    volumes:
      - "{{ hermes_data_dir }}/open-webui:/app/backend/data"
      - "/etc/localtime:/etc/localtime:ro"
    environment:
      # --- Identity and origin ---
      WEBUI_SECRET_KEY: "{{ hermes_webui_secret_key }}"
      WEBUI_URL: "{{ hermes_public_url }}"
      # Drives the page title AND the PWA manifest's name/short_name (main.py builds the
      # manifest from app.state.WEBUI_NAME), which is what labels the phone home-screen icon.
      #
      # This renders as "Hermes (Open WebUI)", NOT "Hermes". Upstream appends the suffix
      # unconditionally to any custom value (env.py: `if WEBUI_NAME != 'Open WebUI':
      # WEBUI_NAME += ' (Open WebUI)'`). Removing it would mean patching the image, which
      # would ship bespoke code and breach FR-026 — so the suffix stays.
      #
      # Altering the branding at all is permitted here: their LICENSE restricts it only
      # above fifty users in a rolling period, and this deployment has exactly one account
      # (FR-003). Read from env.py on every boot rather than seeded into the database, so
      # this takes effect on redeploy instead of being silently overridden.
      WEBUI_NAME: "Hermes"

      # --- Auth (FR-002, FR-003, FR-004) — exactly one account, no self-registration.
      # WEBUI_ADMIN_EMAIL/PASSWORD create the admin from env on first boot (verified against
      # backend/open_webui/main.py's lifespan, 2026-09-20) and the app then flips
      # ui.enable_signup off itself; ENABLE_SIGNUP=False is asserted here too, in depth,
      # because that upstream auto-disable is a fallback, not the primary control.
      ENABLE_SIGNUP: "{{ hermes_enable_signup | lower }}"
      WEBUI_ADMIN_EMAIL: "{{ hermes_admin_email }}"
      WEBUI_ADMIN_PASSWORD: "{{ hermes_admin_password_bootstrap }}"

      # --- Gateway backend (FR-007) — the 064 gateway, one credential, never a raw model ID ---
      # Two connections (083 US2): the gateway at index 0 stays the default, the agent second.
      # Seeds a fresh deploy only; "Reconcile the Open WebUI model connections" owns them after.
      OPENAI_API_BASE_URLS: "{{ hermes_gateway_base_url }};{{ hermes_agent_api_base_url }}"
      OPENAI_API_KEYS: "{{ llm_router_client_hermes_key }};{{ hermes_agent_api_server_key }}"
      # Upstream enables an Ollama integration by default, pointed at
      # host.docker.internal:11434. Nothing here runs Ollama — every model arrives through the
      # 064 gateway (FR-007) — so it polled a host that does not exist and logged a connection
      # error every few minutes (10 since start, observed 2026-09-21). Noise that would mask a
      # real error, and an outbound integration enabled for no reason.
      ENABLE_OLLAMA_API: "False"

      # --- Housekeeping request volume (FR-011, research R-004) ---
      TASK_MODEL_EXTERNAL: "{{ hermes_task_alias }}"
      ENABLE_TITLE_GENERATION: "{{ hermes_enable_title_generation | lower }}"

      # --- Retrieval (FR-015, FR-016, research R-002) — embeddings AND reranking run on the
      # inference host, reached through the SAME gateway credential as chat. Both
      # RAG_OPENAI_* variables are set explicitly and unconditionally: they do NOT reliably
      # inherit from the OPENAI_API_* connection (upstream open-webui#22084) — left
      # unset, retrieval silently reaches api.openai.com. preflight.yml asserts this pair.
      RAG_EMBEDDING_ENGINE: "openai"
      RAG_EMBEDDING_MODEL: "{{ hermes_embedding_alias }}"
      # Upstream defaults to 1 — one gateway request per chunk, which exhausted the client's
      # 60 rpm allowance on a single 2.5MB PDF. See hermes_embedding_batch_size in group_vars
      # for the measurements. Seeds a fresh deploy; the reconcile task fixes existing ones.
      RAG_EMBEDDING_BATCH_SIZE: "{{ hermes_embedding_batch_size }}"
      RAG_OPENAI_API_BASE_URL: "{{ hermes_gateway_base_url }}"
      RAG_OPENAI_API_KEY: "{{ llm_router_client_hermes_key }}"
      ENABLE_RAG_HYBRID_SEARCH: "true"
      RAG_RERANKING_ENGINE: "external"
      RAG_RERANKING_MODEL: "{{ hermes_reranking_alias }}"
      # LiteLLM (064) serves rerank under /v1/rerank, not appended by the client — the full
      # URL is POSTed to as-is (verified against litellm/proxy/rerank_endpoints/endpoints.py
      # and open_webui/retrieval/models/external.py, 2026-09-20).
      RAG_EXTERNAL_RERANKER_URL: "{{ hermes_gateway_base_url }}/rerank"
      RAG_EXTERNAL_RERANKER_API_KEY: "{{ llm_router_client_hermes_key }}"

      # --- MCP tool servers (FR-012, FR-013) — see the note at the top of this file.
      TOOL_SERVER_CONNECTIONS: '{{ hermes_tool_server_connections | default([]) | to_json }}'

      # --- Web search (FR-022, research R-005) — the SearXNG sidecar, never a commercial API ---
      ENABLE_WEB_SEARCH: "true"
      WEB_SEARCH_ENGINE: "searxng"
      SEARXNG_QUERY_URL: "http://searxng:8080/search?q=<query>"

      # --- Voice (FR-023) — both directions fully in-container, so audio never leaves the
      # estate. AUDIO_STT_ENGINE is deliberately UNSET: Open WebUI's own default (empty
      # string) is local faster-whisper, not an external one (verified against
      # routers/audio.py, 2026-09-20). Setting it would only risk pointing it somewhere else.
      WHISPER_MODEL: "{{ hermes_whisper_model }}"
      AUDIO_TTS_ENGINE: "{{ hermes_tts_engine }}"

      # --- Programmatic interface (FR-024) — subject to the same auth as every other
      # surface: a per-user API key, never the bare endpoint (FR-002, FR-004).
      ENABLE_API_KEYS: "true"

      # --- Scheduled prompts — retired (083 US3, FR-015): the agent's scheduler is the one
      # place jobs run. Persisted as automations.enable, so hermes_managed_config owns it too.
      ENABLE_AUTOMATIONS: "false"
    restart: unless-stopped
    depends_on:
      - searxng
      - hermes-agent
    # Both networks, listed explicitly: `default` keeps the original topology, `agent`
    # reaches `hermes-agent:8642` (spec 083, US2). Listing only `agent` would silently drop
    # this service from `default`.
    networks:
      - default
      - agent
    # No explicit healthcheck: — the upstream image already declares one
    # (`curl --silent --fail http://localhost:8080/health | jq -ne 'input.status == true'`,
    # verified in its Dockerfile, 2026-09-20). Redeclaring it here would only risk drifting
    # from what the pinned image actually does.

  searxng:
    container_name: hermes_searxng
    image: {{ hermes_searxng_image }}:{{ hermes_searxng_version }}
    # No `ports:` — reachable only over the compose network as `searxng:8080`
    # (data-model.md, research R-005). Never published to the LAN.
    volumes:
      - "{{ hermes_searxng_install_dir }}/settings.yml:/etc/searxng/settings.yml:ro"
      - "/etc/localtime:/etc/localtime:ro"
    environment:
      SEARXNG_BASE_URL: "http://searxng:8080/"
      SEARXNG_SECRET: "{{ hermes_searxng_secret }}"
    restart: unless-stopped
    # Both networks, listed explicitly: `default` keeps the original topology, `agent` lets
    # the agent reach SearXNG (spec 083, R-005). Listing only `agent` would silently drop
    # this service from `default`.
    networks:
      - default
      - agent

  # Agent runtime (spec 083, R-002). `gateway run` hosts the cron scheduler and, with
  # API_SERVER_ENABLED, the API server on :8642. Nothing is published: the API server is
  # reached only over the `agent` network by Open WebUI, and the egress allowlist
  # (FR-008) filters this container's fixed source address.
  hermes-agent:
    container_name: hermes_agent
    image: {{ hermes_agent_image }}
    command: gateway run
    env_file:
      - "{{ hermes_agent_env_path }}"
    volumes:
      # Data (jobs, scripts, memory, scout state), owned by the agent's UID.
      - "{{ hermes_agent_data_dir }}:/opt/data"
      # Deploy-owned configuration, mounted READ-ONLY over the image's config path so the
      # agent cannot switch its own approvals off (FR-002, R-004).
      - "{{ hermes_agent_config_path }}:/opt/data/config.yaml:ro"
      # ntfy chunking shim (095 R-018), READ-ONLY for the same reason as config.yaml: the agent
      # can write /opt/data, so gateway-executed code must not live there writable. Overrides
      # the bundled ntfy adapter by directory name; enabled by plugins.enabled in config.yaml.
      - "{{ hermes_agent_plugins_dir }}/platforms/ntfy:/opt/data/plugins/platforms/ntfy:ro"
      # Heartbeat file for the scheduler watchdog (US4, R-007) — PROD only.
{% if hermes_agent_operational %}
      - "{{ hermes_agent_heartbeat_dir }}:/heartbeat"
{% endif %}
    # Inline, single use (Constitution IV): bounds a runaway agent turn so it cannot starve
    # Open WebUI's in-container Whisper/TTS on the shared LXC (R-002, SC-011).
    mem_limit: 3g
    # NO `ports:`, NO `privileged`, NO `cap_add`, NO Docker socket (FR-004, FR-007). The
    # post-render assertion in tasks/main.yml fails the deploy if any of these appear.
    restart: unless-stopped
    # The agent is ONLY on `agent`, never on `default` (R-008): its fixed address is what
    # the egress allowlist filters by.
    networks:
      agent:
        ipv4_address: "{{ hermes_agent_ip }}"
    healthcheck:
      test: ["CMD", "curl", "--silent", "--fail", "http://localhost:8642/health"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 60s

networks:
  default: {}
  agent:
    ipam:
      config:
        - subnet: "{{ hermes_agent_subnet }}"
    enable_ipv6: false
