# SearXNG settings — generated by Ansible. DO NOT EDIT MANUALLY.
#
# Sidecar for Hermes' web search (FR-022, research R-005) — never published to the LAN
# (data-model.md). `use_default_settings: true` pulls in SearXNG's full upstream engine
# list and overrides only what this feature needs: JSON output (Open WebUI reads results as
# JSON, not the HTML UI) and no public-instance features, since this instance has exactly
# one consumer on a private compose network.
use_default_settings: true

general:
  instance_name: "hermes-searxng"

search:
  formats:
    - html
    - json

server:
  # Overridden by SEARXNG_SECRET at runtime (docker-compose.yml.j2) — this literal is never
  # used, but SearXNG requires the key to be present in the file regardless.
  secret_key: "{{ hermes_searxng_secret }}"
  # No rate limiting: the only client is the Hermes container on the same private compose
  # network, not the public internet.
  limiter: false
  image_proxy: true
