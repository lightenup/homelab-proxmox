version: "3.8"

services:
  adguardhome:
    image: "{{ adguard_image }}:{{ adguard_image_tag }}"
    container_name: adguardhome
    restart: unless-stopped
    ports:
      - "{{ adguard_port_dns }}:53/tcp"
      - "{{ adguard_port_dns }}:53/udp"
      - "{{ adguard_port_http }}:80/tcp"
      - "{{ adguard_port_setup }}:3000/tcp"
    volumes:
      - "{{ adguard_work_dir }}:/opt/adguardhome/work"
      - "{{ adguard_conf_dir }}:/opt/adguardhome/conf"
    environment:
      TZ: "{{ adguard_timezone }}"
