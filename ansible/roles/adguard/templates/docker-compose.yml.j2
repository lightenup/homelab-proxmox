# AdGuard Exporter Docker Compose
# Feature: 041-monitoring-tier-b
# Generated by Ansible - DO NOT EDIT MANUALLY

services:
  adguard-exporter:
    image: ghcr.io/henrywhitaker3/adguard-exporter:{{ adguard_exporter_version }}
    container_name: adguard-exporter
    network_mode: host
    environment:
      ADGUARD_SERVERS: "http://127.0.0.1:3000"
      ADGUARD_USERNAMES: "{{ adguard_admin_user }}"
      ADGUARD_PASSWORDS: "{{ adguard_admin_password }}"
      INTERVAL: "{{ adguard_exporter_interval }}"
      PORT: "{{ adguard_exporter_port }}"
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "wget", "--quiet", "--tries=1", "--spider", "http://localhost:{{ adguard_exporter_port }}/metrics"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 15s
