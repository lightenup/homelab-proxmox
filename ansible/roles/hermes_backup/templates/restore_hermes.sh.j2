#!/bin/bash
set -euo pipefail

# Hermes restore — generated by Ansible. DO NOT EDIT MANUALLY.
#
# The other half of backup_hermes.sh. Written 2026-09-21, because the backup role had
# shipped without one: "a backup that has never been restored is a belief, not a backup"
# (spec 065, SC-006) is hard to act on when there is nothing to run.
#
#   restore_hermes.sh                  # restore the most recent archive
#   restore_hermes.sh <archive.tar.gz> # restore a specific one
#
# This REPLACES the live workspace. The current data directory is moved aside rather than
# deleted, so a restore that turns out to be the wrong archive is itself recoverable — see
# the path printed at the end. Nothing is removed automatically.
#
# For a NON-destructive check that an archive is good, use the restore drill instead:
#   ansible-playbook ansible/playbooks/hermes-restore-drill.yml
# That stands a second instance up on {{ hermes_restore_test_port }} and never touches this one.

BACKUP_DIR="{{ hermes_backup_path }}"
DATA_DIR="{{ hermes_data_dir }}/open-webui"
INSTALL_DIR="{{ hermes_install_dir }}"
TIMESTAMP=$(date +"%Y%m%d-%H%M%S")

ARCHIVE="${1:-}"
if [ -z "$ARCHIVE" ]; then
    ARCHIVE=$(ls -t "$BACKUP_DIR"/hermes-backup-*.tar.gz 2>/dev/null | head -n 1 || true)
fi

if [ -z "$ARCHIVE" ] || [ ! -f "$ARCHIVE" ]; then
    echo "ERROR: no backup archive found. Looked in $BACKUP_DIR" >&2
    exit 1
fi

echo "Restoring from: $ARCHIVE"

# Verify the archive BEFORE stopping anything. A corrupt archive discovered after the stack
# is down turns a restore into an outage.
TEMP_DIR=$(mktemp -d)
cleanup() { rm -rf "$TEMP_DIR"; }
trap cleanup EXIT

echo "Verifying archive..."
tar -tzf "$ARCHIVE" >/dev/null
tar -xzf "$ARCHIVE" -C "$TEMP_DIR"

EXTRACTED=$(find "$TEMP_DIR" -mindepth 1 -maxdepth 1 -type d | head -n 1)
if [ ! -f "$EXTRACTED/open-webui/webui.db" ]; then
    echo "ERROR: archive contains no open-webui/webui.db — refusing to restore." >&2
    exit 1
fi

# An archive can be intact as a tarball and still hold a torn database.
python3 - "$EXTRACTED/open-webui/webui.db" <<'PY'
import sqlite3, sys
db = sys.argv[1]
con = sqlite3.connect(db)
if con.execute('pragma integrity_check').fetchone()[0] != 'ok':
    sys.exit('ERROR: webui.db in the archive fails integrity_check — refusing to restore.')
chats = con.execute('select count(*) from chat').fetchone()[0]
users = con.execute('select count(*) from user').fetchone()[0]
print(f'  archive looks sound: {users} account(s), {chats} conversation(s)')
PY

echo "Stopping the stack..."
docker compose -f "$INSTALL_DIR/docker-compose.yml" stop

ASIDE="${DATA_DIR}.superseded-${TIMESTAMP}"
if [ -d "$DATA_DIR" ]; then
    echo "Moving the current workspace aside -> $ASIDE"
    mv "$DATA_DIR" "$ASIDE"
fi

echo "Installing the restored workspace..."
mkdir -p "$DATA_DIR"
tar -cf - -C "$EXTRACTED/open-webui" . | tar -xf - -C "$DATA_DIR"

# The model cache is deliberately absent from backups (re-downloadable). The app refetches
# what it needs on first use; the first voice request after a restore will be slow.

echo "Starting the stack..."
docker compose -f "$INSTALL_DIR/docker-compose.yml" up -d

echo "Waiting for health..."
for _ in $(seq 1 30); do
    if curl -fsS -o /dev/null "http://127.0.0.1:{{ hermes_port }}/health"; then
        echo "Restore complete and the workspace is healthy."
        echo "Previous workspace retained at: $ASIDE"
        echo "Remove it yourself once you are satisfied with the restore."
        exit 0
    fi
    sleep 5
done

echo "ERROR: restored but the workspace did not become healthy within 150s." >&2
echo "The previous workspace is still at: $ASIDE" >&2
exit 1
