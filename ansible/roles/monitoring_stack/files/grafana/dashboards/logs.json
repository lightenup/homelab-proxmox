    {
      "type": "logs",
      "id": 12,
      "title": "ntfy adapter messages",
      "description": "Warnings and errors from the Hermes ntfy adapter (container stdout carries WARNING and up): auth failures (401/403), stream drops, reconnects.",
      "datasource": {
