        }
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "sum by (host) (count_over_time({env=\"prod\", host=~\"$host\", ident=~\"sshd|sshd-session\"} |~ \"Failed password|Invalid user|authentication failure|Connection closed by authenticating\" [$__auto]))",
          "refId": "A",
          "queryType": "range",
          "legendFormat": "{{host}}"
        }
      ]
    },
    {
      "type": "logs",
      "id": 16,
      "title": "sudo commands",
      "description": "Who ran what as root. On pve this is mostly the ci account's allowlisted qm/pct calls.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 66,
        "w": 12,
        "h": 8
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "prettifyLogMessage": false
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "{env=\"prod\", host=~\"$host\", ident=\"sudo\"} |= \"COMMAND=\"",
          "refId": "A",
          "queryType": "range"
        }
      ]
    },
    {
      "type": "logs",
      "id": 17,
      "title": "Reverse proxy warnings and errors",
      "description": "Caddy's own warn/error lines (e.g. upstream aborted). Caddy access logging is not enabled, so per-request 4xx/5xx are not in Loki.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 12,
        "y": 66,
        "w": 12,
        "h": 8
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "prettifyLogMessage": false
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "{env=\"prod\", host=\"reverse_proxy\", ident=\"caddy\"} | json | level=~\"warn|error\" | line_format \"{{.level}} {{.logger}}: {{.msg}} {{.upstream}}\"",
          "refId": "A",
          "queryType": "range"
        }
      ]
    },
    {
      "type": "row",
      "id": 18,
      "title": "Backups and jobs",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 74,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 19,
      "title": "Backup unit outcomes per host",
      "description": "One mark per backup run: systemd's end state for each *-backup.service (service backups and the pve config backup). Debian's dpkg-db-backup.service is excluded.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 75,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            }
          },
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "sum by (host, outcome) (count_over_time({env=\"prod\", ident=\"systemd\"} |~ `-backup\\.service: (Deactivated successfully|Failed with result)` != \"dpkg-db-backup\" | regexp `: (?P<outcome>Deactivated successfully|Failed with result)` [$__auto]))",
          "refId": "A",
          "queryType": "range",
          "legendFormat": "{{host}}: {{outcome}}"
        }
      ]
    },
    {
      "type": "logs",
      "id": 20,
      "title": "Backup unit end states",
      "description": "'Deactivated successfully' = the run exited 0; 'Failed with result' = it did not.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 12,
        "y": 75,
        "w": 12,
        "h": 8
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "prettifyLogMessage": false
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "{env=\"prod\", ident=\"systemd\"} |~ `-backup\\.service: (Deactivated successfully|Failed with result)` != \"dpkg-db-backup\"",
          "refId": "A",
          "queryType": "range"
        }
      ]
    },
    {
      "type": "logs",
      "id": 21,
      "title": "Backup script output",
      "description": "Everything the backup scripts print: archive names, pruning, verification. Use 'search' to narrow (e.g. error|fail).",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 83,
        "w": 24,
        "h": 9
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "prettifyLogMessage": false
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
