          },
          "editorMode": "code",
          "expr": "{env=\"prod\", host=\"hermes\", container=\"hermes_agent\"} |= \"[Ntfy]\"",
          "refId": "A",
          "queryType": "range"
        }
      ]
    },
    {
      "type": "row",
      "id": 13,
      "title": "Security / access",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 57,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "logs",
