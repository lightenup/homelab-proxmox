      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "sum(count_over_time({env=\"prod\", host=\"hermes\", container=\"hermes_agent\"} |= \"Stream error\" [$__auto]))",
          "refId": "A",
