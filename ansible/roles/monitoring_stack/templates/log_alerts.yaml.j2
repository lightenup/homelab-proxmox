{% set disabled_entries = [] %}
{% for host in groups['all'] | default([]) %}
{% set contract = hostvars[host].monitoring_contract | default({}) %}
{% for rule in contract.log_alert_rules | default([]) %}
{% if not rule.enabled %}
{% set _ = disabled_entries.append({'host': host, 'rule': rule}) %}
{% endif %}
{% endfor %}
{% endfor %}
{% for entry in disabled_entries %}
# disabled: {{ entry.host }} {{ entry.rule.alert }} — {{ entry.rule.disabled_reason }}
{% endfor %}
{% set enabled_services = [] %}
{% for host in groups['all'] | default([]) %}
{% set contract = hostvars[host].monitoring_contract | default({}) %}
{% for rule in contract.log_alert_rules | default([]) %}
{% if rule.enabled %}
{% set _ = enabled_services.append({'host': host, 'rule': rule}) %}
{% endif %}
{% endfor %}
{% endfor %}
{# 1 KernelOomKill + 2 SshLoginNotAllowed (lxc, proxmox) + 2 SudoByUnexpectedUser (lxc, proxmox) #}
{% set log_rules_rendered_count = 5 + (enabled_services | length) %}
# rendered rules: {{ log_rules_rendered_count }}

{% macro ssh_rule(class, selector) %}
{% set entries = ssh_login_allowlist[class] %}
{% set clauses = [] %}
{% for e in entries %}
{% set users_re = e.users | join('|') %}
{% set keys_re = e['keys'] | map('regex_escape') | join('|') %}
{% set src_clauses = [] %}
{% if 'proxmox' in e.from %}
{% set _ = src_clauses.append('src != "' ~ proxmox_host_ip ~ '"') %}
{% endif %}
{% if 'lan' in e.from %}
{% set _ = src_clauses.append('src != ip("' ~ lan_cidr ~ '")') %}
{% endif %}
{% if 'tailnet' in e.from %}
{% set _ = src_clauses.append('src != ip("' ~ tailnet_cidr ~ '")') %}
{% endif %}
{% set src_clause = src_clauses | join(' and ') %}
{# fp uses backtick (raw-string) quoting: a double-quoted LogQL string processes backslash
   escapes, and regex_escape's output (e.g. SHA256:NH5z...\+jki...) is not valid there (R3). #}
{% set _ = clauses.append('| (user !~ "' ~ users_re ~ '" or fp !~ `^(' ~ keys_re ~ ')$` or (' ~ src_clause ~ '))') %}
{% endfor %}
      - alert: SshLoginNotAllowed
        expr: |
          sum by (host, user, src, method, fp) (count_over_time({env="prod", {{ selector }}, ident=~"sshd|sshd-session"} |= "Accepted " | regexp `Accepted (?P<method>\S+) for (?P<user>\S+) from (?P<src>\S+) port \d+ ssh2(?:: \S+ (?P<fp>SHA256:\S+))?` {{ clauses | join(' ') }} [5m])) > 0
        for: 0m
        labels:
          severity: warning
        annotations:
          summary: "{% raw %}Unexpected SSH login on {{ $labels.host }}: {{ $labels.user }} from {{ $labels.src }} ({{ $labels.method }} {{ $labels.fp }}){% endraw %}"
          description: >-
            A login matched no entry in ssh_login_allowlist.{{ class }} (data-model §4). A
            password login has no fingerprint and always alerts here. Check whether this is
            the owner on a new device or source, or an intrusion attempt.
{% endmacro %}
{% macro sudo_rule(class, selector) %}
      - alert: SudoByUnexpectedUser
        expr: |
          sum by (host, sudo_user) (count_over_time({env="prod", {{ selector }}, ident="sudo"} | regexp `^\s*(?P<sudo_user>\S+) : ` | sudo_user != "" | sudo_user != "{{ ssh_sudo_expected[class] }}" [5m])) > 0
        for: 0m
        labels:
          severity: warning
        annotations:
          summary: "{% raw %}Unexpected sudo on {{ $labels.host }} by {{ $labels.sudo_user }}{% endraw %}"
          description: >-
            sudo was run by a user other than the expected {{ ssh_sudo_expected[class] }} for
            this host class. PAM session lines are excluded by the sudo_user != "" filter
            (research R3).
{% endmacro %}
groups:
  - name: log_estate
    interval: 1m
    rules:
      - alert: KernelOomKill
        expr: |
          sum by (lxc, task) (count_over_time({env="prod", host="proxmox", ident="kernel"} |= "oom-kill:constraint=" | regexp "task=(?P<task>[^,]+)," [5m])) > 0
        for: 0m
        labels:
          severity: warning
        annotations:
          summary: "{% raw %}OOM kill in LXC {{ $labels.lxc }}: {{ $labels.task }}{% endraw %}"
          description: >-
            The kernel OOM-killed a process in this LXC. Check `journalctl -k -g oom-kill` on
            pve and the container's memory limit.
{{ ssh_rule('lxc', 'host!="proxmox"') }}
{{ ssh_rule('proxmox', 'host="proxmox"') }}
{{ sudo_rule('lxc', 'host!="proxmox"') }}
{{ sudo_rule('proxmox', 'host="proxmox"') }}
  - name: log_services
    interval: 1m
{% if enabled_services | length > 0 %}
    rules:
{% for entry in enabled_services %}
      - alert: {{ entry.rule.alert }}
        expr: |
          {{ entry.rule.expr | indent(10) }}
        for: {{ entry.rule.for }}
        labels:
          severity: {{ entry.rule.severity }}
          service: {{ entry.host }}
        annotations:
          summary: |-
            {{ entry.rule.summary }}
          description: |-
            {{ entry.rule.description }}
{% endfor %}
{% else %}
    rules: []
{% endif %}
