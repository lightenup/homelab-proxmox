#!/bin/bash
# Monitoring Stack Backup Script
# Feature: 017-synology-metrics
# Generated by Ansible - DO NOT EDIT MANUALLY
#
# Purpose: Daily backup of Prometheus TSDB and Grafana volumes to NAS
# Requirement: US5 - Daily automated backups with 30-day retention
# Schedule: Daily at {{ backup_schedule_hour }}:{{ '%02d' % backup_schedule_minute }} via cron

set -euo pipefail

# Configuration
BACKUP_DIR="{{ backup_path }}"
RETENTION_DAYS={{ backup_retention_days }}
TIMESTAMP=$(date +"%Y%m%d_%H%M%S")
BACKUP_FILE="monitoring_backup_${TIMESTAMP}.tar.gz"
LOG_FILE="/var/log/monitoring-backup.log"

# Docker volume names
PROMETHEUS_VOLUME="monitoring_prometheus_data"
GRAFANA_VOLUME="monitoring_grafana_data"
ALERTMANAGER_VOLUME="monitoring_alertmanager_data"

# Logging function
log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*" | tee -a "${LOG_FILE}"
}

log "Starting monitoring stack backup"

# Verify backup directory exists
if [ ! -d "${BACKUP_DIR}" ]; then
    log "ERROR: Backup directory ${BACKUP_DIR} does not exist. Ensure NAS mount is available."
    exit 1
fi

# Create temporary directory for backup staging
TEMP_DIR=$(mktemp -d)
trap "rm -rf ${TEMP_DIR}" EXIT

log "Backing up Docker volumes to ${TEMP_DIR}"

# Backup Prometheus data
log "Backing up Prometheus TSDB"
docker run --rm \
    -v ${PROMETHEUS_VOLUME}:/source:ro \
    -v ${TEMP_DIR}:/backup \
    debian:bookworm-slim \
    tar czf /backup/prometheus_data.tar.gz -C /source .

# Backup Grafana data
log "Backing up Grafana dashboards and datasources"
docker run --rm \
    -v ${GRAFANA_VOLUME}:/source:ro \
    -v ${TEMP_DIR}:/backup \
    debian:bookworm-slim \
    tar czf /backup/grafana_data.tar.gz -C /source .

# Backup Alertmanager data
log "Backing up Alertmanager state"
docker run --rm \
    -v ${ALERTMANAGER_VOLUME}:/source:ro \
    -v ${TEMP_DIR}:/backup \
    debian:bookworm-slim \
    tar czf /backup/alertmanager_data.tar.gz -C /source .

# Create combined backup archive
log "Creating combined backup archive: ${BACKUP_FILE}"
tar czf "${BACKUP_DIR}/${BACKUP_FILE}" -C ${TEMP_DIR} \
    prometheus_data.tar.gz \
    grafana_data.tar.gz \
    alertmanager_data.tar.gz

# Verify backup was created
if [ -f "${BACKUP_DIR}/${BACKUP_FILE}" ]; then
    BACKUP_SIZE=$(du -h "${BACKUP_DIR}/${BACKUP_FILE}" | cut -f1)
    log "Backup completed successfully: ${BACKUP_FILE} (${BACKUP_SIZE})"
else
    log "ERROR: Backup file not created"
    exit 1
fi

# Cleanup old backups (older than retention period)
log "Cleaning up backups older than ${RETENTION_DAYS} days"
find "${BACKUP_DIR}" -name "monitoring_backup_*.tar.gz" -type f -mtime +${RETENTION_DAYS} -delete
REMAINING_BACKUPS=$(find "${BACKUP_DIR}" -name "monitoring_backup_*.tar.gz" -type f | wc -l)
log "Cleanup complete. ${REMAINING_BACKUPS} backup(s) remaining."

log "Monitoring stack backup finished successfully"
exit 0
