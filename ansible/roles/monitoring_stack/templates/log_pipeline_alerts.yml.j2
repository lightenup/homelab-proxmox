# Prometheus pipeline self-monitoring alerts, spec 092 (research R14).
# Generated by Ansible — DO NOT EDIT MANUALLY. Rendered only when
# (deploy_environment | default('prod')) != 'lab' (FR-017, R12): a LAB-path run leaves the
# production file as it is.
{% set log_expected_hosts = groups['services'] | default([]) + groups['proxmox_hosts'] | default([]) %}
{% set enabled_services = [] %}
{% for host in groups['all'] | default([]) %}
{% set contract = hostvars[host].monitoring_contract | default({}) %}
{% for rule in contract.log_alert_rules | default([]) %}
{% if rule.enabled %}
{% set _ = enabled_services.append(rule) %}
{% endif %}
{% endfor %}
{% endfor %}
{# Must match log_alerts.yaml.j2's log_rules_rendered_count exactly: 1 KernelOomKill +
   2 SshLoginNotAllowed + 2 SudoByUnexpectedUser + the enabled per-service rules. #}
{% set log_rules_expected_count = 5 + (enabled_services | length) %}

groups:
  - name: log_pipeline_alerts
    interval: 30s
    rules:
      - alert: LogCollectorDown
        expr: |
          up{job="alloy"} == 0
        for: 10m
        labels:
          severity: warning
          component: logging
        annotations:
          summary: "{% raw %}Log collector down on {{ $labels.instance }}{% endraw %}"
          description: >-
            Alloy has not answered its /metrics scrape for 10 minutes. The target carries
            no_down_alert, so ServiceDown stays quiet for this job; this is the collector's own
            liveness check (MR-002).
      - alert: LogHostSilent
        expr: |
          (sum by (instance) (increase(loki_write_sent_entries_total{job="alloy"}[2h])) == 0)
          or
          (sum by (instance) (increase(loki_source_journal_target_lines_total{job="alloy"}[2h])) == 0)
        for: 15m
        labels:
          severity: warning
          component: logging
        annotations:
          summary: "{% raw %}No log lines shipped from {{ $labels.instance }} in 2 hours{% endraw %}"
          description: >-
            The collector is up but has sent no lines for 2 hours. The quietest LXC journal
            still logs an hourly cron session, so this should not happen on a healthy host
            (census, research R14).
      - alert: LogRulesNotLoaded
        expr: |
          absent(loki_prometheus_rule_group_rules{job="loki"}) or sum(loki_prometheus_rule_group_rules{job="loki"}) < {{ log_rules_expected_count }}
        for: 10m
        labels:
          severity: warning
          component: logging
        annotations:
          summary: "Loki has fewer rules loaded than expected ({{ log_rules_expected_count }})"
          description: >-
            The ruler failed to load the full rule set, most likely because one rule file has a
            syntax error (R10: a single bad file stops every rule group for the tenant).
      - alert: LogRuleEvaluationFailing
        expr: |
          increase(loki_prometheus_rule_evaluation_failures_total[10m]) > 0
          or
          increase(loki_prometheus_rule_group_iterations_missed_total[10m]) > 0
        for: 10m
        labels:
          severity: warning
          component: logging
        annotations:
          summary: "Loki ruler is failing to evaluate rules"
          description: >-
            The ruler's rule evaluations are failing or being missed. Check Loki's logs for the
            ruler component.
      - alert: LogRuleNotificationsFailing
        expr: |
          increase(loki_prometheus_notifications_errors_total[10m]) > 0
          or
          increase(loki_prometheus_notifications_dropped_total[10m]) > 0
        for: 10m
        labels:
          severity: warning
          component: logging
        annotations:
          summary: "Loki ruler cannot notify Alertmanager"
          description: >-
            The ruler's notifications to alertmanager:9093 are failing or being dropped. A
            firing log rule may not reach Pushover/ntfy.
      - alert: LogLinesDiscarded
        expr: |
          sum by (reason) (increase(loki_discarded_samples_total{reason!="too_far_behind"}[10m])) > 0
        for: 0m
        labels:
          severity: info
          component: logging
        annotations:
          summary: "{% raw %}Loki discarded samples ({{ $labels.reason }}){% endraw %}"
          description: >-
            Loki rejected some incoming samples in the last 10 minutes (MR-004). Informational
            at this rate; see LogLinesDiscardedSustained for a persistent problem. Replays
            (too_far_behind) are reported by LogReplayRejected instead.
      # RCA 2026-10-27: a collector re-sending a container's whole log (grafana/alloy#7036, a
      # container stopped across a discovery refresh) makes Loki reject every line more than
      # an hour behind as too_far_behind. Those lines are duplicates Loki already has; nothing
      # is lost. A burst of them is a replay, not an outage. A sustained stream (an hour or
      # more) is something else, e.g. a host clock running behind: LogLinesDiscardedSustained.
      - alert: LogReplayRejected
        expr: |
          sum(increase(loki_discarded_samples_total{reason="too_far_behind"}[10m])) > 0
        for: 0m
        labels:
          severity: info
          component: logging
        annotations:
          summary: "Loki rejected a collector replay (duplicate log lines, nothing lost)"
          description: >-
            A collector re-sent old log lines and Loki rejected those more than an hour behind
            as too_far_behind. They are duplicates of lines already stored. Usual cause: a
            Docker container was stopped across Alloy's 15 s discovery refresh and lost its
            read position (grafana/alloy#7036). Expected after an LXC reboot or a Docker
            restart; if it keeps firing, see LogLinesDiscardedSustained.
      - alert: LogLinesDiscardedSustained
        expr: |
          sum by (reason) (increase(loki_discarded_samples_total[10m])) > 0
        for: 1h
        labels:
          severity: warning
          component: logging
        annotations:
          summary: "{% raw %}Loki has discarded samples for over an hour ({{ $labels.reason }}){% endraw %}"
          description: >-
            Discards have persisted for an hour. Check limits_config against the source's
            actual volume.
      # Alloy counts both "Loki refused the batch" (HTTP 4xx) and "could not reach Loki" as
      # reason="ingester_error", so the reason label cannot tell them apart. Drops that come
      # with too_far_behind rejections are a replay of duplicates (LogReplayRejected), not
      # loss; they are excluded. Trade-off: a real outage in the same 15 minutes as a replay
      # is hidden for that window; LogCollectorDown and LogHostSilent still cover outages.
      - alert: LogCollectorDropping
        expr: |
          sum by (instance) (increase(loki_write_dropped_entries_total{job="alloy"}[15m])) > 0
          unless on() (sum(increase(loki_discarded_samples_total{reason="too_far_behind"}[15m])) > 0)
        for: 0m
        labels:
          severity: warning
          component: logging
        annotations:
          summary: "{% raw %}Collector on {{ $labels.instance }} is dropping log entries{% endraw %}"
          description: >-
            loki_write_dropped_entries_total increased (MR-005) and Loki reported no replay
            rejections at the same time, so entries were really lost: Loki refused them for
            another reason (rate or size limits, see LogLinesDiscarded) or the push target was
            unreachable (max_backoff_retries=0 means no retry). Check the collector's journal
            on that host and connectivity to the push target.
      - alert: LogRetentionStalled
        expr: |
          time() - loki_compactor_apply_retention_last_successful_run_timestamp_seconds > 7200
        for: 30m
        labels:
          severity: warning
          component: logging
        annotations:
          summary: "Loki's retention compactor has not completed a run in 2 hours"
          description: >-
            The compactor applies retention and processes delete requests (FR-016). A stalled
            compactor means deletes are not completing and old chunks are not expiring.
{% if groups['proxmox_hosts'] | default([]) | length > 0 %}
      - alert: HostOomKill
        expr: |
          increase(node_vmstat_oom_kill{instance="{{ proxmox_host_ip }}:{{ node_exporter_port | default(9100) }}"}[10m]) > 0
        for: 0m
        labels:
          severity: warning
          component: logging
        annotations:
          summary: "OOM kill on the Proxmox host (host-wide counter; LXC not known)"
          description: >-
            The host-wide OOM counter increased on pve. This is a backstop for KernelOomKill
            (R6): check `journalctl -k -g oom-kill` on pve to find which LXC and process. Only
            the pve instance is used here; every LXC also exposes this counter and would fire
            12 times for one kill.
{% endif %}
