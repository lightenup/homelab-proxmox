# Monitoring Stack Docker Compose Configuration
# Feature: 017-synology-metrics
# Generated by Ansible - DO NOT EDIT MANUALLY

services:
  prometheus:
    container_name: prometheus
    image: prom/prometheus:{{ prometheus_version }}
    command:
      - '--config.file=/etc/prometheus/prometheus.yml'
      - '--storage.tsdb.path=/prometheus'
      - '--storage.tsdb.retention.time={{ prometheus_retention_time }}'
      - '--web.console.libraries=/usr/share/prometheus/console_libraries'
      - '--web.console.templates=/usr/share/prometheus/consoles'
      - '--web.enable-lifecycle'
    ports:
      - "{{ prometheus_port }}:9090"
    volumes:
      - {{ prometheus_config_path }}:/etc/prometheus:ro
      - prometheus_data:/prometheus
    environment:
      - TZ={{ timezone }}
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "wget", "--quiet", "--tries=1", "--spider", "http://localhost:9090/-/healthy"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 30s

  grafana:
    container_name: grafana
    image: grafana/grafana:{{ grafana_version }}
    ports:
      - "{{ grafana_port }}:3000"
    volumes:
      - grafana_data:/var/lib/grafana
      - {{ grafana_provisioning_path }}:/etc/grafana/provisioning:ro
      - {{ grafana_dashboards_path }}:/var/lib/grafana/dashboards:ro
    environment:
      - TZ={{ timezone }}
      - GF_SECURITY_ADMIN_USER={{ grafana_admin_user }}
      - GF_SECURITY_ADMIN_PASSWORD={{ grafana_admin_password }}
      - GF_SERVER_DOMAIN={{ grafana_domain }}
      - GF_SERVER_ROOT_URL={{ grafana_protocol }}://{{ grafana_domain }}
      - GF_USERS_ALLOW_SIGN_UP=false
    restart: unless-stopped
    depends_on:
      - prometheus
    healthcheck:
      test: ["CMD", "wget", "--quiet", "--tries=1", "--spider", "http://localhost:3000/api/health"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 30s

  telegraf:
    container_name: telegraf
    image: telegraf:{{ telegraf_version }}
    ports:
      - "{{ telegraf_port }}:9273"
    volumes:
      - {{ telegraf_config_path }}/telegraf.conf:/etc/telegraf/telegraf.conf:ro
    environment:
      - TZ={{ timezone }}
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "wget", "--quiet", "--tries=1", "--spider", "http://localhost:9273/metrics"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 15s

  alertmanager:
    container_name: alertmanager
    image: prom/alertmanager:{{ alertmanager_version }}
    command:
      - '--config.file=/etc/alertmanager/alertmanager.yml'
      - '--storage.path=/alertmanager'
    ports:
      - "{{ alertmanager_port }}:9093"
    volumes:
      - {{ alertmanager_config_path }}:/etc/alertmanager:ro
      - alertmanager_data:/alertmanager
    environment:
      - TZ={{ timezone }}
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "wget", "--quiet", "--tries=1", "--spider", "http://localhost:9093/-/healthy"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 15s

  # Loki (spec 092). No compose healthcheck: the grafana/loki image has no shell, so a
  # CMD-based check is impossible (research R2). Liveness is up{job="loki"} together with the
  # existing ServiceDown rule.
  loki:
    container_name: loki
    image: grafana/loki:{{ loki_version }}
    command: ['-config.file=/etc/loki/loki.yaml']
    ports:
      - "127.0.0.1:{{ loki_port }}:3100"
    volumes:
      - {{ loki_config_path }}/loki.yaml:/etc/loki/loki.yaml:ro
      - {{ loki_rules_path }}:/etc/loki/rules:ro
      - loki_data:/loki
    environment:
      - TZ={{ timezone }}
    restart: unless-stopped
    mem_limit: {{ loki_mem_limit }}

  blackbox-exporter:
    container_name: blackbox-exporter
    image: prom/blackbox-exporter:{{ blackbox_exporter_version }}
    command:
      - '--config.file=/etc/blackbox/blackbox.yml'
    ports:
      - "{{ blackbox_exporter_port }}:9115"
    volumes:
      - {{ blackbox_config_path }}:/etc/blackbox:ro
{% if blackbox_static_hosts | default([]) | length > 0 %}
    # Probes reach the reverse proxy over the LAN without a public DNS lookup — see
    # blackbox_static_hosts in group_vars/monitoring/vars.yml.
    extra_hosts:
{% for entry in blackbox_static_hosts %}
      - "{{ entry }}"
{% endfor %}
{% endif %}
    environment:
      - TZ={{ timezone }}
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "wget", "--quiet", "--tries=1", "--spider", "http://localhost:9115/metrics"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 15s

volumes:
  prometheus_data:
    driver: local
  grafana_data:
    driver: local
  alertmanager_data:
    driver: local
  loki_data:
    driver: local

