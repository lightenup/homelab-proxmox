# Prometheus backup staleness alert (091)
# Generated by Ansible — DO NOT EDIT MANUALLY
#
# One rule for every backup. The expected set is the keys of `service_backups` plus the
# Proxmox host's own backup, so a backup that never produced a series also fires. 129600 s
# is 36 h: 1.5x the daily schedule, enough slack for one missed run's retry window without
# also missing a genuinely stopped timer. In lab no backup is installed, so none is expected.
{% set expected = [] %}
{% if (deploy_environment | default('prod')) != 'lab' %}
{% set expected = service_backups.keys() | list %}
{% if groups['proxmox_hosts'] | default([]) | length > 0 %}
{% set expected = expected + ['proxmox'] %}
{% endif %}
{% endif %}

groups:
  - name: backup_alerts
    interval: 30s
    rules:
      - alert: BackupStale
        expr: |
          (time() - max by (backup) (backup_last_success_timestamp_seconds) > 129600)
{% for name in expected %}
          or absent(backup_last_success_timestamp_seconds{backup="{{ name }}"})
{% endfor %}
        for: 15m
        labels:
          severity: warning
        annotations:
          summary: "Backup {% raw %}{{ $labels.backup }}{% endraw %} has not succeeded in 36 hours"
          description: >-
            Backup {% raw %}{{ $labels.backup }}{% endraw %} has no successful run in the last
            36 hours, or has never succeeded. Check `journalctl -u {% raw %}{{ $labels.backup }}{% endraw %}-backup.service`
            on its host (Proxmox: `proxmox-backup.service`).
