# Prometheus backup staleness alert (091)
# Generated by Ansible — DO NOT EDIT MANUALLY
#
# One rule for every backup. The expected set is the keys of `service_backups` plus the
# Proxmox host's own backup, so a backup that never produced a series also fires. 129600 s
# is 36 h: 1.5x the daily schedule, enough slack for one missed run's retry window without
# also missing a genuinely stopped timer. In lab no backup is installed, so none is expected.
{% set expected = [] %}
{% if (deploy_environment | default('prod')) != 'lab' %}
{% set expected = service_backups.keys() | list %}
{% if groups['proxmox_hosts'] | default([]) | length > 0 %}
{% set expected = expected + ['proxmox'] %}
{% endif %}
{% endif %}

groups:
  - name: backup_alerts
    interval: 30s
    rules:
      - alert: BackupStale
        expr: |
          (time() - max by (backup) (backup_last_success_timestamp_seconds) > 129600)
{% for name in expected %}
          or absent(backup_last_success_timestamp_seconds{backup="{{ name }}"})
{% endfor %}
        for: 15m
        labels:
          severity: warning
        annotations:
          summary: "Backup {% raw %}{{ $labels.backup }}{% endraw %} has not succeeded in 36 hours"
          description: >-
            Backup {% raw %}{{ $labels.backup }}{% endraw %} has no successful run in the last
            36 hours, or has never succeeded. Check `journalctl -u {% raw %}{{ $labels.backup }}{% endraw %}-backup.service`
            on its host (Proxmox: `proxmox-backup.service`).
{% if (deploy_environment | default('prod')) != 'lab' %}

  # Nightly Terraform state-drift check on pve (067): state-drift-check.timer, 06:30. Metrics come
  # from the node_exporter textfile collector. The container names are in latest.json, not here.
  - name: state_drift_alerts
    interval: 30s
    rules:
      - alert: StateDriftContainers
        expr: max by (kind) (homelab_state_drift_containers) > 0
        for: 0m
        labels:
          severity: warning
        annotations:
          summary: "Container drift on pve: {% raw %}{{ $labels.kind }}{% endraw %}"
          description: >-
            The nightly state-drift check found containers of kind
            {% raw %}{{ $labels.kind }}{% endraw %} (untracked = in no Terraform state,
            double_tracked = in two states, lab_leftover = a lab copy that was swept). Names:
            `jq . /var/lib/homelab-proxmox/artifacts/state-drift/latest.json` and
            `journalctl -u state-drift-check` on pve. Runbook: docs/runbooks/state-drift.md.
      - alert: StateDriftCheckStale
        expr: time() - homelab_state_drift_last_success_timestamp_seconds > 26 * 3600
        for: 15m
        labels:
          severity: warning
        annotations:
          summary: "State-drift check has not completed in 26 hours"
          description: >-
            The check did not finish its nightly run, or kept skipping because a LAB run held the
            lock. Check `journalctl -u state-drift-check` and `systemctl list-timers state-drift-check`
            on pve.
      - alert: StateDriftCheckAbsent
        expr: absent(homelab_state_drift_last_success_timestamp_seconds)
        for: 26h
        labels:
          severity: warning
        annotations:
          summary: "State-drift check has never reported"
          description: >-
            No state_drift.prom was ever collected from pve. Apply
            `host_proxmox.yml --tags state-drift` and check the timer and the textfile directory.

  # Dead-man's switch for the single self-hosted runner (pi-ci): .github/workflows/runner-heartbeat.yml
  # stamps this metric on pve every 10 minutes while the runner works. 7200 s is longer than the longest
  # job timeout (90 min) because the heartbeat queues behind running jobs.
  - name: ci_runner_alerts
    interval: 30s
    rules:
      - alert: CiRunnerHeartbeatStale
        expr: time() - homelab_ci_runner_last_heartbeat_timestamp_seconds > 7200
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "The CI runner has not run a job in 2 hours"
          description: >-
            The scheduled `Runner heartbeat` workflow has not completed for 2 hours, longer than any
            job may run. The pi-ci runner is probably wedged: GitHub can still show it as online while
            jobs sit queued. On pi-ci: `sudo ./svc.sh status` in the actions-runner directory, then
            `sudo ./svc.sh stop && sudo ./svc.sh start`. See docs/operations/proxmox-ci.md.
      - alert: CiRunnerHeartbeatAbsent
        expr: absent(homelab_ci_runner_last_heartbeat_timestamp_seconds)
        for: 3h
        labels:
          severity: warning
        annotations:
          summary: "The CI runner heartbeat has never reported"
          description: >-
            No ci_runner.prom was ever collected from pve. Run the `Runner heartbeat` workflow once
            (workflow_dispatch) and check that the node_exporter textfile directory is writable by ci.
{% endif %}
