# Prometheus service-specific alert rules
# Feature: 040-monitoring-overhaul
# Generated by Ansible from monitoring contracts — DO NOT EDIT MANUALLY
# Source: service roles' monitoring_contract.alert_rules (FR-009, FR-015, US-4)
#
# Each service that declares monitoring_contract.enabled=true and non-empty alert_rules
# gets its own named group in this file. Services with no alert_rules are skipped.

groups:
{% for host in groups['all'] | default([]) %}
{% set contract = hostvars[host].monitoring_contract | default({}) %}
{% if contract.enabled | default(false) and contract.alert_rules | default([]) | length > 0 %}
  - name: {{ host }}_alerts
    interval: 30s
    rules:
{% for rule in contract.alert_rules %}
      - alert: {{ rule.alert }}
        expr: |
          {{ rule.expr | indent(10) }}
        for: {{ rule.for }}
        labels:
          severity: {{ rule.severity }}
        annotations:
          summary: |-
            {{ rule.summary }}
          description: |-
            {{ rule.description }}
{% endfor %}
{% endif %}
{% endfor %}
