# Alertmanager Configuration
# Feature: 017-synology-metrics
# Generated by Ansible - DO NOT EDIT MANUALLY

global:
  smtp_smarthost: '{{ smtp_server }}:{{ smtp_port }}'
  smtp_from: '{% if smtp_from_address and smtp_from_address != "" %}{{ smtp_from_address }}{% else %}alertmanager@localhost{% endif %}'
  smtp_auth_username: '{{ smtp_username }}'
  smtp_auth_password: '{{ smtp_password }}'
  smtp_require_tls: {{ smtp_require_tls | lower }}

route:
{% if pushover_enabled | default(false) | bool %}
  # Pushover-only: every alert is delivered via Pushover. All three severities in use
  # (critical/warning/info) have an explicit child route below; the root receiver remains
  # the catch-all for an alert added later with no severity label, which would otherwise
  # be dropped silently. Email is intentionally NOT wired
  # in — a permanently-failing email receiver (unconfigured SMTP) previously stalled
  # notification dispatch and blocked Pushover delivery.
  receiver: 'pushover-warning'
{% else %}
  receiver: 'email-default'
{% endif %}
  group_by: ['alertname', 'severity']
  group_wait: {{ alertmanager_group_wait }}
  group_interval: {{ alertmanager_group_interval }}
  repeat_interval: {{ alertmanager_repeat_interval }}
{% if pushover_enabled | default(false) | bool %}
  routes:
    - receiver: 'pushover-critical'
      matchers:
        - severity = "critical"
    - receiver: 'pushover-warning'
      matchers:
        - severity = "warning"
    # FR-016 of 043, deferred at the time as "not currently used by any alert rule" and
    # delivered now that one is: 064's LlmRouterLocalTierDown. Without this route `info`
    # fell through to the root receiver and arrived on the phone titled [WARNING] — the
    # exact opposite of what the rule's own description asks for ("informational only,
    # not an incident"). Ordering is cosmetic: the three matchers are disjoint and none
    # sets `continue`.
    - receiver: 'pushover-info'
      matchers:
        - severity = "info"
{% endif %}

receivers:
{% if not (pushover_enabled | default(false) | bool) %}
  - name: 'email-default'
    email_configs:
      - to: '{% if alert_email_recipient and alert_email_recipient != "" %}{{ alert_email_recipient }}{% else %}admin@localhost{% endif %}'
        send_resolved: true
        headers:
          Subject: '[Homelab Alert] {{"{{ .GroupLabels.alertname }}"}}'
        html: |
          <h2>{{"{{ .GroupLabels.alertname }}"}}</h2>
          <p><strong>Severity:</strong> {{"{{ .GroupLabels.severity }}"}}</p>
          <ul>
          {{"{{ range .Alerts }}"}}
            <li>{{"{{ .Annotations.summary }}"}}<br/>{{"{{ .Annotations.description }}"}}</li>
          {{"{{ end }}"}}
          </ul>
{% endif %}
{% if pushover_enabled | default(false) | bool %}
  - name: 'pushover-critical'
    pushover_configs:
      - user_key: '{{ pushover_user_key }}'
        token: '{{ pushover_api_token }}'
        send_resolved: true
        priority: '{{"{{ if eq .Status \"firing\" }}2{{ else }}0{{ end }}"}}'
        retry: {{ pushover_retry_interval }}
        expire: {{ pushover_expire_duration }}
        title: '{{"{{ if eq .Status \"firing\" }}"}}[CRITICAL] {{"{{ .GroupLabels.alertname }}"}}{{"{{ else }}"}}[RESOLVED] {{"{{ .GroupLabels.alertname }}"}}{{"{{ end }}"}}'
        message: |
          {{"{{ range .Alerts }}"}}
          {{"{{ .Annotations.summary }}"}}
          {{"{{ end }}"}}
        url: '{{ pushover_grafana_url }}'

  - name: 'pushover-warning'
    pushover_configs:
      - user_key: '{{ pushover_user_key }}'
        token: '{{ pushover_api_token }}'
        send_resolved: true
        priority: '0'
        title: '{{"{{ if eq .Status \"firing\" }}"}}[WARNING] {{"{{ .GroupLabels.alertname }}"}}{{"{{ else }}"}}[RESOLVED] {{"{{ .GroupLabels.alertname }}"}}{{"{{ end }}"}}'
        message: |
          {{"{{ range .Alerts }}"}}
          {{"{{ .Annotations.summary }}"}}
          {{"{{ end }}"}}
        url: '{{ pushover_grafana_url }}'

  # Pushover priority -1: DELIVERED but silent — no sound, no vibration — which is what
  # FR-016 asks for. Not -2 (which suppresses the notification entirely) so the event
  # still lands somewhere the operator can find it after the fact.
  #
  # No retry/expire, for the same reason pushover-warning omits them: Pushover honours
  # those only at priority 2, and an informational alert that demanded acknowledgement
  # would defeat the point.
  - name: 'pushover-info'
    pushover_configs:
      - user_key: '{{ pushover_user_key }}'
        token: '{{ pushover_api_token }}'
        send_resolved: true
        priority: '-1'
        title: '{{"{{ if eq .Status \"firing\" }}"}}[INFO] {{"{{ .GroupLabels.alertname }}"}}{{"{{ else }}"}}[RESOLVED] {{"{{ .GroupLabels.alertname }}"}}{{"{{ end }}"}}'
        message: |
          {{"{{ range .Alerts }}"}}
          {{"{{ .Annotations.summary }}"}}
          {{"{{ end }}"}}
        url: '{{ pushover_grafana_url }}'
{% endif %}

inhibit_rules:
  # 1. SynologyNASDown inhibits generic ServiceDown for Synology targets (FR-028)
  #    Prevents duplicate alerts when Telegraf SNMP target goes down
  - source_matchers:
      - alertname = "SynologyNASDown"
    target_matchers:
      - alertname = "ServiceDown"
    equal: ['instance']

  # 2. SynologyNASDown inhibits Synology-specific alerts (existing, migrated to v0.30.0 syntax)
  - source_matchers:
      - alertname = "SynologyNASDown"
    target_matchers:
      - alertname =~ "Synology.*"
    equal: ['instance']

  # 3. Agent-down suppresses infrastructure threshold alerts (FR-029)
  #    When node_exporter is unreachable, CPU/memory/disk thresholds are stale
  - source_matchers:
      - alertname = "ServiceDown"
      - component = "availability"
    target_matchers:
      - component = "infrastructure"
    equal: ['instance']

  # 4. Critical severity suppresses warning for same alertname+instance
  - source_matchers:
      - severity = "critical"
    target_matchers:
      - severity = "warning"
    equal: ['alertname', 'instance']

  # 5. EndpointDown suppresses TLS cert expiry alerts for unreachable endpoints (FR-020)
  - source_matchers:
      - alertname = "EndpointDown"
    target_matchers:
      - alertname =~ "TLSCert.*"
    equal: ['instance']

  # 6. EndpointDown suppresses latency alerts for unreachable endpoints (FR-020)
  - source_matchers:
      - alertname = "EndpointDown"
    target_matchers:
      - alertname = "HighProbeLatency"
    equal: ['instance']

  # 7. Fail2banDown suppresses ban rate alerts when exporter unreachable (FR-021a)
  - source_matchers:
      - alertname = "Fail2banDown"
    target_matchers:
      - alertname = "Fail2banHighBanRate"
    equal: ['instance']

  # 8. Fail2banDown suppresses generic ServiceDown for fail2ban exporter targets (FR-021b)
  - source_matchers:
      - alertname = "Fail2banDown"
    target_matchers:
      - alertname = "ServiceDown"
    equal: ['instance']
