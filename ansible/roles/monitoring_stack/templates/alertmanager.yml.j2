# Alertmanager Configuration
# Feature: 017-synology-metrics
# Generated by Ansible - DO NOT EDIT MANUALLY

global:
  smtp_smarthost: '{{ smtp_server }}:{{ smtp_port }}'
  smtp_from: '{% if smtp_from_address and smtp_from_address != "" %}{{ smtp_from_address }}{% else %}alertmanager@localhost{% endif %}'
  smtp_auth_username: '{{ smtp_username }}'
  smtp_auth_password: '{{ smtp_password }}'
  smtp_require_tls: {{ smtp_require_tls | lower }}

route:
  receiver: 'email-default'
  group_by: ['alertname', 'severity']
  group_wait: {{ alertmanager_group_wait }}
  group_interval: {{ alertmanager_group_interval }}
  repeat_interval: {{ alertmanager_repeat_interval }}

receivers:
  - name: 'email-default'
    email_configs:
      - to: '{% if alert_email_recipient and alert_email_recipient != "" %}{{ alert_email_recipient }}{% else %}admin@localhost{% endif %}'
        send_resolved: true
        headers:
          Subject: '[Homelab Alert] {{"{{ .GroupLabels.alertname }}"}}'
        html: |
          <h2>{{"{{ .GroupLabels.alertname }}"}}</h2>
          <p><strong>Severity:</strong> {{"{{ .GroupLabels.severity }}"}}</p>
          <ul>
          {{"{{ range .Alerts }}"}}
            <li>{{"{{ .Annotations.summary }}"}}<br/>{{"{{ .Annotations.description }}"}}</li>
          {{"{{ end }}"}}
          </ul>

inhibit_rules:
  # 1. SynologyNASDown inhibits generic ServiceDown for Synology targets (FR-028)
  #    Prevents duplicate alerts when Telegraf SNMP target goes down
  - source_matchers:
      - alertname = "SynologyNASDown"
    target_matchers:
      - alertname = "ServiceDown"
    equal: ['instance']

  # 2. SynologyNASDown inhibits Synology-specific alerts (existing, migrated to v0.30.0 syntax)
  - source_matchers:
      - alertname = "SynologyNASDown"
    target_matchers:
      - alertname =~ "Synology.*"
    equal: ['instance']

  # 3. Agent-down suppresses infrastructure threshold alerts (FR-029)
  #    When node_exporter is unreachable, CPU/memory/disk thresholds are stale
  - source_matchers:
      - alertname = "ServiceDown"
      - component = "availability"
    target_matchers:
      - component = "infrastructure"
    equal: ['instance']

  # 4. Critical severity suppresses warning for same alertname+instance
  - source_matchers:
      - severity = "critical"
    target_matchers:
      - severity = "warning"
    equal: ['alertname', 'instance']
