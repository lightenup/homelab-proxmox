# Prometheus Configuration
# Feature: 040-monitoring-overhaul
# Generated by Ansible - DO NOT EDIT MANUALLY

global:
  scrape_interval: {{ prometheus_scrape_interval }}
  scrape_timeout: {{ prometheus_scrape_timeout }}
  evaluation_interval: {{ prometheus_scrape_interval }}
  external_labels:
    monitor: 'homelab-monitoring'
    environment: 'production'

# Alertmanager configuration
alerting:
  alertmanagers:
    - static_configs:
        - targets:
            - 'alertmanager:9093'

# Load alert rules from alerts/ directory (FR-027)
rule_files:
  - '/etc/prometheus/alerts/*.yml'

# Scrape configurations
scrape_configs:
  # Prometheus self-monitoring (existing, preserved)
  - job_name: 'prometheus'
    static_configs:
      - targets: ['localhost:9090']
        labels:
          instance: 'prometheus'

  # SNMP metrics via Telegraf (existing, preserved per FR-019)
  - job_name: 'telegraf-snmp'
    scrape_interval: {{ prometheus_scrape_interval }}
    scrape_timeout: {{ prometheus_scrape_timeout }}
    static_configs:
      - targets:
          - telegraf:{{ telegraf_port }}
        labels:
          job: 'telegraf-snmp'
    metrics_path: /metrics

  # Infrastructure metrics — one target per service LXC (FR-003, US-1)
  # Iterates over all hosts in the 'services' inventory group via hostvars
  # Skips hosts whose monitoring_contract is explicitly disabled (not yet provisioned)
  - job_name: 'node-exporter'
    scrape_interval: {{ prometheus_scrape_interval }}
    static_configs:
      - targets:
{% for host in groups['services'] | default([]) + (groups['proxmox_hosts'] | default([]) if (deploy_environment | default('prod')) != 'lab' else []) %}
{% if (hostvars[host].monitoring_contract | default({})).enabled | default(true) %}
          - '{{ hostvars[host].ansible_host }}:{{ node_exporter_port | default(9100) }}'
{% endif %}
{% endfor %}

  # Log pipeline self-monitoring (spec 092, research R14). Path-independent (R12): the same
  # hosts are scraped on every path, so a LAB-path render leaves these targets unchanged.
  - job_name: 'loki'
    scrape_interval: {{ prometheus_scrape_interval }}
    static_configs:
      - targets: ['loki:3100']
        labels:
          instance: 'loki'

  # Alerting path self-monitoring (RCA 2026-10-27): Alertmanager's notification counters are
  # the only record of whether a page reached Pushover/ntfy, and were never scraped. Grafana
  # is here for the same reason: every stack container with /metrics has a job
  # (test_alerting_path.py). No no_down_alert: ServiceDown must cover both.
  - job_name: 'alertmanager'
    scrape_interval: {{ prometheus_scrape_interval }}
    static_configs:
      - targets: ['alertmanager:9093']
        labels:
          instance: 'alertmanager'

  - job_name: 'grafana'
    scrape_interval: {{ prometheus_scrape_interval }}
    static_configs:
      - targets: ['grafana:3000']
        labels:
          instance: 'grafana'

  - job_name: 'alloy'
    scrape_interval: {{ prometheus_scrape_interval }}
    static_configs:
{% for host in groups['services'] | default([]) + groups['proxmox_hosts'] | default([]) %}
      - targets: ['{{ hostvars[host].ansible_host }}:{{ alloy_http_port }}']
        labels:
          instance: '{{ host }}'
          no_down_alert: 'true'
{% endfor %}

  # Application metrics — aggregated from service monitoring contracts (FR-008, US-4)
  # Each scrape target comes from a service role's monitoring_contract.scrape_targets
{% for host in groups['all'] | default([]) %}
{% set contract = hostvars[host].monitoring_contract | default({}) %}
{% if contract.enabled | default(false) %}
{% for target in contract.scrape_targets | default([]) %}
  - job_name: '{{ target.job_name }}'
    scrape_interval: {{ target.scrape_interval | default(prometheus_scrape_interval) }}
    scrape_timeout: {{ prometheus_scrape_timeout }}
    static_configs:
      - targets:
          - '{{ hostvars[host].ansible_host }}:{{ target.port }}'
        labels:
          instance: '{{ host }}'
    metrics_path: {{ target.path | default('/metrics') }}
{% if target.bearer_token is defined and target.bearer_token %}
    # Optional bearer-auth for scrape targets whose /metrics requires a token (e.g.
    # llm-router — LiteLLM's /metrics defaults to requiring one). Default-off: existing
    # contracts that don't set bearer_token render byte-identically (research D-105,
    # spec 064-llm-router).
    authorization:
      credentials: '{{ target.bearer_token }}'
{% endif %}
{% endfor %}
{% endif %}
{% endfor %}

  # Off-inventory scrape targets — hosts Ansible does not manage, so there is no
  # hostvars[host].ansible_host to build a contract target from (e.g. the Mac running
  # oMLX + llm_queue). Default-empty: renders nothing unless the var is set.
{% for target in prometheus_external_scrape_targets | default([]) %}
  - job_name: '{{ target.job_name }}'
    scrape_interval: {{ target.scrape_interval | default(prometheus_scrape_interval) }}
    scrape_timeout: {{ prometheus_scrape_timeout }}
    static_configs:
      - targets:
          - '{{ target.address }}'
        labels:
          instance: '{{ target.instance }}'
{% if not (target.alert_on_down | default(true) | bool) %}
          no_down_alert: 'true'
{% endif %}
    metrics_path: {{ target.path | default('/metrics') }}
{% endfor %}

  # HTTPS endpoint probes — static targets, NOT via monitoring contracts (FR-006, C-007)
  - job_name: 'blackbox-exporter'
    scrape_interval: {{ prometheus_scrape_interval }}
    scrape_timeout: {{ prometheus_scrape_timeout }}
    static_configs:
      - targets:
          - 'blackbox-exporter:9115'
    metrics_path: /metrics

  - job_name: 'blackbox-https'
    scrape_interval: 30s
    scrape_timeout: {{ prometheus_scrape_timeout }}
    metrics_path: /probe
    params:
      module: [https_2xx]
    static_configs:
      - targets:
{% for target in blackbox_https_targets | default([]) %}
          - '{{ target }}'
{% endfor %}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: blackbox-exporter:9115

  # Public DNS probe — the resolver is the target, the name is fixed in the dns_public module
  - job_name: 'blackbox-dns'
    scrape_interval: 30s
    scrape_timeout: {{ prometheus_scrape_timeout }}
    metrics_path: /probe
    params:
      module: [dns_public]
    static_configs:
      - targets:
{% for resolver in blackbox_dns_resolvers | default([]) %}
          - '{{ resolver }}:53'
{% endfor %}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: blackbox-exporter:9115

  # HTTP liveness probes — plain-HTTP targets from service monitoring contracts
{% for host in groups['all'] | default([]) %}
{% set contract = hostvars[host].monitoring_contract | default({}) %}
{% if contract.enabled | default(false) and contract.liveness_targets | default([]) | length > 0 %}
{% for target in contract.liveness_targets %}
  - job_name: '{{ target.job_name }}'
    scrape_interval: 30s
    scrape_timeout: {{ prometheus_scrape_timeout }}
    metrics_path: /probe
    params:
      module: [{{ target.module | default('http_2xx') }}]
    static_configs:
      - targets:
          - '{{ target.url }}'
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: blackbox-exporter:9115
{% if target.instance_label is defined %}
      # Overrides the instance label set from __param_target above. Without this the raw
      # probe URL becomes the instance, and /api/status on the apex is PUBLIC and
      # unauthenticated — so an internal target URL is published to the internet. Observed
      # 2026-09-19: llm-router's readiness probe put http://192.168.1.220:4000/health/readiness
      # on hus-sky.no. Not reachable from outside, but it advertises the address, the port
      # and whether the service is up, which is what FR-008 of spec 064 exists to prevent.
      - target_label: instance
        replacement: '{{ target.instance_label }}'
{% endif %}
{% endfor %}
{% endif %}
{% endfor %}
