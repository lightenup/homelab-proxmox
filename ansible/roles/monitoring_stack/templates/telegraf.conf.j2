# Telegraf Configuration for SNMP Monitoring
# Feature: 017-synology-metrics
# Generated by Ansible - DO NOT EDIT MANUALLY
# Stable abstraction layer between SNMP devices and Prometheus

[agent]
  interval = "{{ prometheus_scrape_interval }}"
  round_interval = true
  metric_batch_size = 1000
  metric_buffer_limit = 10000
  collection_jitter = "0s"
  flush_interval = "10s"
  flush_jitter = "0s"
  precision = "0s"
  hostname = "{{ monitoring_hostname }}"
  omit_hostname = false

###############################################################################
#                            OUTPUT PLUGINS                                   #
###############################################################################

# Expose metrics in Prometheus format
[[outputs.prometheus_client]]
  listen = ":{{ telegraf_port }}"
  metric_version = 2
  expiration_interval = "60s"
  path = "/metrics"
  collectors_exclude = ["gocollector", "process"]

###############################################################################
#                            INPUT PLUGINS                                    #
###############################################################################

# SNMP Input - Simplified configuration using numeric OIDs without MIB dependencies
[[inputs.snmp]]
  agents = ["{{ synology_nas_ip }}:161"]
  timeout = "{{ prometheus_scrape_timeout }}"
  retries = 3
  version = 3
  
  # SNMPv3 Authentication
  sec_name = "{{ snmp_username }}"
  sec_level = "{{ snmp_security_level }}"
  auth_protocol = "{{ snmp_auth_protocol }}"
  auth_password = "{{ snmp_auth_password }}"
  priv_protocol = "{{ snmp_priv_protocol }}"
  priv_password = "{{ snmp_priv_password }}"
  
  # Generic system information (works with any SNMP device)
  [[inputs.snmp.field]]
    name = "sysDescr"
    oid = "1.3.6.1.2.1.1.1.0"
  
  [[inputs.snmp.field]]
    name = "sysUpTime"
    oid = "1.3.6.1.2.1.1.3.0"
  
  [[inputs.snmp.field]]
    name = "sysName"
    oid = "1.3.6.1.2.1.1.5.0"
  
  # CPU statistics (UCD-SNMP-MIB - common for Linux-based NAS)
  [[inputs.snmp.field]]
    name = "ssCpuRawUser"
    oid = "1.3.6.1.4.1.2021.11.50.0"
  
  [[inputs.snmp.field]]
    name = "ssCpuRawSystem"
    oid = "1.3.6.1.4.1.2021.11.52.0"
  
  [[inputs.snmp.field]]
    name = "ssCpuRawIdle"
    oid = "1.3.6.1.4.1.2021.11.53.0"
  
  # Memory statistics (UCD-SNMP-MIB)
  [[inputs.snmp.field]]
    name = "memTotalReal"
    oid = "1.3.6.1.4.1.2021.4.5.0"
  
  [[inputs.snmp.field]]
    name = "memAvailReal"
    oid = "1.3.6.1.4.1.2021.4.6.0"
  
  [[inputs.snmp.field]]
    name = "memBuffer"
    oid = "1.3.6.1.4.1.2021.4.14.0"
  
  [[inputs.snmp.field]]
    name = "memCached"
    oid = "1.3.6.1.4.1.2021.4.15.0"
  
  # Synology-specific disk status
  [[inputs.snmp.field]]
    name = "disk1Status"
    oid = "1.3.6.1.4.1.6574.2.1.1.5.0"
  
  [[inputs.snmp.field]]
    name = "disk1Temp"
    oid = "1.3.6.1.4.1.6574.2.1.1.6.0"
  
  # Synology RAID status
  [[inputs.snmp.field]]
    name = "raid1Status"
    oid = "1.3.6.1.4.1.6574.3.1.1.3.0"

  # Add global tags for all metrics
  [inputs.snmp.tags]
    device = "synology-nas"
    location = "homelab"
    source = "telegraf-snmp"
