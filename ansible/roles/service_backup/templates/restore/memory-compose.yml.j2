# Memory restore-drill stack (spec 097, research R-014). Generated by Ansible - DO NOT EDIT MANUALLY.
#
# A throwaway Postgres and Hindsight API beside the live ones, for the length of one drill
# (playbooks/memory-restore-drill.yml), which tears them down in `always:`. Distinct container
# names, compose project, network and volume, so nothing collides with the live stack.
#
# - The same pinned images as the live stack (role defaults), so the drill proves this release
#   can read the archive.
# - server.env is the role's template, re-rendered by the drill with the database host
#   memory_postgres_restore; db.env is the role's template unchanged. Both 0600 in the drill
#   directory, never in the archive.
# - The live clients.json, shim and policy mounts, so the drill exercises the same access
#   control and the admin key in backup.key works.
# - The API publishes on 127.0.0.1 only: the drill calls it from the LXC itself, and nothing on
#   the LAN can reach a second copy of every memory. Postgres publishes nothing.
# - No web UI: the drill checks the store, not the browser.
name: memory-restore-drill

services:
  memory_postgres_restore:
    container_name: memory_postgres_restore
    image: {{ memory_postgres_image }}
    env_file: db.env
    volumes:
      - "memory-postgres-restore:/var/lib/postgresql/data"
    networks:
      - memory_restore
    restart: "no"
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -h 127.0.0.1 -U hindsight -d hindsight"]
      interval: 5s
      timeout: 5s
      retries: 20

  memory_api_restore:
    container_name: memory_api_restore
    image: {{ memory_api_image }}
    env_file: server.env
    volumes:
      - "{{ memory_ext_dir }}:{{ memory_ext_dir }}:ro"
      - "{{ memory_install_dir }}/clients.json:/run/memory/clients.json:ro"
    ports:
      - "127.0.0.1:{{ memory_restore_test_port }}:8888"
    networks:
      - memory_restore
    restart: "no"
    depends_on:
      memory_postgres_restore:
        condition: service_healthy

networks:
  memory_restore:
    name: memory-restore-drill

volumes:
  memory-postgres-restore:
