# Hermes restore-drill stack — generated by Ansible. DO NOT EDIT MANUALLY.
#
# Stands a SECOND Open WebUI up beside the live one, pointed at an extracted backup, purely
# to prove the archive reconstitutes a working instance. Distinct container name and port,
# so it cannot collide with the running service. Torn down unconditionally by the drill
# playbook's `always:` block.
#
# Deliberately minimal versus the real stack: no SearXNG, no gateway credentials, no MCP
# registrations. The question this answers is "does the backed-up STATE come back", not
# "does every integration work" — and giving a throwaway instance the real gateway key, or
# letting it reach the tool servers, would be the wrong trade for a drill.

services:
  open-webui-restore:
    container_name: hermes_open_webui_restore
    image: {{ hermes_image }}:{{ hermes_version }}
    ports:
      - "{{ hermes_restore_test_port }}:8080"
    volumes:
      - "{{ hermes_restore_dir }}/{{ hermes_restore_basename }}/open-webui:/app/backend/data"
      - "/etc/localtime:/etc/localtime:ro"
    environment:
      # A throwaway key: this instance is never signed into, and sessions signed by it must
      # not be valid against the live service.
      WEBUI_SECRET_KEY: "restore-drill-{{ hermes_restore_basename }}"
      ENABLE_SIGNUP: "false"
      # No OPENAI_API_BASE_URL / OPENAI_API_KEY on purpose — the drill must not consume the
      # gateway's request allowance, and a scratch instance has no business holding the key.
      # The UI and the restored database work fine without a reachable model backend.
      ENABLE_WEB_SEARCH: "false"
      ENABLE_AUTOMATIONS: "false"
    restart: "no"
