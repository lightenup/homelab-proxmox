# Home Assistant restore-drill stack — generated by Ansible. DO NOT EDIT MANUALLY.
#
# Starts a SECOND Home Assistant beside the live one, pointed at an extracted backup, only
# to prove the archive brings back a working instance. Torn down unconditionally by the
# drill playbook's `always:` block.
#
# network_mode: none, unlike the live stack (host). The restored config has every
# integration and automation the live instance has. With a network it would log in to the
# same cloud accounts, talk to the same plugs and media players, and run the same automations
# as a second controller of the house. Without one it can reach nothing, and the drill reads it
# through `docker exec` instead of a published port. Integrations then fail to set up, which is
# expected. The question is whether the backed-up STATE comes back, not whether devices answer.

services:
  homeassistant-restore:
    container_name: homeassistant_restore
    image: {{ homeassistant_image }}:{{ homeassistant_version }}
    network_mode: none
    volumes:
      - "{{ homeassistant_restore_dir }}/{{ homeassistant_restore_basename }}/config:/config"
      - "/etc/localtime:/etc/localtime:ro"
    # The LXC has 2 GB and the live instance uses ~420 MB; keep the drill from crowding it.
    mem_limit: 768m
    restart: "no"
