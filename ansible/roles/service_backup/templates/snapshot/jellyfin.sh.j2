# Jellyfin snapshot. Sourced into backup.sh.j2; defines snapshot(). Only the database and
# the configuration directory: metadata, cache and trickplay are regenerated by Jellyfin.
# The service is not stopped; the database is copied with SQLite's online backup.
JELLYFIN_DB=/var/lib/jellyfin/data/jellyfin.db

snapshot() {
python3 -c 'import sqlite3,sys; s=sqlite3.connect(sys.argv[1]); d=sqlite3.connect(sys.argv[2]); s.backup(d); d.close(); s.close()' \
    "$JELLYFIN_DB" "$WORK_DIR/jellyfin.db"
cp -a /etc/jellyfin "$WORK_DIR/etc-jellyfin"
}
