#!/bin/bash
set -euo pipefail

# Configuration
BACKUP_DIR="{{ nextcloud_backup_path }}"
INSTALL_DIR="{{ nextcloud_install_dir }}"
DB_CONTAINER="{{ nextcloud_db_container_name }}"
APP_CONTAINER="{{ nextcloud_app_container_name }}"
RETENTION_DAYS={{ nextcloud_backup_retention_days }}
RETENTION_WEEKS={{ nextcloud_backup_retention_weeks }}
RETENTION_MONTHS={{ nextcloud_backup_retention_months }}

TIMESTAMP=$(date +"%Y%m%d-%H%M%S")
BACKUP_NAME="nextcloud-backup-$TIMESTAMP"
ARCHIVE_NAME="$BACKUP_NAME.tar.gz"

# Source environment variables for database credentials
# shellcheck source=/dev/null
if [ -f "$INSTALL_DIR/.env" ]; then
    # Extract MYSQL_PASSWORD only (avoid overriding shell env)
    MYSQL_PASSWORD=$(grep '^MYSQL_PASSWORD=' "$INSTALL_DIR/.env" | cut -d'=' -f2-)
    MYSQL_USER=$(grep '^MYSQL_USER=' "$INSTALL_DIR/.env" | cut -d'=' -f2-)
    MYSQL_DATABASE=$(grep '^MYSQL_DATABASE=' "$INSTALL_DIR/.env" | cut -d'=' -f2-)
else
    echo "Error: .env file not found at $INSTALL_DIR/.env"
    exit 1
fi

# Ensure backup directory exists and is writable
if [ ! -d "$BACKUP_DIR" ]; then
    echo "Error: Backup directory $BACKUP_DIR does not exist."
    exit 1
fi

if [ ! -w "$BACKUP_DIR" ]; then
    echo "Error: Backup directory $BACKUP_DIR is not writable."
    exit 1
fi

# Ensure maintenance mode is disabled on exit (cleanup on failure)
cleanup() {
    echo "Disabling Nextcloud maintenance mode..."
    docker exec "$APP_CONTAINER" php occ maintenance:mode --off || true
}
trap cleanup EXIT

# Create temporary directory
TEMP_DIR=$(mktemp -d)
WORK_DIR="$TEMP_DIR/$BACKUP_NAME"
mkdir -p "$WORK_DIR"

# 1. Enable maintenance mode
echo "Enabling Nextcloud maintenance mode..."
docker exec "$APP_CONTAINER" php occ maintenance:mode --on

# 2. Dump Database
echo "Starting database dump..."
if ! docker exec "$DB_CONTAINER" \
    mysqldump \
    --single-transaction \
    --default-character-set=utf8mb4 \
    -u"$MYSQL_USER" \
    -p"$MYSQL_PASSWORD" \
    "$MYSQL_DATABASE" > "$WORK_DIR/dump.sql"; then
    echo "Error: Database dump failed."
    rm -rf "$TEMP_DIR"
    exit 1
fi

# 3. Backup config.php
echo "Backing up config.php..."
if docker exec "$APP_CONTAINER" cat /var/www/html/config/config.php > "$WORK_DIR/config.php" 2>/dev/null; then
    echo "config.php backed up successfully."
else
    echo "Warning: config.php not found in container."
fi

# 4. Backup docker-compose.yml for reference
if [ -f "$INSTALL_DIR/docker-compose.yml" ]; then
    cp "$INSTALL_DIR/docker-compose.yml" "$WORK_DIR/"
fi

# 5. Compress
echo "Compressing backup..."
tar -czf "$BACKUP_DIR/$ARCHIVE_NAME" -C "$TEMP_DIR" "$BACKUP_NAME"
rm -rf "$TEMP_DIR"

echo "Backup created successfully: $BACKUP_DIR/$ARCHIVE_NAME"

# 6. Prune Old Backups (GFS retention)
echo "Pruning old backups..."

# Function to get file date (YYYY-MM-DD) from filename
get_date() {
    echo "$1" | grep -oE '[0-9]{8}' | sed 's/\(....\)\(..\)\(..\)/\1-\2-\3/'
}

# List all backup files
FILES=$(ls "$BACKUP_DIR"/nextcloud-backup-*.tar.gz 2>/dev/null || true)

for file in $FILES; do
    FILENAME=$(basename "$file")
    FILE_DATE_STR=$(get_date "$FILENAME")

    if [ -z "$FILE_DATE_STR" ]; then
        continue
    fi

    FILE_TIMESTAMP=$(date -d "$FILE_DATE_STR" +%s)
    CURRENT_TIMESTAMP=$(date +%s)
    AGE_DAYS=$(( (CURRENT_TIMESTAMP - FILE_TIMESTAMP) / 86400 ))

    DAY_OF_WEEK=$(date -d "$FILE_DATE_STR" +%u) # 1=Mon, 7=Sun
    DAY_OF_MONTH=$(date -d "$FILE_DATE_STR" +%d)

    DELETE=true

    # Daily retention
    if [ "$AGE_DAYS" -lt "$RETENTION_DAYS" ]; then
        DELETE=false
    fi

    # Weekly retention (Keep Sundays)
    if [ "$DELETE" = true ] && [ "$DAY_OF_WEEK" -eq 7 ] && [ "$AGE_DAYS" -lt $((RETENTION_WEEKS * 7)) ]; then
        DELETE=false
    fi

    # Monthly retention (Keep 1st of month)
    if [ "$DELETE" = true ] && [ "$DAY_OF_MONTH" -eq 01 ] && [ "$AGE_DAYS" -lt $((RETENTION_MONTHS * 30)) ]; then
        DELETE=false
    fi

    if [ "$DELETE" = true ]; then
        echo "Deleting old backup: $FILENAME (Age: $AGE_DAYS days)"
        rm "$file"
    else
        echo "Keeping backup: $FILENAME (Age: $AGE_DAYS days)"
    fi
done

echo "Backup process completed."
