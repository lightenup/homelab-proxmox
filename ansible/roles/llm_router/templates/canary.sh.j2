#!/usr/bin/env bash
# LLM Router synthetic canary — generated by Ansible. DO NOT EDIT MANUALLY.
#
# Sends one real completion request against {{ llm_router_canary_alias }} and reports
# success/failure to node_exporter's textfile collector. This is the half of FR-018 that
# detects an all-backends-failing gateway with NO client traffic flowing — the failure-rate
# alert (LlmRouterAllBackendsFailing) only fires under load; this fires regardless
# (SC-013). Deliberately real client traffic (billed to a $1/mo-capped canary key,
# llm_router_clients), not a health probe — it stays outside SC-011's probe-spend budget by
# construction.
set -euo pipefail

METRICS_FILE="{{ llm_router_canary_textfile_dir }}/llm_router_canary.prom"
TMP_FILE="${METRICS_FILE}.$$"

http_code=$(curl -s -o /dev/null -w '%{http_code}' -m 30 \
  -X POST "http://127.0.0.1:{{ llm_router_port }}/v1/chat/completions" \
  -H "Authorization: Bearer {{ llm_router_canary_key }}" \
  -H "Content-Type: application/json" \
  -d '{"model":"{{ llm_router_canary_alias }}","messages":[{"role":"user","content":"canary"}],"max_tokens":1}' \
  || echo "000")

if [[ "$http_code" == "200" ]]; then
  success=1
else
  success=0
fi

cat > "$TMP_FILE" <<METRICS
# HELP llm_router_canary_success Whether the last synthetic canary request succeeded (1) or not (0).
# TYPE llm_router_canary_success gauge
llm_router_canary_success{alias="{{ llm_router_canary_alias }}"} ${success}
# HELP llm_router_canary_last_run_timestamp_seconds Unix timestamp of the last canary run.
# TYPE llm_router_canary_last_run_timestamp_seconds gauge
llm_router_canary_last_run_timestamp_seconds{alias="{{ llm_router_canary_alias }}"} $(date +%s)
METRICS

# Atomic rename so node_exporter never reads a half-written file.
mv "$TMP_FILE" "$METRICS_FILE"
