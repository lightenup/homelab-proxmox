#!/usr/bin/env bash
# LLM Router synthetic canary — generated by Ansible. DO NOT EDIT MANUALLY.
#
# Sends real completion requests against {{ llm_router_canary_alias }} and reports
# success/failure to node_exporter's textfile collector. This is the half of FR-018 that
# detects an all-backends-failing gateway with NO client traffic flowing — the failure-rate
# alert (LlmRouterAllBackendsFailing) only fires under load; this fires regardless
# (SC-013). Deliberately real client traffic (billed to a $1/mo-capped canary key,
# llm_router_clients), not a health probe — it stays outside SC-011's probe-spend budget by
# construction.
#
# RETRIES, added 2026-09-22. A single attempt made this a noise generator rather than a
# signal: oMLX's prefill memory guard returns 400 whenever the Mac is under memory pressure,
# and its projection is dominated by a 20-37 GB KV/SDPA transient rather than by prompt size,
# so even this 14-token max_tokens:1 request gets refused while the gateway is otherwise
# healthy (244 such 400s in 24h, measured 2026-09-22). Writing a 0 for that fired
# LlmRouterCanaryFailing, which was `critical` and therefore Pushover priority 2 — an
# emergency that re-alerts every 60s for an hour. A 0 written here now means every attempt
# failed, which is worth waking up for; the alert itself is `warning` as of the same date.
set -euo pipefail

METRICS_FILE="{{ llm_router_canary_textfile_dir }}/llm_router_canary.prom"
TMP_FILE="${METRICS_FILE}.$$"

# Sweep temp files stranded by an earlier run. The EXIT trap below does NOT run on SIGKILL,
# which is exactly how systemd ends a run that overruns TimeoutStartSec, so the trap alone
# is not enough. Safe under `set -e`: with neither nullglob nor failglob set an unmatched
# glob stays literal, and `rm -f` on a nonexistent path exits 0. No concurrency risk —
# systemd will not run two instances of a oneshot unit at once. These orphans never
# corrupted the metric (node_exporter globs *.prom and `.prom.1234` does not match); they
# were disk and debugging clutter.
rm -f -- "${METRICS_FILE}".[0-9]*
trap 'rm -f -- "$TMP_FILE"' EXIT HUP INT TERM

ATTEMPTS={{ llm_router_canary_attempts }}
RETRY_DELAY={{ llm_router_canary_retry_delay_seconds }}
CURL_TIMEOUT={{ llm_router_canary_curl_timeout_seconds }}

canary_request() {
  # `local code` on its own line, deliberately. `local code=$(curl ...)` makes the exit
  # status that of `local` — always 0 — so the `|| code="000"` below would never fire.
  local code
  # Assign-then-override, NOT `$(curl ... || echo "000")`. curl writes the -w value ("000")
  # to stdout AND exits non-zero on a transport failure or -m timeout, so that idiom yields
  # the two-line string "000\n000". It was harmless against a `== "200"` test and still the
  # wrong thing; verified 2026-09-22.
  code=$(curl -s -o /dev/null -w '%{http_code}' -m "$CURL_TIMEOUT" \
    -X POST "http://127.0.0.1:{{ llm_router_port }}/v1/chat/completions" \
    -H "Authorization: Bearer {{ llm_router_canary_key }}" \
    -H "Content-Type: application/json" \
    -d '{"model":"{{ llm_router_canary_alias }}","messages":[{"role":"user","content":"canary"}],"max_tokens":1}') || code="000"
  printf '%s' "${code:-000}"
}

success=0
attempts_used=0
attempt=1
while [[ "$attempt" -le "$ATTEMPTS" ]]; do
  attempts_used="$attempt"
  if [[ "$(canary_request)" == "200" ]]; then
    success=1
    break
  fi
  # Guarded so the test is never the loop body's last command: a false `[[ ]]` there would
  # propagate non-zero and `set -e` would abort the loop instead of retrying.
  if [[ "$attempt" -lt "$ATTEMPTS" ]]; then
    sleep "$RETRY_DELAY"
  fi
  # Never `(( attempt++ ))`: an arithmetic command exits 1 when its result evaluates to 0,
  # which for post-increment is the first iteration, and `set -e` would kill the script.
  # An assignment from $(( )) always exits 0.
  attempt=$(( attempt + 1 ))
done

cat > "$TMP_FILE" <<METRICS
# HELP llm_router_canary_success Whether the last synthetic canary run succeeded (1) or not (0).
# TYPE llm_router_canary_success gauge
llm_router_canary_success{alias="{{ llm_router_canary_alias }}"} ${success}
# HELP llm_router_canary_attempts Attempts the last canary run consumed (1 = clean first try).
# TYPE llm_router_canary_attempts gauge
llm_router_canary_attempts{alias="{{ llm_router_canary_alias }}"} ${attempts_used}
# HELP llm_router_canary_last_run_timestamp_seconds Unix timestamp of the last canary run.
# TYPE llm_router_canary_last_run_timestamp_seconds gauge
llm_router_canary_last_run_timestamp_seconds{alias="{{ llm_router_canary_alias }}"} $(date +%s)
METRICS

# Atomic rename so node_exporter never reads a half-written file.
mv "$TMP_FILE" "$METRICS_FILE"
