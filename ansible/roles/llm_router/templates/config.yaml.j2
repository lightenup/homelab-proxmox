# LiteLLM proxy config — generated by Ansible. DO NOT EDIT MANUALLY.
#
# Rendered from llm_router_aliases in ansible/group_vars/services/vars.yml. This template
# iterates the alias mapping; it never branches on a specific alias name (FR-003). Changing
# the model behind an alias is a group_vars edit and a deploy — never a template edit
# (contracts/alias-mapping.md).

model_list:
{% for alias in llm_router_aliases %}
{% for d in alias.deployments %}
  - model_name: {{ alias.name }}
    litellm_params:
      model: {{ d.provider_model }}
{% if d.api_base is defined and d.api_base %}
      api_base: {{ d.api_base }}
{% endif %}
{% if d.api_key_env is defined and d.api_key_env %}
      api_key: os.environ/{{ d.api_key_env }}
{% endif %}
      # Without this, a dead backend HANGS the caller instead of erroring. Measured
      # 2026-09-19 with the Mac's LiteLLM stopped: every alias hung past 300s and returned
      # nothing — no status, no error. The cause is the Mac's MDM-enforced stealth mode,
      # which DROPS the SYN rather than refusing it, so the connect never completes: a
      # TCP connect from the LXC to the stopped port hung the full 25s test window, while
      # the same probe against a non-stealth host refused in 0.001s. The doctor's own
      # premise that "a stopped server refuses fast, a vanished host hangs" does not hold
      # on this Mac — both hang, so the hang is the ONLY failure mode, not the rare one.
      #
      # It also defeated the health checking above: a background check that blackholes
      # never completes, so it never reports a failure, so allowed_fails never accrues and
      # the deployment is never ejected. Eight minutes after the backend died, requests
      # still hung. background_health_checks: true was configured and inert — exactly the
      # class of bug this repo's doctor exists to catch.
      #
      # The bound is a total request timeout, which is the only lever LiteLLM exposes in
      # config, so it has to clear a real generation as well: observed short answers are
      # 1.3-2.6s and these are 27B models at roughly 35-60 tok/s, so a 4k-token completion
      # lands near 70-115s. {{ llm_router_request_timeout }}s leaves headroom over that while
      # capping the failure case. Raise llm_router_request_timeout if long generations are
      # cut off; lowering it makes a dead backend fail sooner.
      timeout: {{ d.timeout | default(llm_router_request_timeout) }}
    model_info:
      id: {{ d.id }}
      # Metered deployments are never probed — background health checks are scoped to the
      # local tier only via background_health_check_model_groups below (research D-101).
      disable_background_health_check: {{ 'false' if d.health_checked else 'true' }}
{% endfor %}
{% endfor %}

router_settings:
  fallbacks:
{% for alias in llm_router_aliases %}
{% if alias.fallback_to %}
    - {{ alias.name }}: [{{ alias.fallback_to }}]
{% endif %}
{% endfor %}
  context_window_fallbacks:
{% for alias in llm_router_aliases %}
{% if alias.context_window_fallback_to %}
    - {{ alias.name }}: [{{ alias.context_window_fallback_to }}]
{% endif %}
{% endfor %}
  allowed_fails: {{ llm_router_allowed_fails }}
  cooldown_time: {{ llm_router_cooldown_time }}
  # Explicit, because the wait a caller experiences is timeout x (1 + num_retries) and the
  # upstream default is not 0. Retrying a backend that is blackholing does not help.
  num_retries: {{ llm_router_num_retries }}
  enable_pre_call_checks: true

general_settings:
  master_key: os.environ/LITELLM_MASTER_KEY
  database_url: os.environ/DATABASE_URL
  background_health_checks: true          # off by default upstream — this is the intermittent-Mac fix
  health_check_interval: {{ llm_router_health_check_interval }}
  # Only alias groups that have at least one health_checked (local-tier) deployment are
  # probed in the background — metered tiers are never probed, so checks never bill.
  background_health_check_model_groups:
{% for alias in llm_router_aliases %}
{% if alias.deployments | selectattr('health_checked', 'equalto', true) | list | length > 0 %}
    - {{ alias.name }}
{% endif %}
{% endfor %}

litellm_settings:
  # Verify the Mac's certificate rather than trusting blindly: a path here becomes httpx's
  # `verify=`, so ssl_verify: false is deliberately NOT used. If the certificate expires the
  # gateway fails with a TLS error naming it, which is a legible failure rather than a hang.
  ssl_verify: {{ llm_router_mac_ca_container_path }}
  callbacks: ["prometheus"]
  drop_params: true
  # Prompt/response bodies are not logged by default (FR-012).
  turn_off_message_logging: true
  # Deliberately left OPEN (LiteLLM's own default), not `true`. Reproduced against the
  # pinned v1.83.3-stable image during implementation: with this set to `true`, a request
  # bearing the real master_key against /metrics hangs indefinitely (curl times out, no
  # server-side log line ever appears) — while the identical master key works instantly
  # against every other admin endpoint (e.g. /key/generate). A freshly-minted virtual key
  # fails fast instead of hanging, but is rejected outright ("Only proxy admin can access
  # /metrics"), so there is no working authenticated path found for this pinned version.
  # /metrics carries spend and deployment-topology data, not credentials, and FR-008
  # already accepts LAN reachability for the gateway itself — extending that acceptance to
  # this one read-only endpoint (research D-105, D-108) was the pragmatic call rather than
  # blocking observability on an upstream bug. Revisit on the next LiteLLM version bump.
  require_auth_for_metrics_endpoint: false
