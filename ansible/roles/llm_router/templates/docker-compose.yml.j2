# LLM Router Docker Compose Stack — generated by Ansible. DO NOT EDIT MANUALLY.
#
# Two services (FR-014, research D-104 — no Redis: single worker, no consumer for
# cross-worker shared state):
#   litellm    — the OpenAI-compatible gateway (FR-002)
#   postgres   — virtual keys, budgets, spend logs (FR-010, FR-015, SC-005)
#
# No tailscaled sidecar. It existed to give litellm outbound egress to the Mac by MagicDNS
# name; FR-013 as amended addresses the Mac over the LAN, which left the sidecar with no
# consumer — it ran userspace-only with no TS_DEST_IP and no serve config, so it never
# carried inbound traffic either. FR-008's tailnet reach to the gateway is served by the
# PVE host's subnet route over 192.168.1.0/24 (FR-017, amended 2026-09-15).
#
# No bind mount to NFS or Synology (FR-012 — no user data persisted). Postgres data lives on
# the LXC's local disk only.

services:
  postgres:
    container_name: llm_router_postgres
    image: {{ llm_router_postgres_image }}:{{ llm_router_postgres_version }}
    environment:
      POSTGRES_USER: litellm
      POSTGRES_PASSWORD: "{{ litellm_db_password }}"
      POSTGRES_DB: litellm
    volumes:
      - "{{ llm_router_data_dir }}/postgres:/var/lib/postgresql/data"
      - "/etc/localtime:/etc/localtime:ro"
    restart: unless-stopped
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U litellm -d litellm"]
      interval: 15s
      timeout: 5s
      retries: 5
      start_period: 15s

  litellm:
    container_name: llm_router_litellm
    image: {{ llm_router_image }}:{{ llm_router_version }}
    ports:
      - "{{ llm_router_port }}:4000"
    # The local tier is addressed by its mDNS .local name (FR-013), which this container
    # cannot resolve: Docker's embedded DNS at 127.0.0.11 never consults host NSS, so
    # libnss-mdns on the LXC is invisible here. network_mode: host does not help either —
    # it shares the network namespace, not the filesystem, so the container keeps its own
    # nsswitch.conf and NSS libraries. Measured on the LXC 2026-09-19.
    #
    # tasks/main.yml therefore resolves the name on the LXC, where avahi does know it, and
    # passes the result in below. The api_base stays a name and no IP literal enters the
    # repo; the address is rediscovered on every deploy.
{% if llm_router_extra_hosts | default([]) %}
    extra_hosts:
{% for entry in llm_router_extra_hosts %}
      - "{{ entry }}"
{% endfor %}
{% endif %}
    volumes:
      - "{{ llm_router_install_dir }}/config.yaml:/app/config.yaml:ro"
      - "/etc/localtime:/etc/localtime:ro"
    environment:
      LITELLM_MASTER_KEY: "{{ litellm_master_key }}"
      # litellm_db_password must be URL-safe — a `/` in it parses as the end of the
      # authority component and Prisma reports "invalid port number". Asserted in preflight.
      DATABASE_URL: "postgresql://litellm:{{ litellm_db_password }}@postgres:5432/litellm"
      # Backend provider credentials, derived from every distinct api_key_env declared in
      # llm_router_aliases rather than listed by hand. config.yaml.j2 emits
      # `api_key: os.environ/<api_key_env>` for each deployment, so a hand-maintained list
      # here silently resolves to nothing the moment a deployment names a new variable —
      # which is exactly what happened when the local tier re-chained through the Mac's
      # LiteLLM and gained MAC_LITELLM_KEY. The vault variable name is always the lowercased
      # api_key_env, the same convention llm_router_clients uses below.
{% for env in llm_router_aliases | map(attribute='deployments') | flatten | selectattr('api_key_env', 'defined') | map(attribute='api_key_env') | unique | sort %}
      {{ env }}: "{{ lookup('vars', env | lower, default='') }}"
{% endfor %}
{% for c in llm_router_clients %}
      {{ c.key_env }}: "{{ lookup('vars', c.key_env | lower, default='') }}"
{% endfor %}
      # No HTTP_PROXY/HTTPS_PROXY. The one remaining backend — the Mac's own LiteLLM — is
      # reached directly over the LAN by mDNS name (FR-013 amended). No leg crosses the
      # tailnet, which is what removed the sidecar this once proxied to, and there are no
      # metered tiers over the public internet any more (amendment-drop-metered-tiers.md).
    command: ["--config", "/app/config.yaml", "--port", "4000"]
    depends_on:
      postgres:
        condition: service_healthy
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "python", "-c", "import urllib.request; urllib.request.urlopen('http://localhost:4000/health/readiness')"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 30s
