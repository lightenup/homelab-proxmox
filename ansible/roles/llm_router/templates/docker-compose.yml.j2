# LLM Router Docker Compose Stack — generated by Ansible. DO NOT EDIT MANUALLY.
#
# Three services (FR-014, research D-104 — no Redis: single worker, no consumer for
# cross-worker shared state):
#   litellm    — the OpenAI-compatible gateway (FR-002)
#   postgres   — virtual keys, budgets, spend logs (FR-010, FR-015, SC-005)
#   tailscale  — userspace-networking sidecar giving this LXC its own tailnet egress to the
#                Mac, independent of the PVE host's subnet router (FR-017, research D-102)
#
# No bind mount to NFS or Synology (FR-012 — no user data persisted). Postgres data lives on
# the LXC's local disk only.

services:
  tailscale:
    container_name: llm_router_tailscale
    image: {{ llm_router_tailscale_image }}:{{ llm_router_tailscale_version }}
    hostname: {{ llm_router_tailscale_hostname }}
    environment:
      TS_AUTHKEY: "{{ tailscale_authkey }}"
      TS_USERSPACE: "true"
      TS_EXTRA_ARGS: "--hostname={{ llm_router_tailscale_hostname }} --outbound-http-proxy-listen=0.0.0.0:{{ llm_router_tailscale_proxy_port }}"
      TS_STATE_DIR: "/var/lib/tailscale"
    volumes:
      - "{{ llm_router_data_dir }}/tailscale-state:/var/lib/tailscale"
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "tailscale", "status"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 20s

  postgres:
    container_name: llm_router_postgres
    image: {{ llm_router_postgres_image }}:{{ llm_router_postgres_version }}
    environment:
      POSTGRES_USER: litellm
      POSTGRES_PASSWORD: "{{ litellm_db_password }}"
      POSTGRES_DB: litellm
    volumes:
      - "{{ llm_router_data_dir }}/postgres:/var/lib/postgresql/data"
      - "/etc/localtime:/etc/localtime:ro"
    restart: unless-stopped
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U litellm -d litellm"]
      interval: 15s
      timeout: 5s
      retries: 5
      start_period: 15s

  litellm:
    container_name: llm_router_litellm
    image: {{ llm_router_image }}:{{ llm_router_version }}
    ports:
      - "{{ llm_router_port }}:4000"
    volumes:
      - "{{ llm_router_install_dir }}/config.yaml:/app/config.yaml:ro"
      - "/etc/localtime:/etc/localtime:ro"
    environment:
      LITELLM_MASTER_KEY: "{{ litellm_master_key }}"
      DATABASE_URL: "postgresql://litellm:{{ litellm_db_password }}@postgres:5432/litellm"
      OPENROUTER_API_KEY: "{{ openrouter_api_key }}"
      ANTHROPIC_API_KEY: "{{ anthropic_api_key }}"
{% for c in llm_router_clients %}
      {{ c.key_env }}: "{{ lookup('vars', c.key_env | lower, default='') }}"
{% endfor %}
      # Route local-tier (Ollama) traffic through the Tailscale sidecar's outbound proxy so
      # this LXC can reach the Mac by MagicDNS name (FR-017). Loopback and Postgres traffic
      # is excluded so it never round-trips through the proxy (research D-102).
      HTTP_PROXY: "http://tailscale:{{ llm_router_tailscale_proxy_port }}"
      HTTPS_PROXY: "http://tailscale:{{ llm_router_tailscale_proxy_port }}"
      NO_PROXY: "localhost,127.0.0.1,postgres"
    command: ["--config", "/app/config.yaml", "--port", "4000"]
    depends_on:
      postgres:
        condition: service_healthy
      tailscale:
        condition: service_healthy
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "python", "-c", "import urllib.request; urllib.request.urlopen('http://localhost:4000/health/readiness')"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 30s
