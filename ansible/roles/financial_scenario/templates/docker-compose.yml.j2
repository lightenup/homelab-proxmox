# Financial Scenario Docker Compose Stack
# Generated by Ansible - DO NOT EDIT MANUALLY

services:
  api:
    container_name: financial_scenario_api
    image: {{ financial_scenario_api_image }}:{{ financial_scenario_version }}
    ports:
      - "{{ financial_scenario_api_port }}:8000"
    volumes:
      - "{{ financial_scenario_data_dir }}/reference_data:/app/reference_data"
      - "/etc/localtime:/etc/localtime:ro"
    environment:
      EXTRACTION_BASE_URL: ""
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8000/health"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 20s

  mcp:
    container_name: financial_scenario_mcp
    image: {{ financial_scenario_api_image }}:{{ financial_scenario_version }}
    command: ["python", "-m", "src.mcp_server.server"]
    ports:
      - "{{ financial_scenario_mcp_port }}:8001"
    volumes:
      - "{{ financial_scenario_data_dir }}/reference_data:/app/reference_data"
      - "/etc/localtime:/etc/localtime:ro"
    environment:
      EXTRACTION_BASE_URL: ""
      MCP_AUTH_TOKEN: "{{ financial_scenario_mcp_token }}"
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8001/health"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 20s

  gui:
    container_name: financial_scenario_gui
    image: {{ financial_scenario_gui_image }}:{{ financial_scenario_version }}
    ports:
      - "{{ financial_scenario_gui_port }}:3000"
    environment:
      - TZ={{ timezone | default('Europe/Oslo') }}
    depends_on:
      api:
        condition: service_healthy
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "wget", "--quiet", "--tries=1", "--spider", "http://localhost:3000/"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 15s
