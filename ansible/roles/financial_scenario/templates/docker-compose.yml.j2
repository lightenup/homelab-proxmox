# Financial Scenario Docker Compose Stack
# Generated by Ansible - DO NOT EDIT MANUALLY
#
# Mirrors the app's own docker-compose.yml (personal-financial-scenarios):
# only the GUI publishes a host port; its nginx proxies /api, /docs and /mcp to
# the internal api/mcp services. The MCP auth gate is enforced in that nginx
# layer with an image-baked shared secret (PFS 044), so the mcp service is NEVER
# published directly — doing so would bypass the gate (unauthenticated MCP).

services:
  api:
    container_name: financial_scenario_api
    image: {{ financial_scenario_api_image }}:{{ financial_scenario_version }}
    # No host port: reached internally by the gui nginx as api:8000 (/api, /docs).
    volumes:
      - "{{ financial_scenario_data_dir }}/reference_data:/app/config/reference_data"
      - "/etc/localtime:/etc/localtime:ro"
    environment:
      EXTRACTION_BASE_URL: ""
    restart: unless-stopped
    healthcheck:
      # No /health endpoint exists; /docs is the liveness target the app itself uses.
      # ENV is left unset (development) so /docs stays enabled.
      test: ["CMD", "python", "-c", "import urllib.request; urllib.request.urlopen('http://localhost:8000/docs')"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 20s

  mcp:
    container_name: financial_scenario_mcp
    image: {{ financial_scenario_api_image }}:{{ financial_scenario_version }}
    command: ["python", "-m", "src.mcp_server.server"]
    # No host port: reached internally by the gui nginx as mcp:8001 (/mcp), which
    # enforces the shared-secret gate. MCP_TRANSPORT=http is REQUIRED — the server
    # defaults to stdio and would otherwise never bind the port.
    volumes:
      - "{{ financial_scenario_data_dir }}/reference_data:/app/config/reference_data"
      - "/etc/localtime:/etc/localtime:ro"
    environment:
      MCP_TRANSPORT: "http"
      MCP_PORT: "8001"
      EXTRACTION_BASE_URL: ""
    restart: unless-stopped
    healthcheck:
      # FastMCP serves /mcp (not /health); a TCP connect is the available signal.
      test: ["CMD", "python", "-c", "import socket; socket.create_connection(('localhost', 8001), timeout=5).close()"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 20s

  gui:
    container_name: financial_scenario_gui
    image: {{ financial_scenario_gui_image }}:{{ financial_scenario_version }}
    ports:
      # The GUI nginx listens on 80; this is the only published host port.
      - "{{ financial_scenario_gui_port }}:80"
    environment:
      - TZ={{ timezone | default('Europe/Oslo') }}
    depends_on:
      api:
        condition: service_healthy
      mcp:
        condition: service_healthy
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "wget", "--quiet", "--tries=1", "--spider", "http://localhost:80/"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 15s
