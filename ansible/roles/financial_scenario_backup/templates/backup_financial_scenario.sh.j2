#!/bin/bash
set -euo pipefail

# Configuration
BACKUP_DIR="{{ financial_scenario_backup_path }}"
INSTALL_DIR="{{ financial_scenario_install_dir }}"
API_CONTAINER="financial_scenario_api"
RETENTION_DAYS={{ financial_scenario_backup_retention_days }}
RETENTION_WEEKS={{ financial_scenario_backup_retention_weeks }}
RETENTION_MONTHS={{ financial_scenario_backup_retention_months }}

TIMESTAMP=$(date +"%Y%m%d-%H%M%S")
BACKUP_NAME="financial-scenario-backup-$TIMESTAMP"
ARCHIVE_NAME="$BACKUP_NAME.tar.gz"

# Ensure backup directory exists and is writable
if [ ! -d "$BACKUP_DIR" ]; then
    echo "Error: Backup directory $BACKUP_DIR does not exist."
    exit 1
fi

if [ ! -w "$BACKUP_DIR" ]; then
    echo "Error: Backup directory $BACKUP_DIR is not writable."
    exit 1
fi

# Check whether the scenario store exists yet (fresh deploy with no saves → nothing to back up).
DB_EXISTS=$(docker exec "$API_CONTAINER" python -c \
    "import os; print('yes' if os.path.exists('/app/data/scenarios.db') else 'no')" 2>/dev/null || echo "no")

if [ "$DB_EXISTS" != "yes" ]; then
    echo "No scenarios.db found in container (fresh deploy, no saves yet). Nothing to back up."
    exit 0
fi

# Create temporary directory
TEMP_DIR=$(mktemp -d)
WORK_DIR="$TEMP_DIR/$BACKUP_NAME"
mkdir -p "$WORK_DIR"

cleanup() {
    rm -rf "$TEMP_DIR"
    # Remove any leftover snapshot sidecar from /app/data (idempotent)
    docker exec "$API_CONTAINER" rm -f /app/data/.backup-snapshot.db 2>/dev/null || true
}
trap cleanup EXIT

# 1. Consistent online backup — NOT a raw cp (WAL-mode SQLite can be torn mid-copy).
#    Uses sqlite3.Connection.backup(), which is atomic regardless of concurrent writes.
echo "Taking consistent online backup of scenarios.db..."
docker exec "$API_CONTAINER" python -c "
import sqlite3, shutil
src = sqlite3.connect('file:/app/data/scenarios.db?mode=ro', uri=True)
dst = sqlite3.connect('/app/data/.backup-snapshot.db')
src.backup(dst)
dst.close()
src.close()
"

# 2. Copy snapshot out of the container and remove it from /app/data.
docker cp "${API_CONTAINER}:/app/data/.backup-snapshot.db" "$WORK_DIR/scenarios.db"
docker exec "$API_CONTAINER" rm -f /app/data/.backup-snapshot.db

# 3. Include the rendered compose file for reference.
if [ -f "$INSTALL_DIR/docker-compose.yml" ]; then
    cp "$INSTALL_DIR/docker-compose.yml" "$WORK_DIR/"
fi

# 4. Compress.
echo "Compressing backup..."
tar -czf "$BACKUP_DIR/$ARCHIVE_NAME" -C "$TEMP_DIR" "$BACKUP_NAME"

echo "Backup created successfully: $BACKUP_DIR/$ARCHIVE_NAME"

# 5. Prune old backups (GFS retention).
echo "Pruning old backups..."

get_date() {
    echo "$1" | grep -oE '[0-9]{8}' | sed 's/\(....\)\(..\)\(..\)/\1-\2-\3/'
}

FILES=$(ls "$BACKUP_DIR"/financial-scenario-backup-*.tar.gz 2>/dev/null || true)

for file in $FILES; do
    FILENAME=$(basename "$file")
    FILE_DATE_STR=$(get_date "$FILENAME")

    if [ -z "$FILE_DATE_STR" ]; then
        continue
    fi

    FILE_TIMESTAMP=$(date -d "$FILE_DATE_STR" +%s)
    CURRENT_TIMESTAMP=$(date +%s)
    AGE_DAYS=$(( (CURRENT_TIMESTAMP - FILE_TIMESTAMP) / 86400 ))

    DAY_OF_WEEK=$(date -d "$FILE_DATE_STR" +%u)   # 1=Mon, 7=Sun
    DAY_OF_MONTH=$(date -d "$FILE_DATE_STR" +%d)

    DELETE=true

    # Daily retention
    if [ "$AGE_DAYS" -lt "$RETENTION_DAYS" ]; then
        DELETE=false
    fi

    # Weekly retention (keep Sundays)
    if [ "$DELETE" = true ] && [ "$DAY_OF_WEEK" -eq 7 ] && [ "$AGE_DAYS" -lt $((RETENTION_WEEKS * 7)) ]; then
        DELETE=false
    fi

    # Monthly retention (keep 1st of month)
    if [ "$DELETE" = true ] && [ "$DAY_OF_MONTH" -eq 01 ] && [ "$AGE_DAYS" -lt $((RETENTION_MONTHS * 30)) ]; then
        DELETE=false
    fi

    if [ "$DELETE" = true ]; then
        echo "Deleting old backup: $FILENAME (Age: $AGE_DAYS days)"
        rm "$file"
    else
        echo "Keeping backup: $FILENAME (Age: $AGE_DAYS days)"
    fi
done

echo "Backup process completed."
