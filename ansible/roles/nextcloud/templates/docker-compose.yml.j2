# Nextcloud Docker Compose Stack
# Generated by Ansible - DO NOT EDIT MANUALLY

services:
  nextcloud_app:
    container_name: nextcloud_app
    image: nextcloud:{{ nextcloud_version }}
    ports:
      - "{{ nextcloud_port }}:80"
    volumes:
      - "{{ nextcloud_data_dir }}/html:/var/www/html"
      - "{{ nextcloud_nfs_mount }}/data:/mnt/ncdata"
      - "/etc/localtime:/etc/localtime:ro"
    env_file:
      - .env
    environment:
      NEXTCLOUD_DATA_DIR: /mnt/ncdata
    depends_on:
      nextcloud_db:
        condition: service_healthy
      nextcloud_redis:
        condition: service_healthy
    restart: always
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost/status.php"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 60s

  nextcloud_db:
    container_name: nextcloud_db
    image: mariadb:11
    command: --transaction-isolation=READ-COMMITTED --log-bin=binlog --binlog-format=ROW
    volumes:
      - "{{ nextcloud_data_dir }}/mariadb:/var/lib/mysql"
    environment:
      MYSQL_ROOT_PASSWORD: {{ nextcloud_db_root_password }}
      MYSQL_DATABASE: {{ nextcloud_db_name }}
      MYSQL_USER: {{ nextcloud_db_user }}
      MYSQL_PASSWORD: {{ nextcloud_db_password }}
    restart: always
    healthcheck:
      test: ["CMD", "healthcheck.sh", "--connect", "--innodb_initialized"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s

  nextcloud_redis:
    container_name: nextcloud_redis
    image: redis:7-alpine
    command: redis-server --requirepass {{ nextcloud_redis_password }}
    volumes:
      - "{{ nextcloud_data_dir }}/redis:/data"
    restart: always
    healthcheck:
      test: ["CMD", "redis-cli", "-a", "{{ nextcloud_redis_password }}", "ping"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 10s

  nextcloud_exporter:
    container_name: nextcloud_exporter
    image: ghcr.io/xperimental/nextcloud-exporter:{{ nextcloud_exporter_version }}
    ports:
      - "{{ nextcloud_exporter_port }}:9205"
    environment:
      NEXTCLOUD_SERVER: "http://nextcloud_app:80"
      NEXTCLOUD_AUTH_TOKEN: "{{ nextcloud_serverinfo_token }}"
      NEXTCLOUD_LISTEN_ADDRESS: ":9205"
    depends_on:
      - nextcloud_app
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "wget", "--quiet", "--tries=1", "--spider", "http://localhost:9205/metrics"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 30s
