# Immich v2 Environment Variables
# Generated by Ansible - DO NOT EDIT MANUALLY
# Reference: https://docs.immich.app/install/environment-variables

# Immich Version
IMMICH_VERSION={{ immich_version }}

# Storage Locations
UPLOAD_LOCATION={{ immich_upload_location }}
DB_DATA_LOCATION={{ immich_data_dir }}/postgres

# Database Configuration
DB_HOSTNAME=database
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD={{ immich_db_password }}
DB_DATABASE_NAME=immich

# Redis Configuration
REDIS_HOSTNAME=redis
REDIS_PORT=6379

# Timezone
TZ=Etc/UTC
{% if immich_metrics_enabled | default(false) %}

# Prometheus telemetry (Feature: 040-monitoring-overhaul, FR-005)
IMMICH_TELEMETRY_INCLUDE=all
{% endif %}
